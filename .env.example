# =========================================================
# QuaraCRM — Environment Variables
# Copy this file to .env (local dev) and configure the same
# keys as Environment Variables in your Vercel project for deploy.
# =========================================================

# --- Client-side (Vite) ---------------------------------------------------
# Prefixed with VITE_ so they are inlined into the browser bundle.
# Safe to expose: the Supabase anon key is public by design — real
# protection comes from Row Level Security (RLS) policies, not secrecy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: enables Google Gemini AI features (copywriting, deal health,
# meeting insights, sales copilot) without requiring each user to paste
# their own key in the UI. Leave unset to let users configure their own.
VITE_GEMINI_API_KEY=

# --- Server-side only (Vercel Serverless Functions under /api) -----------
# Never prefix these with VITE_ — that would bundle them into the client
# and defeat the point of keeping them server-side. Read only inside
# /api/**/*.ts via process.env.
APOLLO_API_KEY=
RESEND_API_KEY=
