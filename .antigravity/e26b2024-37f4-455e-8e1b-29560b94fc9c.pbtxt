        }
        lines {
          text: "      const matchCompany = card.companyName.toLowerCase().includes(q);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const matchContact = card.contactName.toLowerCase().includes(q);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const matchTags = card.tags.some((t) => t.toLowerCase().includes(q));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (!matchTitle && !matchCompany && !matchContact && !matchTags) return false;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
