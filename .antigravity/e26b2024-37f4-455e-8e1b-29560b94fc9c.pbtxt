  file_change {
    absolute_path_uri: "file:///src/components/TableView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  Filter,\n  ArrowUpDown,\n  Download,\n  Phone,\n  Eye,\n  ExternalLink,\n  ChevronRight,\n  Clock,\n  Sparkles,\n} from \'lucide-react\';\nimport { useCRM } from \'../context/CRMContext\';\nimport { PhaseId, Priority, CRMCard } from \'../types/crm\';\nimport { formatCurrency, formatDate, getWhatsAppDirectUrl } from \'../utils/formatters\';\nimport { exportCardsToCSV } from \'../utils/exportUtils\';\n\nexport const TableView: React.FC = () => {\n  const {\n    cards,\n    phases,\n    users,\n    setSelectedCard,\n    moveCardPhase,\n    searchQuery,\n    setSearchQuery,\n    activeFilterConsultant,\n    setActiveFilterConsultant,\n    activePriorityFilter,\n    setActivePriorityFilter,\n  } = useCRM();\n\n  const [sortField, setSortField] = useState<keyof CRMCard>(\'createdAt\');\n  const [sortAsc, setSortAsc] = useState(false);\n  const [selectedPhaseFilter, setSelectedPhaseFilter] = useState<string>(\'all\');\n\n  const userMap = new Map(users.map((u) => [u.id, u]));\n  const phaseMap = new Map(phases.map((p) => [p.id, p]));\n\n  // Filter\n  const filteredCards = cards.filter((card) => {\n    if (activeFilterConsultant !== \'all\' && card.assignedUserId !== activeFilterConsultant) return false;\n    if (activePriorityFilter !== \'all\' && card.priority !== activePriorityFilter) return false;\n    if (selectedPhaseFilter !== \'all\' && card.phaseId !== selectedPhaseFilter) return false;\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      const matchTitle = card.title.toLowerCase().includes(q);\n      const matchCompany = card.companyName.toLowerCase().includes(q);\n      const matchContact = card.contactName.toLowerCase().includes(q);\n      const matchTags = card.tags.some((t) => t.toLowerCase().includes(q));\n      if (!matchTitle && !matchCompany && !matchContact && !matchTags) return false;\n    }\n    return true;\n  });\n\n  // Sort\n  const sortedCards = [...filteredCards].sort((a, b) => {\n    let aVal = a[sortField] ?? \'\';\n    let bVal = b[sortField] ?? \'\';\n\n    if (typeof aVal === \'string\') {\n      const cmp = (aVal as string).localeCompare(bVal as string);\n      return sortAsc ? cmp : -cmp;\n    } else {\n      const cmp = (aVal as number) - (bVal as number);\n      return sortAsc ? cmp : -cmp;\n    }\n  });\n\n  const handleSort = (field: keyof CRMCard) => {\n    if (sortField === field) {\n      setSortAsc(!sortAsc);\n    } else {\n      setSortField(field);\n      setSortAsc(true);\n    }\n  };\n\n  const getPriorityBadge = (priority: Priority) => {\n    switch (priority) {\n      case \'urgente\':\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700\">Urgente</span>;\n      case \'alta\':\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-100 text-amber-800\">Alta</span>;\n      case \'media\':\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-100 text-blue-800\">M\303\251dia</span>;\n      default:\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600\">Baixa</span>;\n    }\n  };\n\n  return (\n    <div className=\"p-4 sm:p-6 space-y-4 max-w-7xl mx-auto\">\n      {/* Table Toolbar */}\n      <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center flex-wrap gap-2 text-xs\">\n          {/* Phase Filter */}\n          <select\n            value={selectedPhaseFilter}\n            onChange={(e) => setSelectedPhaseFilter(e.target.value)}\n            className=\"px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 font-medium focus:outline-none\"\n          >\n            <option value=\"all\">\360\237\223\202 Todas as 12 Fases</option>\n            {phases.map((p) => (\n              <option key={p.id} value={p.id}>\n                {p.name}\n              </option>\n            ))}\n          </select>\n\n          {/* Consultant Filter */}\n          <select\n            value={activeFilterConsultant}\n            onChange={(e) => setActiveFilterConsultant(e.target.value)}\n            className=\"px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 font-medium focus:outline-none\"\n          >\n            <option value=\"all\">\360\237\221\244 Todos Consultores</option>\n            {users.map((u) => (\n              <option key={u.id} value={u.id}>\n                {u.name}\n              </option>\n            ))}\n          </select>\n\n          {/* Priority Filter */}\n          <select\n            value={activePriorityFilter}\n            onChange={(e) => setActivePriorityFilter(e.target.value)}\n            className=\"px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 font-medium focus:outline-none\"\n          >\n            <option value=\"all\">\342\232\241 Prioridade: Todas</option>\n            <option value=\"urgente\">Urgente</option>\n            <option value=\"alta\">Alta</option>\n            <option value=\"media\">M\303\251dia</option>\n            <option value=\"baixa\">Baixa</option>\n          </select>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => exportCardsToCSV(sortedCards, phases, users)}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition-colors\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Exportar CSV ({sortedCards.length})</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Table */}\n      <div className=\"bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead className=\"bg-slate-50 text-slate-500 font-bold border-b border-slate-200 uppercase tracking-wider text-[10px]\">\n              <tr>\n                <th className=\"p-3.5 cursor-pointer\" onClick={() => handleSort(\'id\')}>\n                  <div className=\"flex items-center gap-1\">\n                    <span>ID</span>\n                    <ArrowUpDown className=\"w-3 h-3\" />\n                  </div>\n                </th>\n                <th className=\"p-3.5 cursor-pointer\" onClick={() => handleSort(\'title\')}>\n                  <div className=\"flex items-center gap-1\">\n                    <span>Card / Empresa</span>\n                    <ArrowUpDown className=\"w-3 h-3\" />\n                  </div>\n                </th>\n                <th className=\"p-3.5 cursor-pointer\" onClick={() => handleSort(\'phaseId\')}>\n                  <div className=\"flex items-center gap-1\">\n                    <span>Fase do Processo</span>\n                    <ArrowUpDown className=\"w-3 h-3\" />\n                  </div>\n                </th>\n                <th className=\"p-3.5 cursor-pointer\" onClick={() => handleSort(\'value\')}>\n                  <div className=\"flex items-center gap-1\">\n                    <span>Valor</span>\n                    <ArrowUpDown className=\"w-3 h-3\" />\n                  </div>\n                </th>\n                <th className=\"p-3.5\">Contato & WhatsApp</th>\n                <th className=\"p-3.5\">Consultor</th>\n                <th className=\"p-3.5 cursor-pointer\" onClick={() => handleSort(\'priority\')}>\n                  <div className=\"flex items-center gap-1\">\n                    <span>Prioridade</span>\n                    <ArrowUpDown className=\"w-3 h-3\" />\n                  </div>\n                </th>\n                <th className=\"p-3.5 cursor-pointer\" onClick={() => handleSort(\'createdAt\')}>\n                  <div className=\"flex items-center gap-1\">\n                    <span>Criado em</span>\n                    <ArrowUpDown className=\"w-3 h-3\" />\n                  </div>\n                </th>\n                <th className=\"p-3.5 text-right\">A\303\247\303\265es</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700\">\n              {sortedCards.map((card) => {\n                const phase = phaseMap.get(card.phaseId);\n                const user = userMap.get(card.assignedUserId);\n\n                return (\n                  <tr\n                    key={card.id}\n                    className=\"hover:bg-slate-50/80 transition-colors group cursor-pointer\"\n                    onClick={() => setSelectedCard(card)}\n                  >\n                    <td className=\"p-3.5 font-mono font-bold text-slate-400\">{card.id}</td>\n                    <td className=\"p-3.5\">\n                      <p className=\"font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">\n                        {card.title}\n                      </p>\n                      <p className=\"text-[11px] text-slate-500 font-medium\">{card.companyName}</p>\n                    </td>\n                    <td className=\"p-3.5\" onClick={(e) => e.stopPropagation()}>\n                      <select\n                        value={card.phaseId}\n                        onChange={(e) => moveCardPhase(card.id, e.target.value as PhaseId)}\n                        className=\"px-2 py-1 bg-slate-100 text-slate-800 font-medium text-[11px] rounded-lg border border-slate-200 focus:outline-none\"\n                      >\n                        {phases.map((p) => (\n                          <option key={p.id} value={p.id}>\n                            {p.name}\n                          </option>\n                        ))}\n                      </select>\n                    </td>\n                    <td className=\"p-3.5 font-bold text-indigo-700\">\n                      {card.value > 0 ? formatCurrency(card.value) : \'-\'}\n                    </td>\n                    <td className=\"p-3.5\">\n                      <p className=\"font-semibold text-slate-800\">{card.contactName}</p>\n                      {card.contactPhone && (\n                        <a\n                          href={getWhatsAppDirectUrl(card.contactPhone)}\n                          target=\"_blank\"\n                          rel=\"noreferrer\"\n                          onClick={(e) => e.stopPropagation()}\n                          className=\"text-[11px] text-emerald-600 hover:underline flex items-center gap-1 font-mono\"\n                        >\n                          <Phone className=\"w-3 h-3\" />\n                          <span>{card.contactPhone}</span>\n                        </a>\n                      )}\n                    </td>\n                    <td className=\"p-3.5\">\n                      {user && (\n                        <div className=\"flex items-center gap-1.5\">\n                          <img src={user.avatar} alt={user.name} className=\"w-5 h-5 rounded-full object-cover\" />\n                          <span className=\"font-medium text-slate-700 truncate max-w-[100px]\">{user.name}</span>\n                        </div>\n                      )}\n                    </td>\n                    <td className=\"p-3.5\">{getPriorityBadge(card.priority)}</td>\n                    <td className=\"p-3.5 text-slate-500 text-[11px]\">{formatDate(card.createdAt)}</td>\n                    <td className=\"p-3.5 text-right\">\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          setSelectedCard(card);\n                        }}\n                        className=\"p-1.5 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors font-semibold\"\n                      >\n                        <Eye className=\"w-4 h-4\" />\n                      </button>\n                    </td>\n                  </tr>\n                );\n              })}\n\n              {sortedCards.length === 0 && (\n                <tr>\n                  <td colSpan={9} className=\"p-8 text-center text-slate-400\">\n                    Nenhum card encontrado com os filtros atuais.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
