    replacement_chunks {
      target_content: "  return (\n    <div className=\"p-4 sm:p-6 max-w-7xl mx-auto space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-slate-200\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n            <FileText className=\"w-5 h-5 text-slate-700\" />\n            <span>Log Completo de Auditoria & Rastreabilidade</span>\n          </h2>\n          <p className=\"text-xs text-slate-500\">\n            Registro cronol\303\263gico imut\303\241vel de todas as a\303\247\303\265es de usu\303\241rios, mensagens, automa\303\247\303\265es e altera\303\247\303\265es no pipeline\n          </p>\n        </div>\n\n        <button\n          onClick={() => exportAuditLogsToCSV(filteredLogs)}\n          className=\"flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n        >\n          <Download className=\"w-4 h-4\" />\n          <span>Exportar Trilha de Auditoria (CSV)</span>\n        </button>\n      </div>\n\n      {/* Filter Bar */}\n      <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center flex-wrap gap-2 text-xs\">\n          <div className=\"relative\">\n            <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              value={searchLog}\n              onChange={(e) => setSearchLog(e.target.value)}\n              placeholder=\"Buscar por detalhes, empresa ou usu\303\241rio...\"\n              className=\"pl-8 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:bg-white w-64\"\n            />\n          </div>\n\n          <select\n            value={selectedUserFilter}\n            onChange={(e) => setSelectedUserFilter(e.target.value)}\n            className=\"px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 font-medium focus:outline-none\"\n          >\n            <option value=\"all\">\360\237\221\244 Todos os Usu\303\241rios</option>\n            {users.map((u) => (\n              <option key={u.id} value={u.id}>\n                {u.name} ({u.role})\n              </option>\n            ))}\n          </select>\n\n          <select\n            value={selectedActionFilter}\n            onChange={(e) => setSelectedActionFilter(e.target.value)}\n            className=\"px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 font-medium focus:outline-none\"\n          >\n            <option value=\"all\">\342\232\241 Todos os Tipos de A\303\247\303\243o</option>\n            <option value=\"card_created\">Cria\303\247\303\243o de Cards</option>\n            <option value=\"card_moved\">Movimenta\303\247\303\243o de Fases</option>\n            <option value=\"whatsapp_sent\">WhatsApp Disparado</option>\n            <option value=\"email_sent\">E-mail Enviado</option>\n            <option value=\"automation_executed\">Execu\303\247\303\243o de Automa\303\247\303\243o</option>\n            <option value=\"goals_updated\">Atualiza\303\247\303\243o de Metas</option>\n            <option value=\"permissions_updated\">Permiss\303\265es de Acesso</option>\n          </select>\n        </div>\n\n        <span className=\"text-xs font-bold text-slate-500\">{filteredLogs.length} eventos registrados</span>\n      </div>\n\n      {/* Audit Log Table */}\n      <div className=\"bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead className=\"bg-slate-100 text-slate-600 font-bold uppercase text-[10px] border-b border-slate-200\">\n              <tr>\n                <th className=\"p-3.5\">Data / Hora</th>\n                <th className=\"p-3.5\">Usu\303\241rio Respons\303\241vel</th>\n                <th className=\"p-3.5\">Tipo de A\303\247\303\243o</th>\n                <th className=\"p-3.5\">Card / Oportunidade</th>\n                <th className=\"p-3.5\">Detalhamento da A\303\247\303\243o</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700\">\n              {filteredLogs.map((log) => (\n                <tr key={log.id} className=\"hover:bg-slate-50/80 transition-colors\">\n                  <td className=\"p-3.5 font-mono text-slate-500 text-[11px] whitespace-nowrap\">\n                    {formatDate(log.timestamp)}\n                  </td>\n                  <td className=\"p-3.5\">\n                    <span className=\"font-bold text-slate-900 block\">{log.userName}</span>\n                    <span className=\"text-[10px] text-slate-400 uppercase font-semibold\">{log.userRole}</span>\n                  </td>\n                  <td className=\"p-3.5\">{getActionBadge(log.action)}</td>\n                  <td className=\"p-3.5\">\n                    {log.cardTitle ? (\n                      <div>\n                        <span className=\"font-semibold text-slate-800 block\">{log.cardTitle}</span>\n                        <span className=\"text-[10px] font-mono text-slate-400\">{log.cardId}</span>\n                      </div>\n                    ) : (\n                      <span className=\"text-slate-400\">-</span>\n                    )}\n                  </td>\n                  <td className=\"p-3.5 text-slate-600 max-w-md\">{log.details}</td>\n                </tr>\n              ))}\n\n              {filteredLogs.length === 0 && (\n                <tr>\n                  <td colSpan={5} className=\"p-8 text-center text-slate-400\">\n                    Nenhum registro de auditoria encontrado.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );"
