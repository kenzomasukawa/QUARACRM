    replacement_chunks {
      target_content: "                  return (\n                    <div\n                      key={card.id}\n                      id={`card-${card.id}`}\n                      draggable\n                      onDragStart={(e) => handleDragStart(e, card.id)}\n                      onClick={() => setSelectedCard(card)}\n                      className=\"group p-3 bg-white border border-slate-200/90 hover:border-indigo-400 rounded-xl shadow-2xs hover:shadow-xs transition-all cursor-pointer relative\"\n                    >\n                      {/* Top Bar: Title, Priority dot & ID */}\n                      <div className=\"flex items-start justify-between gap-1.5 mb-1\">\n                        <h4 className=\"font-semibold text-xs text-slate-900 line-clamp-1 group-hover:text-indigo-600 transition-colors\">\n                          {card.title}\n                        </h4>\n                        <div className=\"flex items-center gap-1 mt-0.5\">\n                          {getPriorityIndicator(card.priority)}\n                        </div>\n                      </div>\n\n                      {/* Company & Contact */}\n                      <div className=\"flex items-center gap-1 text-[11px] text-slate-500 truncate mb-2\">\n                        <Building2 className=\"w-3 h-3 text-slate-400 shrink-0\" />\n                        <span className=\"truncate\">{card.companyName}</span>\n                      </div>\n\n                      {/* Key Phase Info (Subtle single-line preview) */}\n                      {phase.id === \'mapeados\' && (card.customFields?.canalIndicacao || card.customFields?.canalProspeccao) && (\n                        <div className=\"text-[10px] text-indigo-700 bg-indigo-50/70 px-1.5 py-0.5 rounded border border-indigo-100 mb-2 truncate\">\n                          Origem: {card.customFields.canalIndicacao || card.customFields.canalProspeccao}\n                        </div>\n                      )}\n\n                      {phase.id === \'prospeccao\' && card.customFields?.tamanhoEmpresa && (\n                        <div className=\"text-[10px] text-blue-700 bg-blue-50/70 px-1.5 py-0.5 rounded border border-blue-100 mb-2 truncate\">\n                          Porte: {card.customFields.tamanhoEmpresa}\n                        </div>\n                      )}\n\n                      {phase.id === \'diagnostica\' && (card.customFields?.necessidadeCliente || card.customFields?.doresIdentificadas) && (\n                        <div className=\"text-[10px] text-cyan-800 bg-cyan-50/70 px-1.5 py-0.5 rounded border border-cyan-100 mb-2 line-clamp-1\">\n                          Necessidade: {card.customFields.necessidadeCliente || card.customFields.doresIdentificadas}\n                        </div>\n                      )}\n\n                      {phase.id === \'proposta\' && (card.customFields?.valorInicialProposta || card.customFields?.valorProposta) && (\n                        <div className=\"text-[10px] text-amber-800 bg-amber-50/70 px-1.5 py-0.5 rounded border border-amber-100 mb-2\">\n                          Proposta: {formatCurrency(card.customFields.valorInicialProposta || card.customFields.valorProposta)}\n                        </div>\n                      )}\n\n                      {phase.id === \'perdido\' && card.customFields?.motivoPerda && (\n                        <div className=\"text-[10px] text-rose-700 bg-rose-50/60 px-1.5 py-0.5 rounded border border-rose-100 mb-2 truncate\">\n                          Motivo: {card.customFields.motivoPerda}\n                        </div>\n                      )}\n\n                      {/* Card Bottom: Value, SLA & Assignee */}\n                      <div className=\"pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]\">\n                        <span className=\"font-semibold text-slate-800\">\n                          {card.value > 0 ? formatCurrency(card.value) : \'A definir\'}\n                        </span>\n\n                        <div className=\"flex items-center gap-2\">\n                          {/* SLA Pill */}\n                          {phase.slaHours > 0 && (\n                            <span\n                              className={`text-[10px] px-1.5 py-0.2 rounded font-medium flex items-center gap-0.5 ${\n                                sla.isOverdue\n                                  ? \'bg-rose-50 text-rose-700 font-semibold\'\n                                  : \'text-slate-400\'\n                              }`}\n                            >\n                              <Clock className=\"w-2.5 h-2.5\" />\n                              {sla.label}\n                            </span>\n                          )}\n\n                          {/* Quick WhatsApp Action */}\n                          {card.contactPhone && (\n                            <a\n                              href={getWhatsAppDirectUrl(card.contactPhone, `Ol\303\241 ${card.contactName}, tudo bem? Sou da equipe PipeCRM.`)}\n                              target=\"_blank\"\n                              rel=\"noreferrer\"\n                              onClick={(e) => e.stopPropagation()}\n                              title=\"Abrir WhatsApp\"\n                              className=\"text-slate-400 hover:text-emerald-600 transition-colors p-0.5\"\n                            >\n                              <Phone className=\"w-3 h-3\" />\n                            </a>\n                          )}\n\n                          {/* Quick Next Phase Forward */}\n                          {nextPhase && (\n                            <button\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                requestPhaseTransition(card, nextPhase);\n                              }}\n                              title={`Avan\303\247ar para ${nextPhase}`}\n                              className=\"text-slate-400 hover:text-indigo-600 transition-colors p-0.5\"\n                            >\n                              <ChevronRight className=\"w-3.5 h-3.5\" />\n                            </button>\n                          )}\n\n                          {/* Assignee Avatar */}\n                          {assignedUser && (\n                            <img\n                              src={assignedUser.avatar}\n                              alt={assignedUser.name}\n                              title={assignedUser.name}\n                              className=\"w-4 h-4 rounded-full object-cover ring-1 ring-slate-200\"\n                            />\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  );"
      replacement_content: "                  const allowedDestinations = ALLOWED_TRANSITIONS[card.phaseId] || [];\n                  const mainNextPhaseId = nextPhase || (allowedDestinations.length > 0 ? allowedDestinations[0] : null);\n                  const mainNextPhaseObj = phases.find((p) => p.id === mainNextPhaseId);\n\n                  return (\n                    <div\n                      key={card.id}\n                      id={`card-${card.id}`}\n                      draggable\n                      onDragStart={(e) => handleDragStart(e, card.id)}\n                      onClick={() => setSelectedCard(card)}\n                      className=\"group p-3 bg-white border border-slate-200/90 hover:border-indigo-400 rounded-xl shadow-2xs hover:shadow-xs transition-all cursor-pointer relative flex flex-col gap-2\"\n                    >\n                      {/* Top Bar: Title & Priority Indicator */}\n                      <div className=\"flex items-start justify-between gap-1.5\">\n                        <h4 className=\"font-bold text-xs text-slate-900 line-clamp-1 group-hover:text-indigo-600 transition-colors\">\n                          {card.title}\n                        </h4>\n                        <div className=\"flex items-center gap-1 mt-0.5 shrink-0\">\n                          {getPriorityIndicator(card.priority)}\n                        </div>\n                      </div>\n\n                      {/* Company & Contact */}\n                      <div className=\"flex items-center gap-1.5 text-[11px] text-slate-500 truncate\">\n                        <Building2 className=\"w-3.5 h-3.5 text-slate-400 shrink-0\" />\n                        <span className=\"font-medium text-slate-700 truncate\">{card.companyName}</span>\n                        {card.contactName && (\n                          <>\n                            <span className=\"text-slate-300\">\342\200\242</span>\n                            <span className=\"text-slate-500 truncate\">{card.contactName}</span>\n                          </>\n                        )}\n                      </div>\n\n                      {/* Fast One-Click Phase Transition Action Bar */}\n                      <div\n                        className=\"flex items-center justify-between gap-1.5 pt-1.5 pb-0.5 border-t border-slate-100/90\"\n                        onClick={(e) => e.stopPropagation()}\n                      >\n                        {/* Primary Fast Transition Button */}\n                        {mainNextPhaseObj ? (\n                          <button\n                            type=\"button\"\n                            onClick={() => requestPhaseTransition(card, mainNextPhaseObj.id)}\n                            title={`Avan\303\247ar para ${mainNextPhaseObj.name}`}\n                            className=\"flex-1 flex items-center justify-center gap-1 py-1 px-2 text-[10px] font-semibold text-indigo-700 bg-indigo-50/80 hover:bg-indigo-100 hover:text-indigo-900 rounded-lg transition-colors border border-indigo-100/80 cursor-pointer\"\n                          >\n                            <span>\342\236\224 {mainNextPhaseObj.name.split(\'. \')[1] || mainNextPhaseObj.name}</span>\n                          </button>\n                        ) : (\n                          <span className=\"text-[10px] font-medium text-slate-400\">Etapa final</span>\n                        )}\n\n                        {/* Quick Destination Select Dropdown */}\n                        <div className=\"relative shrink-0\">\n                          <select\n                            value=\"\"\n                            onChange={(e) => {\n                              if (e.target.value) {\n                                requestPhaseTransition(card, e.target.value as PhaseId);\n                              }\n                            }}\n                            className=\"text-[10px] font-medium text-slate-600 bg-slate-100/90 hover:bg-slate-200/80 px-2 py-1 rounded-lg border border-slate-200/80 focus:outline-none cursor-pointer\"\n                            title=\"Mover para outra fase...\"\n                          >\n                            <option value=\"\" disabled>\n                              Mover...\n                            </option>\n                            {allowedDestinations.map((destId) => {\n                              const destPhase = phases.find((p) => p.id === destId);\n                              if (!destPhase) return null;\n                              return (\n                                <option key={destId} value={destId}>\n                                  {destPhase.name}\n                                </option>\n                              );\n                            })}\n                          </select>\n                        </div>\n                      </div>\n\n                      {/* Card Bottom: Value, SLA & Assignee */}\n                      <div className=\"pt-1.5 border-t border-slate-100 flex items-center justify-between text-[11px]\">\n                        <span className=\"font-bold text-slate-800\">\n                          {card.value > 0 ? formatCurrency(card.value) : \'A definir\'}\n                        </span>\n\n                        <div className=\"flex items-center gap-2\">\n                          {/* SLA Pill */}\n                          {phase.slaHours > 0 && (\n                            <span\n                              className={`text-[10px] px-1.5 py-0.2 rounded font-medium flex items-center gap-0.5 ${\n                                sla.isOverdue\n                                  ? \'bg-rose-50 text-rose-700 font-semibold\'\n                                  : \'text-slate-400\'\n                              }`}\n                            >\n                              <Clock className=\"w-2.5 h-2.5\" />\n                              {sla.label}\n                            </span>\n                          )}\n\n                          {/* Quick WhatsApp Action */}\n                          {card.contactPhone && (\n                            <a\n                              href={getWhatsAppDirectUrl(card.contactPhone, `Ol\303\241 ${card.contactName}, tudo bem? Sou da equipe PipeCRM.`)}\n                              target=\"_blank\"\n                              rel=\"noreferrer\"\n                              onClick={(e) => e.stopPropagation()}\n                              title=\"Abrir WhatsApp\"\n                              className=\"text-slate-400 hover:text-emerald-600 transition-colors p-0.5\"\n                            >\n                              <Phone className=\"w-3 h-3\" />\n                            </a>\n                          )}\n\n                          {/* Assignee Avatar */}\n                          {assignedUser && (\n                            <img\n                              src={assignedUser.avatar}\n                              alt={assignedUser.name}\n                              title={assignedUser.name}\n                              className=\"w-4 h-4 rounded-full object-cover ring-1 ring-slate-200\"\n                            />\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  );"
