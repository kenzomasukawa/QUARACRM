  file_change {
    absolute_path_uri: "file:///src/components/AutomationsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"p-4 sm:p-6 max-w-7xl mx-auto space-y-6\">\n      {/* Header Bar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-slate-200\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n            <Zap className=\"w-5 h-5 text-amber-500\" />\n            <span>Central de Automa\303\247\303\265es & Regras de Processo</span>\n          </h2>\n          <p className=\"text-xs text-slate-500\">\n            Configure gatilhos e a\303\247\303\265es autom\303\241ticas estilo Pipefy para eliminar trabalhos manuais\n          </p>\n        </div>\n\n        <button\n          onClick={() => setIsModalOpen(true)}\n          className=\"flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold shadow-xs transition-colors cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Criar Nova Automa\303\247\303\243o</span>\n        </button>\n      </div>\n\n      {/* Rules Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {automations.map((rule) => (\n          <div\n            key={rule.id}\n            className={`p-5 rounded-2xl border transition-all shadow-2xs ${\n              rule.enabled ? \'bg-white border-slate-200 hover:border-indigo-300\' : \'bg-slate-50 border-slate-200 opacity-60\'\n            }`}\n          >\n            <div className=\"flex items-start justify-between gap-3 mb-3\">\n              <div className=\"flex items-center gap-2.5\">\n                <div\n                  className={`w-9 h-9 rounded-xl flex items-center justify-center ${\n                    rule.enabled ? \'bg-amber-100 text-amber-700\' : \'bg-slate-200 text-slate-500\'\n                  }`}\n                >\n                  <Zap className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"font-bold text-sm text-slate-900\">{rule.title}</h3>\n                  <span className=\"text-[10px] font-bold uppercase tracking-wider text-indigo-600\">\n                    Gatilho: {rule.trigger}\n                  </span>\n                </div>\n              </div>\n\n              {/* Toggle Switch */}\n              <button\n                onClick={() => toggleAutomation(rule.id)}\n                className={`p-1.5 rounded-lg transition-colors flex items-center gap-1.5 text-xs font-semibold ${\n                  rule.enabled\n                    ? \'bg-emerald-100 text-emerald-800 hover:bg-emerald-200\'\n                    : \'bg-slate-200 text-slate-600 hover:bg-slate-300\'\n                }`}\n              >\n                <Power className=\"w-3.5 h-3.5\" />\n                <span>{rule.enabled ? \'Ativa\' : \'Pausada\'}</span>\n              </button>\n            </div>\n\n            <p className=\"text-xs text-slate-600 leading-relaxed mb-4\">{rule.description}</p>\n\n            {/* Visual Workflow Flow */}\n            <div className=\"p-3 bg-slate-50 rounded-xl border border-slate-100 mb-4 text-xs flex items-center gap-2\">\n              <span className=\"font-semibold text-slate-700\">Quando:</span>\n              <span className=\"px-2 py-0.5 bg-indigo-100 text-indigo-800 rounded font-medium text-[11px]\">\n                {rule.triggerPhase ? `Entrar em ${rule.triggerPhase}` : rule.trigger}\n              </span>\n              <ArrowRight className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span className=\"font-semibold text-slate-700\">Ent\303\243o:</span>\n              <span className=\"px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-medium text-[11px]\">\n                {rule.actions[0]?.type.replace(/_/g, \' \')}\n              </span>\n            </div>\n\n            {/* Rule Footer */}\n            <div className=\"pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400\">\n              <span className=\"flex items-center gap-1\">\n                <Play className=\"w-3 h-3 text-emerald-600\" />\n                <span>Executada <strong>{rule.executionCount}</strong> vezes</span>\n              </span>\n\n              <div className=\"flex items-center gap-3\">\n                {rule.lastExecutedAt && (\n                  <span>\303\232ltima: {formatTimeAgo(rule.lastExecutedAt)}</span>\n                )}\n                <button\n                  onClick={() => {\n                    if (confirm(`Deseja excluir a regra \"${rule.title}\"?`)) {\n                      deleteAutomation(rule.id);\n                    }\n                  }}\n                  className=\"text-slate-400 hover:text-rose-600 transition-colors\"\n                >\n                  <Trash2 className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Modal to Create New Automation */}\n      {isModalOpen && (\n        <div className=\"fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n            <div className=\"px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <Zap className=\"w-5 h-5 text-amber-500\" />\n                <h3 className=\"font-bold text-sm text-slate-900\">Configurar Nova Regra Autom\303\241tica</h3>\n              </div>\n              <button\n                onClick={() => setIsModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-700 text-lg font-bold\"\n              >\n                \303\227\n              </button>\n            </div>\n\n            <form onSubmit={handleCreateRule} className=\"p-6 space-y-4 text-xs\">\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">T\303\255tulo da Automa\303\247\303\243o *</label>\n                <input\n                  type=\"text\"\n                  value={title}\n                  onChange={(e) => setTitle(e.target.value)}\n                  placeholder=\"Ex: Disparar WhatsApp de Boas-Vindas\"\n                  required\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">Gatilho (Quando acontecer...) *</label>\n                <select\n                  value={trigger}\n                  onChange={(e) => setTrigger(e.target.value as any)}\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg font-semibold text-slate-800 focus:outline-none\"\n                >\n                  <option value=\"phase_enter\">Ao entrar em uma Fase espec\303\255fica</option>\n                  <option value=\"card_created\">Ao criar um novo Card</option>\n                  <option value=\"sla_breach\">Ao estourar o SLA de tempo limite</option>\n                  <option value=\"card_won\">Ao fechar como Ganho (Won)</option>\n                  <option value=\"card_lost\">Ao mover para Perdido (Lost)</option>\n                </select>\n              </div>\n\n              {(trigger === \'phase_enter\' || trigger === \'sla_breach\') && (\n                <div>\n                  <label className=\"block font-bold text-slate-700 mb-1\">Selecione a Fase</label>\n                  <select\n                    value={triggerPhase}\n                    onChange={(e) => setTriggerPhase(e.target.value as PhaseId)}\n                    className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg\"\n                  >\n                    {phases.map((p) => (\n                      <option key={p.id} value={p.id}>\n                        {p.name}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n              )}\n\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">A\303\247\303\243o (Ent\303\243o fa\303\247a...) *</label>\n                <select\n                  value={actionType}\n                  onChange={(e) => setActionType(e.target.value as any)}\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg font-semibold text-slate-800 focus:outline-none\"\n                >\n                  <option value=\"send_whatsapp_template\">Disparar mensagem no WhatsApp do Lead</option>\n                  <option value=\"notify_manager\">Enviar notifica\303\247\303\243o em tempo real ao Gerente</option>\n                  <option value=\"create_checklist_task\">Adicionar tarefa obrigat\303\263ria no checklist</option>\n                  <option value=\"add_tag\">Adicionar Tag / Etiqueta ao Card</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">Texto da Mensagem / Tarefa</label>\n                <textarea\n                  value={actionParamText}\n                  onChange={(e) => setActionParamText(e.target.value)}\n                  placeholder=\"Ol\303\241 {{contato}}, confirmamos seu diagn\303\263stico na {{empresa}}...\"\n                  rows={3}\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none\"\n                />\n                <span className=\"text-[10px] text-slate-400\">\n                  Vari\303\241veis dispon\303\255veis: {\'{{contato}}\'}, {\'{{empresa}}\'}, {\'{{valor}}\'}, {\'{{consultor}}\'}\n                </span>\n              </div>\n\n              <div className=\"flex items-center justify-end gap-3 pt-3 border-t border-slate-200\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsModalOpen(false)}\n                  className=\"px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg font-semibold\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold shadow-xs\"\n                >\n                  Salvar Regra\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
