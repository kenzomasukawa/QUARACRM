    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGEAnjw2g0TbCfXe9adv-d-72RAqNIDS_DvakTE56Iqfc5Q20fR0gSiKAJye8MqA1-Rfj2he-bV3-CDyzHO9FO80U5TRV0k8CBg78X9q3cqWGYkn80LXKXkL2RXDswBBqsF"
      title: "tailwindcss.com"
