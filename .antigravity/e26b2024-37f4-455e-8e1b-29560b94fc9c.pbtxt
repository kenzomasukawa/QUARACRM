  file_change {
    absolute_path_uri: "file:///src/components/ExportModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { X, FileSpreadsheet, Download, FileText, CheckCircle2, ShieldCheck } from \'lucide-react\';\nimport { useCRM } from \'../context/CRMContext\';\nimport { exportCardsToCSV, exportAuditLogsToCSV, exportConsultantReportToCSV } from \'../utils/exportUtils\';\n\nexport const ExportModal: React.FC = () => {\n  const { isExportModalOpen, setIsExportModalOpen, cards, phases, users, auditLogs } = useCRM();\n\n  if (!isExportModalOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        <div className=\"px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <FileSpreadsheet className=\"w-5 h-5 text-indigo-600\" />\n            <h3 className=\"font-bold text-sm text-slate-900\">Central de Exporta\303\247\303\243o de Dados</h3>\n          </div>\n          <button\n            onClick={() => setIsExportModalOpen(false)}\n            className=\"p-1 text-slate-400 hover:text-slate-700 font-bold\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <div className=\"p-6 space-y-4 text-xs\">\n          <p className=\"text-slate-600\">\n            Exporte conjuntos de dados completos compat\303\255veis com Microsoft Excel, Google Planilhas e sistemas de BI externos:\n          </p>\n\n          {/* Option 1: Pipeline */}\n          <div className=\"p-4 rounded-xl border border-slate-200 hover:border-indigo-300 transition-colors bg-white flex items-center justify-between gap-3 shadow-2xs\">\n            <div>\n              <h4 className=\"font-bold text-slate-900\">Pipeline Completo de Oportunidades</h4>\n              <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                Cont\303\251m todos os {cards.length} cards com perguntas personalizadas das 12 fases (canal, dores, propostas, follow-ups).\n              </p>\n            </div>\n            <button\n              onClick={() => {\n                exportCardsToCSV(cards, phases, users);\n                setIsExportModalOpen(false);\n              }}\n              className=\"px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg flex items-center gap-1.5 shrink-0 shadow-xs\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              <span>Baixar CSV</span>\n            </button>\n          </div>\n\n          {/* Option 2: Consultant Productivity */}\n          <div className=\"p-4 rounded-xl border border-slate-200 hover:border-indigo-300 transition-colors bg-white flex items-center justify-between gap-3 shadow-2xs\">\n            <div>\n              <h4 className=\"font-bold text-slate-900\">Relat\303\263rio de Produtividade dos Consultores</h4>\n              <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                Metas individuais, volume atingido em R$, taxa de convers\303\243o e leads fechados por vendedor.\n              </p>\n            </div>\n            <button\n              onClick={() => {\n                exportConsultantReportToCSV(users, cards);\n                setIsExportModalOpen(false);\n              }}\n              className=\"px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg flex items-center gap-1.5 shrink-0 shadow-xs\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              <span>Baixar CSV</span>\n            </button>\n          </div>\n\n          {/* Option 3: Audit Log */}\n          <div className=\"p-4 rounded-xl border border-slate-200 hover:border-indigo-300 transition-colors bg-white flex items-center justify-between gap-3 shadow-2xs\">\n            <div>\n              <h4 className=\"font-bold text-slate-900\">Trilha Completa de Auditoria & Compliance</h4>\n              <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                Hist\303\263rico detalhado de {auditLogs.length} eventos (movimenta\303\247\303\265es, disparos de mensagens, automa\303\247\303\265es e altera\303\247\303\265es).\n              </p>\n            </div>\n            <button\n              onClick={() => {\n                exportAuditLogsToCSV(auditLogs);\n                setIsExportModalOpen(false);\n              }}\n              className=\"px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-lg flex items-center gap-1.5 shrink-0 shadow-xs\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              <span>Baixar CSV</span>\n            </button>\n          </div>\n\n          <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg flex items-center gap-2 text-[11px] text-slate-500\">\n            <ShieldCheck className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n            <span>Os arquivos exportados utilizam codifica\303\247\303\243o UTF-8 com BOM para abrir com acentua\303\247\303\243o correta no Excel.</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
