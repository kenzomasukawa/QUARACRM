          text: "            <span className=\"font-semibold text-red-600 dark:text-red-400\">\"Sem or\303\247amento atual\"</span>. Considere oferecer planos"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
