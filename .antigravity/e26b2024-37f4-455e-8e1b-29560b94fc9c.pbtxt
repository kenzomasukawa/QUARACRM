  file_change {
    absolute_path_uri: "file:///src/components/CardModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Building2,\n  User as UserIcon,\n  Phone,\n  Mail,\n  DollarSign,\n  Calendar,\n  Clock,\n  Tag,\n  CheckSquare,\n  MessageSquare,\n  Send,\n  Sparkles,\n  ArrowRight,\n  Shield,\n  Trash2,\n  CheckCircle2,\n  AlertCircle,\n  ExternalLink,\n  ChevronRight,\n  Plus,\n  Paperclip,\n  Share2,\n} from \'lucide-react\';\nimport { useCRM } from \'../context/CRMContext\';\nimport { PhaseId, Priority, CardCustomData, CardMessage } from \'../types/crm\';\nimport {\n  formatCurrency,\n  formatDate,\n  formatTimeAgo,\n  getSLAStatus,\n  getWhatsAppDirectUrl,\n  cleanPhoneForWhatsApp,\n} from \'../utils/formatters\';\n\nexport const CardModal: React.FC = () => {\n  const {\n    selectedCard,\n    setSelectedCard,\n    phases,\n    users,\n    currentUser,\n    updateCard,\n    moveCardPhase,\n    deleteCard,\n    sendCardMessage,\n    toggleChecklistItem,\n    addChecklistItem,\n  } = useCRM();\n\n  const [activeTab, setActiveTab] = useState<\'fields\' | \'whatsapp\' | \'email\' | \'checklist\' | \'ai\' | \'history\'>(\'fields\');\n  const [newChecklistText, setNewChecklistText] = useState(\'\');\n  const [whatsappInput, setWhatsappInput] = useState(\'\');\n  const [emailSubject, setEmailSubject] = useState(\'\');\n  const [emailBody, setEmailBody] = useState(\'\');\n  const [isAiGenerating, setIsAiGenerating] = useState(false);\n  const [aiGeneratedText, setAiGeneratedText] = useState(\'\');\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\n  const [editTitleText, setEditTitleText] = useState(\'\');\n\n  if (!selectedCard) return null;\n\n  const currentPhase = phases.find((p) => p.id === selectedCard.phaseId) || phases[0];\n  const assignedUser = users.find((u) => u.id === selectedCard.assignedUserId);\n  const sla = getSLAStatus(selectedCard.enteredCurrentPhaseAt, currentPhase.slaHours);\n\n  // Field change handler\n  const handleCustomFieldChange = (key: string, value: any) => {\n    const updatedCustom = {\n      ...selectedCard.customFields,\n      [key]: value,\n    };\n    updateCard(\n      selectedCard.id,\n      { customFields: updatedCustom },\n      `Campo \"${key}\" atualizado para \"${value}\"`\n    );\n  };\n\n  const handleSendWhatsApp = (text?: string) => {\n    const msgToSend = text || whatsappInput;\n    if (!msgToSend.trim()) return;\n\n    sendCardMessage(selectedCard.id, {\n      channel: \'whatsapp\',\n      sender: \'consultant\',\n      senderName: currentUser.name,\n      content: msgToSend.trim(),\n      status: \'sent\',\n    });\n    setWhatsappInput(\'\');\n  };\n\n  const handleSendEmail = () => {\n    if (!emailBody.trim()) return;\n    sendCardMessage(selectedCard.id, {\n      channel: \'email\',\n      sender: \'consultant\',\n      senderName: currentUser.name,\n      subject: emailSubject || `Contato comercial - ${selectedCard.companyName}`,\n      content: emailBody.trim(),\n      status: \'sent\',\n    });\n    setEmailSubject(\'\');\n    setEmailBody(\'\');\n  };\n\n  const handleAddChecklist = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newChecklistText.trim()) return;\n    addChecklistItem(selectedCard.id, newChecklistText);\n    setNewChecklistText(\'\');\n  };\n\n  const handleGenerateAiResponse = (type: \'followup\' | \'proposal\' | \'objection\') => {\n    setIsAiGenerating(true);\n    setTimeout(() => {\n      let generated = \'\';\n      const clientName = selectedCard.contactName || \'Cliente\';\n      const company = selectedCard.companyName;\n      const pain = selectedCard.customFields?.doresIdentificadas || \'otimiza\303\247\303\243o de processos e aumento de vendas\';\n\n      if (type === \'followup\') {\n        generated = `Ol\303\241 ${clientName}! Tudo bem?\\n\\nPassando para acompanhar nossa conversa sobre o projeto da ${company}. Conseguiram analisar os pontos que discutimos sobre ${pain}?\\n\\nFico \303\240 disposi\303\247\303\243o para tirar qualquer d\303\272vida ou agendarmos uma call r\303\241pida de 15 minutos.\\n\\nAbra\303\247o,\\n${currentUser.name}`;\n      } else if (type === \'objection\') {\n        generated = `Prezado ${clientName}, compreendo perfeitamente sua considera\303\247\303\243o a respeito do investimento.\\n\\nNosso foco na ${company} \303\251 garantir um retorno direto na mitiga\303\247\303\243o das dores de ${pain}, onde estimamos uma redu\303\247\303\243o m\303\251dia de 35% no tempo de ciclo operacional nos primeiros 60 dias.\\n\\nPodemos formatar uma condi\303\247\303\243o facilitada em etapas para adequar ao fluxo financeiro atual de voc\303\252s?`;\n      } else {\n        generated = `Ol\303\241 ${clientName}! Conforme alinhado na nossa sess\303\243o de Diagn\303\263stico, preparamos a proposta executiva sob medida para a ${company}.\\n\\nO plano contempla a resolu\303\247\303\243o definitiva de ${pain}, com cronograma de implementa\303\247\303\243o assistida.\\n\\nSegue o link da apresenta\303\247\303\243o. Quando seria um bom momento para avaliarmos juntos?`;\n      }\n\n      setAiGeneratedText(generated);\n      setIsAiGenerating(false);\n    }, 600);\n  };\n\n  const currentPhaseIndex = phases.findIndex((p) => p.id === selectedCard.phaseId);\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-2 sm:p-4 overflow-y-auto\">\n      <div className=\"bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-5xl max-h-[92vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Header Bar */}\n        <div className=\"px-5 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between gap-4 shrink-0\">\n          <div className=\"flex items-center gap-3 min-w-0\">\n            <span className=\"px-2.5 py-1 bg-indigo-100 text-indigo-800 text-xs font-mono font-bold rounded-lg shrink-0\">\n              {selectedCard.id}\n            </span>\n\n            {isEditingTitle ? (\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  value={editTitleText}\n                  onChange={(e) => setEditTitleText(e.target.value)}\n                  className=\"px-2 py-1 text-base font-bold text-slate-800 border border-indigo-400 rounded-md focus:outline-none\"\n                  autoFocus\n                />\n                <button\n                  onClick={() => {\n                    if (editTitleText.trim()) {\n                      updateCard(selectedCard.id, { title: editTitleText });\n                    }\n                    setIsEditingTitle(false);\n                  }}\n                  className=\"px-2 py-1 text-xs bg-indigo-600 text-white font-medium rounded-md\"\n                >\n                  Salvar\n                </button>\n              </div>\n            ) : (\n              <h2\n                onClick={() => {\n                  setEditTitleText(selectedCard.title);\n                  setIsEditingTitle(true);\n                }}\n                title=\"Clique para editar o t\303\255tulo\"\n                className=\"text-base sm:text-lg font-bold text-slate-900 truncate hover:text-indigo-600 cursor-pointer flex items-center gap-1.5\"\n              >\n                {selectedCard.title}\n                <span className=\"text-xs text-slate-400 font-normal\">\342\234\216</span>\n              </h2>\n            )}\n          </div>\n\n          {/* Quick Actions & Close */}\n          <div className=\"flex items-center gap-2\">\n            <select\n              value={selectedCard.priority}\n              onChange={(e) =>\n                updateCard(\n                  selectedCard.id,\n                  { priority: e.target.value as Priority },\n                  `Prioridade alterada para ${e.target.value}`\n                )\n              }\n              className=\"text-xs px-2.5 py-1 bg-white border border-slate-200 rounded-lg font-medium text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n            >\n              <option value=\"baixa\">Baixa Prioridade</option>\n              <option value=\"media\">M\303\251dia Prioridade</option>\n              <option value=\"alta\">Alta Prioridade</option>\n              <option value=\"urgente\">\360\237\224\245 Urgente</option>\n            </select>\n\n            <button\n              onClick={() => {\n                if (confirm(`Tem certeza que deseja excluir o card ${selectedCard.title}?`)) {\n                  deleteCard(selectedCard.id);\n                }\n              }}\n              title=\"Excluir Card\"\n              className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors\"\n            >\n              <Trash2 className=\"w-4 h-4\" />\n            </button>\n\n            <button\n              onClick={() => setSelectedCard(null)}\n              className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Phase Progression Stepper (Pipefy Flow Bar) */}\n        <div className=\"px-5 py-3 bg-white border-b border-slate-100 overflow-x-auto no-scrollbar shrink-0\">\n          <div className=\"flex items-center gap-1 min-w-max\">\n            {phases.map((p, idx) => {\n              const isCurrent = p.id === selectedCard.phaseId;\n              const isPast = idx < currentPhaseIndex;\n\n              return (\n                <button\n                  key={p.id}\n                  onClick={() => moveCardPhase(selectedCard.id, p.id)}\n                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                    isCurrent\n                      ? \'bg-indigo-600 text-white shadow-xs\'\n                      : isPast\n                      ? \'bg-emerald-50 text-emerald-800 hover:bg-emerald-100\'\n                      : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n                  }`}\n                >\n                  {isPast && <CheckCircle2 className=\"w-3 h-3 text-emerald-600\" />}\n                  <span>{p.name.replace(/^\\d+\\.\\s*/, \'\')}</span>\n                  {idx < phases.length - 1 && <ChevronRight className=\"w-3 h-3 opacity-40 ml-1\" />}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Lead Summary Info Ribbon */}\n        <div className=\"px-5 py-3 bg-slate-50 border-b border-slate-200 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs shrink-0\">\n          <div>\n            <span className=\"text-slate-400 block text-[10px] uppercase font-bold\">Empresa</span>\n            <div className=\"font-semibold text-slate-800 flex items-center gap-1 mt-0.5\">\n              <Building2 className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span className=\"truncate\">{selectedCard.companyName}</span>\n            </div>\n          </div>\n\n          <div>\n            <span className=\"text-slate-400 block text-[10px] uppercase font-bold\">Contato & Telefone</span>\n            <div className=\"font-semibold text-slate-800 flex items-center gap-1 mt-0.5\">\n              <UserIcon className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span className=\"truncate\">{selectedCard.contactName}</span>\n              {selectedCard.contactPhone && (\n                <a\n                  href={getWhatsAppDirectUrl(selectedCard.contactPhone)}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"text-emerald-600 hover:underline ml-1 font-mono text-[11px]\"\n                >\n                  ({selectedCard.contactPhone})\n                </a>\n              )}\n            </div>\n          </div>\n\n          <div>\n            <span className=\"text-slate-400 block text-[10px] uppercase font-bold\">Valor da Oportunidade</span>\n            <div className=\"font-bold text-indigo-700 flex items-center gap-1 mt-0.5\">\n              <DollarSign className=\"w-3.5 h-3.5 text-indigo-500\" />\n              <input\n                type=\"number\"\n                value={selectedCard.value}\n                onChange={(e) =>\n                  updateCard(\n                    selectedCard.id,\n                    { value: parseFloat(e.target.value) || 0 },\n                    `Valor alterado para R$ ${e.target.value}`\n                  )\n                }\n                className=\"w-24 px-1.5 py-0.5 bg-white border border-slate-200 rounded font-bold text-indigo-700 text-xs\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <span className=\"text-slate-400 block text-[10px] uppercase font-bold\">Consultor Respons\303\241vel</span>\n            <select\n              value={selectedCard.assignedUserId}\n              onChange={(e) =>\n                updateCard(\n                  selectedCard.id,\n                  { assignedUserId: e.target.value },\n                  `Consultor alterado para ${users.find((u) => u.id === e.target.value)?.name}`\n                )\n              }\n              className=\"mt-0.5 w-full bg-white border border-slate-200 rounded px-1.5 py-0.5 font-medium text-slate-800 text-xs focus:outline-none\"\n            >\n              {users.map((u) => (\n                <option key={u.id} value={u.id}>\n                  {u.name}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Modal Navigation Tabs */}\n        <div className=\"px-5 border-b border-slate-200 bg-white flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0\">\n          <button\n            onClick={() => setActiveTab(\'fields\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n              activeTab === \'fields\'\n                ? \'border-indigo-600 text-indigo-600\'\n                : \'border-transparent text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <span>\360\237\223\235 Perguntas da Fase ({currentPhase.name.replace(/^\\d+\\.\\s*/, \'\')})</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'whatsapp\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n              activeTab === \'whatsapp\'\n                ? \'border-emerald-600 text-emerald-600\'\n                : \'border-transparent text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <span>\360\237\222\254 WhatsApp Integrado</span>\n            <span className=\"px-1.5 py-0.2 bg-emerald-100 text-emerald-800 rounded-full text-[10px]\">\n              {selectedCard.messages.filter((m) => m.channel === \'whatsapp\').length}\n            </span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'email\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n              activeTab === \'email\'\n                ? \'border-indigo-600 text-indigo-600\'\n                : \'border-transparent text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <span>\342\234\211\357\270\217 E-mail Integrado</span>\n            <span className=\"px-1.5 py-0.2 bg-indigo-100 text-indigo-800 rounded-full text-[10px]\">\n              {selectedCard.messages.filter((m) => m.channel === \'email\').length}\n            </span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'checklist\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n              activeTab === \'checklist\'\n                ? \'border-indigo-600 text-indigo-600\'\n                : \'border-transparent text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <span>\342\234\205 Checklist ({selectedCard.checklist.filter((c) => c.completed).length}/{selectedCard.checklist.length})</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'ai\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n              activeTab === \'ai\'\n                ? \'border-violet-600 text-violet-600\'\n                : \'border-transparent text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-violet-600\" />\n            <span>Assistente IA</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'history\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n              activeTab === \'history\'\n                ? \'border-indigo-600 text-indigo-600\'\n                : \'border-transparent text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <span>\360\237\223\234 Hist\303\263rico & Auditoria</span>\n          </button>\n        </div>\n\n        {/* Tab Content Body */}\n        <div className=\"flex-1 p-5 overflow-y-auto bg-slate-50/40\">\n          {/* TAB 1: PHASE CUSTOM QUESTIONS (PIPEFY CORE) */}\n          {activeTab === \'fields\' && (\n            <div className=\"max-w-3xl mx-auto space-y-6\">\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <div className=\"flex items-center justify-between mb-4 pb-2 border-b border-slate-100\">\n                  <div>\n                    <h3 className=\"font-bold text-sm text-slate-800\">\n                      Perguntas Obrigat\303\263rias da Fase: {currentPhase.name}\n                    </h3>\n                    <p className=\"text-xs text-slate-500 mt-0.5\">{currentPhase.description}</p>\n                  </div>\n                  {currentPhase.slaHours > 0 && (\n                    <span className=\"px-2.5 py-1 bg-amber-50 text-amber-800 border border-amber-200 rounded-lg text-xs font-medium flex items-center gap-1\">\n                      <Clock className=\"w-3.5 h-3.5\" /> SLA Recomendado: {currentPhase.slaHours}h\n                    </span>\n                  )}\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {currentPhase.requiredFields.map((field) => {\n                    const val = selectedCard.customFields?.[field.id] ?? \'\';\n\n                    return (\n                      <div\n                        key={field.id}\n                        className={field.type === \'textarea\' ? \'col-span-1 md:col-span-2\' : \'col-span-1\'}\n                      >\n                        <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                          {field.label} {field.required && <span className=\"text-rose-500\">*</span>}\n                        </label>\n\n                        {field.type === \'select\' ? (\n                          <select\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.id, e.target.value)}\n                            className=\"w-full text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:outline-none\"\n                          >\n                            <option value=\"\">Selecione uma op\303\247\303\243o...</option>\n                            {field.options?.map((opt) => (\n                              <option key={opt} value={opt}>\n                                {opt}\n                              </option>\n                            ))}\n                          </select>\n                        ) : field.type === \'textarea\' ? (\n                          <textarea\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.id, e.target.value)}\n                            placeholder={field.placeholder || \'Preencha este campo...\'}\n                            rows={3}\n                            className=\"w-full text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:outline-none\"\n                          />\n                        ) : field.type === \'currency\' ? (\n                          <div className=\"relative\">\n                            <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400\">\n                              R$\n                            </span>\n                            <input\n                              type=\"number\"\n                              value={val}\n                              onChange={(e) =>\n                                handleCustomFieldChange(field.id, parseFloat(e.target.value) || 0)\n                              }\n                              placeholder=\"0,00\"\n                              className=\"w-full text-xs pl-8 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:outline-none font-semibold\"\n                            />\n                          </div>\n                        ) : (\n                          <input\n                            type={field.type}\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.id, e.target.value)}\n                            placeholder={field.placeholder || \'\'}\n                            className=\"w-full text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:outline-none\"\n                          />\n                        )}\n\n                        {field.helpText && (\n                          <span className=\"text-[10px] text-slate-400 mt-1 block\">{field.helpText}</span>\n                        )}\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* General Contact Details */}\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <h4 className=\"font-bold text-xs text-slate-800 mb-3 uppercase tracking-wider\">\n                  Informa\303\247\303\265es de Cadastro do Lead\n                </h4>\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-600 mb-1\">E-mail</label>\n                    <input\n                      type=\"email\"\n                      value={selectedCard.contactEmail}\n                      onChange={(e) => updateCard(selectedCard.id, { contactEmail: e.target.value })}\n                      className=\"w-full text-xs px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-600 mb-1\">WhatsApp / Telefone</label>\n                    <input\n                      type=\"text\"\n                      value={selectedCard.contactPhone}\n                      onChange={(e) =>\n                        updateCard(selectedCard.id, {\n                          contactPhone: e.target.value,\n                          contactWhatsapp: e.target.value,\n                        })\n                      }\n                      className=\"w-full text-xs px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-600 mb-1\">Cargo do Contato</label>\n                    <input\n                      type=\"text\"\n                      value={selectedCard.contactRole || \'\'}\n                      onChange={(e) => updateCard(selectedCard.id, { contactRole: e.target.value })}\n                      className=\"w-full text-xs px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg\"\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: WHATSAPP INTEGRADO */}\n          {activeTab === \'whatsapp\' && (\n            <div className=\"max-w-3xl mx-auto flex flex-col h-[480px] bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs\">\n              {/* WhatsApp Chat Header */}\n              <div className=\"p-3 bg-emerald-600 text-white flex items-center justify-between\">\n                <div className=\"flex items-center gap-2.5\">\n                  <div className=\"w-8 h-8 rounded-full bg-white/20 flex items-center justify-center font-bold text-sm\">\n                    {selectedCard.contactName[0]}\n                  </div>\n                  <div>\n                    <p className=\"font-bold text-xs\">{selectedCard.contactName} ({selectedCard.companyName})</p>\n                    <p className=\"text-[10px] text-emerald-100 font-mono\">{selectedCard.contactPhone || \'Sem n\303\272mero\'}</p>\n                  </div>\n                </div>\n\n                {selectedCard.contactPhone && (\n                  <a\n                    href={getWhatsAppDirectUrl(\n                      selectedCard.contactPhone,\n                      `Ol\303\241 ${selectedCard.contactName}, tudo bem? Sou ${currentUser.name} da equipe PipeCRM.`\n                    )}\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    className=\"flex items-center gap-1 px-3 py-1 bg-white text-emerald-700 hover:bg-emerald-50 rounded-lg text-xs font-bold shadow-xs\"\n                  >\n                    <span>Abrir no WhatsApp Web</span>\n                    <ExternalLink className=\"w-3.5 h-3.5\" />\n                  </a>\n                )}\n              </div>\n\n              {/* Quick Reply Template Pills */}\n              <div className=\"px-3 py-2 bg-slate-100/80 border-b border-slate-200 flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs\">\n                <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider shrink-0\">Modelos:</span>\n                <button\n                  onClick={() =>\n                    setWhatsappInput(\n                      `Ol\303\241 ${selectedCard.contactName}! Tudo bem? Sou ${currentUser.name}. Gostaria de apresentar nossa solu\303\247\303\243o para a ${selectedCard.companyName}.`\n                    )\n                  }\n                  className=\"px-2 py-1 bg-white hover:bg-emerald-50 border border-slate-200 rounded text-[11px] text-slate-700 whitespace-nowrap\"\n                >\n                  \360\237\221\213 Apresenta\303\247\303\243o Inicial\n                </button>\n                <button\n                  onClick={() =>\n                    setWhatsappInput(\n                      `Oi ${selectedCard.contactName}! Tudo bem? Passando para saber se conseguiu analisar nossa proposta enviada na semana passada.`\n                    )\n                  }\n                  className=\"px-2 py-1 bg-white hover:bg-emerald-50 border border-slate-200 rounded text-[11px] text-slate-700 whitespace-nowrap\"\n                >\n                  \360\237\223\214 Follow-up de Proposta\n                </button>\n                <button\n                  onClick={() =>\n                    setWhatsappInput(\n                      `Ol\303\241 ${selectedCard.contactName}! Conseguimos aprovar aquela condi\303\247\303\243o especial para fecharmos o projeto da ${selectedCard.companyName} ainda este m\303\252s.`\n                    )\n                  }\n                  className=\"px-2 py-1 bg-white hover:bg-emerald-50 border border-slate-200 rounded text-[11px] text-slate-700 whitespace-nowrap\"\n                >\n                  \360\237\224\245 Condi\303\247\303\243o de Fechamento\n                </button>\n              </div>\n\n              {/* Chat Message Timeline */}\n              <div className=\"flex-1 p-4 overflow-y-auto space-y-3 bg-[#e5ddd5]/30\">\n                {selectedCard.messages\n                  .filter((m) => m.channel === \'whatsapp\')\n                  .map((msg) => {\n                    const isMe = msg.sender === \'consultant\';\n                    const isSystem = msg.sender === \'system\';\n\n                    if (isSystem) {\n                      return (\n                        <div key={msg.id} className=\"text-center my-2\">\n                          <span className=\"px-2.5 py-1 bg-slate-200/80 text-slate-600 rounded-full text-[10px] font-medium\">\n                            {msg.content} \342\200\242 {formatTimeAgo(msg.timestamp)}\n                          </span>\n                        </div>\n                      );\n                    }\n\n                    return (\n                      <div key={msg.id} className={`flex ${isMe ? \'justify-end\' : \'justify-start\'}`}>\n                        <div\n                          className={`max-w-[75%] p-3 rounded-2xl text-xs shadow-xs relative ${\n                            isMe\n                              ? \'bg-[#dcf8c6] text-slate-800 rounded-tr-none\'\n                              : \'bg-white text-slate-800 rounded-tl-none border border-slate-200\'\n                          }`}\n                        >\n                          <p className=\"text-[10px] font-bold mb-0.5 text-slate-500\">{msg.senderName}</p>\n                          <p className=\"whitespace-pre-wrap\">{msg.content}</p>\n                          <div className=\"text-[9px] text-slate-400 text-right mt-1\">\n                            {formatDate(msg.timestamp)}\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                {selectedCard.messages.filter((m) => m.channel === \'whatsapp\').length === 0 && (\n                  <div className=\"h-full flex items-center justify-center text-slate-400 text-xs\">\n                    Nenhuma mensagem no hist\303\263rico. Digite abaixo para enviar ou simular contato.\n                  </div>\n                )}\n              </div>\n\n              {/* Message Composer */}\n              <div className=\"p-3 bg-white border-t border-slate-200 flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  value={whatsappInput}\n                  onChange={(e) => setWhatsappInput(e.target.value)}\n                  onKeyDown={(e) => e.key === \'Enter\' && handleSendWhatsApp()}\n                  placeholder=\"Escreva uma mensagem no WhatsApp...\"\n                  className=\"flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500\"\n                />\n                <button\n                  onClick={() => handleSendWhatsApp()}\n                  className=\"p-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-xl transition-colors cursor-pointer\"\n                >\n                  <Send className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: E-MAIL INTEGRADO */}\n          {activeTab === \'email\' && (\n            <div className=\"max-w-3xl mx-auto space-y-4\">\n              {/* Compose New Email */}\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <h4 className=\"font-bold text-xs text-slate-800 mb-3 flex items-center gap-2\">\n                  <Mail className=\"w-4 h-4 text-indigo-600\" />\n                  <span>Enviar E-mail Direto</span>\n                </h4>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <input\n                      type=\"text\"\n                      value={`Para: ${selectedCard.contactEmail || \'lead@empresa.com.br\'}`}\n                      disabled\n                      className=\"w-full text-xs px-3 py-1.5 bg-slate-50 text-slate-500 border border-slate-200 rounded-lg\"\n                    />\n                  </div>\n                  <div>\n                    <input\n                      type=\"text\"\n                      value={emailSubject}\n                      onChange={(e) => setEmailSubject(e.target.value)}\n                      placeholder=\"Assunto do e-mail...\"\n                      className=\"w-full text-xs px-3 py-1.5 bg-white border border-slate-200 rounded-lg font-medium focus:ring-2 focus:ring-indigo-500/20 focus:outline-none\"\n                    />\n                  </div>\n                  <div>\n                    <textarea\n                      value={emailBody}\n                      onChange={(e) => setEmailBody(e.target.value)}\n                      placeholder=\"Escreva o corpo do e-mail para o cliente...\"\n                      rows={4}\n                      className=\"w-full text-xs p-3 bg-white border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500/20 focus:outline-none\"\n                    />\n                  </div>\n\n                  <div className=\"flex items-center justify-between pt-1\">\n                    <button\n                      type=\"button\"\n                      onClick={() =>\n                        setEmailBody(\n                          `Prezado(a) ${selectedCard.contactName},\\n\\nConforme conversamos, estamos enviando o material detalhado sobre os processos de transforma\303\247\303\243o na ${selectedCard.companyName}.\\n\\nAtenciosamente,\\n${currentUser.name}`\n                        )\n                      }\n                      className=\"text-xs text-indigo-600 hover:underline font-medium\"\n                    >\n                      Inserir Modelo Padr\303\243o\n                    </button>\n\n                    <button\n                      onClick={handleSendEmail}\n                      className=\"flex items-center gap-1.5 px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                      <span>Enviar E-mail</span>\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Email History Threads */}\n              <div className=\"space-y-3\">\n                <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider\">\n                  Hist\303\263rico de E-mails ({selectedCard.messages.filter((m) => m.channel === \'email\').length})\n                </h4>\n\n                {selectedCard.messages\n                  .filter((m) => m.channel === \'email\')\n                  .map((msg) => (\n                    <div key={msg.id} className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                      <div className=\"flex items-center justify-between mb-2\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs\">\n                            @\n                          </span>\n                          <span className=\"font-bold text-xs text-slate-800\">{msg.subject || \'Sem Assunto\'}</span>\n                        </div>\n                        <span className=\"text-[10px] text-slate-400\">{formatDate(msg.timestamp)}</span>\n                      </div>\n                      <p className=\"text-xs text-slate-600 whitespace-pre-wrap pl-8\">{msg.content}</p>\n                    </div>\n                  ))}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 4: CHECKLIST & TAREFAS */}\n          {activeTab === \'checklist\' && (\n            <div className=\"max-w-2xl mx-auto space-y-4\">\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <h4 className=\"font-bold text-xs text-slate-800 mb-3 flex items-center justify-between\">\n                  <span>Itens de Verifica\303\247\303\243o e Pr\303\263ximos Passos</span>\n                  <span className=\"text-indigo-600 text-xs font-semibold\">\n                    {selectedCard.checklist.filter((i) => i.completed).length} de {selectedCard.checklist.length} conclu\303\255dos\n                  </span>\n                </h4>\n\n                <div className=\"space-y-2 mb-4\">\n                  {selectedCard.checklist.map((item) => (\n                    <div\n                      key={item.id}\n                      onClick={() => toggleChecklistItem(selectedCard.id, item.id)}\n                      className={`flex items-start gap-2.5 p-2.5 rounded-lg border transition-all cursor-pointer ${\n                        item.completed\n                          ? \'bg-emerald-50/50 border-emerald-200 text-slate-500\'\n                          : \'bg-white border-slate-200 hover:border-indigo-300 text-slate-800\'\n                      }`}\n                    >\n                      <input\n                        type=\"checkbox\"\n                        checked={item.completed}\n                        onChange={() => {}}\n                        className=\"mt-0.5 rounded text-indigo-600 focus:ring-indigo-500\"\n                      />\n                      <span className={`text-xs flex-1 ${item.completed ? \'line-through opacity-70\' : \'font-medium\'}`}>\n                        {item.text}\n                      </span>\n                    </div>\n                  ))}\n\n                  {selectedCard.checklist.length === 0 && (\n                    <p className=\"text-xs text-slate-400 text-center py-4\">Nenhuma tarefa no checklist.</p>\n                  )}\n                </div>\n\n                {/* Add new item */}\n                <form onSubmit={handleAddChecklist} className=\"flex gap-2\">\n                  <input\n                    type=\"text\"\n                    value={newChecklistText}\n                    onChange={(e) => setNewChecklistText(e.target.value)}\n                    placeholder=\"Adicionar nova tarefa ao checklist...\"\n                    className=\"flex-1 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                  <button\n                    type=\"submit\"\n                    className=\"px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1\"\n                  >\n                    <Plus className=\"w-3.5 h-3.5\" />\n                    <span>Adicionar</span>\n                  </button>\n                </form>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 5: ASSISTENTE IA (GEMINI COPYWRITING & DEAL ADVISOR) */}\n          {activeTab === \'ai\' && (\n            <div className=\"max-w-2xl mx-auto space-y-4\">\n              <div className=\"p-4 bg-gradient-to-br from-violet-50 to-indigo-50/60 rounded-xl border border-violet-200 shadow-2xs\">\n                <div className=\"flex items-center gap-2 mb-2\">\n                  <Sparkles className=\"w-5 h-5 text-violet-600\" />\n                  <h4 className=\"font-bold text-sm text-violet-950\">Assistente Inteligente de Vendas</h4>\n                </div>\n                <p className=\"text-xs text-violet-700 mb-4\">\n                  Gere mensagens personalizadas de follow-up, quebra de obje\303\247\303\265es e propostas com base nos dados e na fase atual deste lead.\n                </p>\n\n                <div className=\"flex flex-wrap gap-2 mb-4\">\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'followup\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\222\254 Gerar Mensagem de Follow-up\n                  </button>\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'objection\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\233\241\357\270\217 Argumento para Obje\303\247\303\243o de Pre\303\247o\n                  </button>\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'proposal\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-white border border-violet-300 text-violet-800 hover:bg-violet-50 rounded-lg text-xs font-semibold transition-colors cursor-pointer\"\n                  >\n                    \360\237\223\204 Resumo da Proposta Executiva\n                  </button>\n                </div>\n\n                {isAiGenerating ? (\n                  <div className=\"p-6 bg-white rounded-xl border border-violet-200 text-center\">\n                    <div className=\"w-6 h-6 border-2 border-violet-600 border-t-transparent rounded-full animate-spin mx-auto mb-2\" />\n                    <p className=\"text-xs text-violet-700 font-medium\">Analisando hist\303\263rico e gerando copy otimizada...</p>\n                  </div>\n                ) : aiGeneratedText ? (\n                  <div className=\"p-4 bg-white rounded-xl border border-violet-200 shadow-2xs space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-[10px] font-bold uppercase text-violet-600 tracking-wider\">Sugest\303\243o Gerada:</span>\n                      <button\n                        onClick={() => {\n                          navigator.clipboard.writeText(aiGeneratedText);\n                          alert(\'Texto copiado para a \303\241rea de transfer\303\252ncia!\');\n                        }}\n                        className=\"text-xs text-violet-600 hover:underline font-semibold\"\n                      >\n                        Copiar Texto\n                      </button>\n                    </div>\n\n                    <p className=\"text-xs text-slate-800 whitespace-pre-wrap leading-relaxed bg-slate-50 p-3 rounded-lg border border-slate-100 font-sans\">\n                      {aiGeneratedText}\n                    </p>\n\n                    <div className=\"flex gap-2 pt-1\">\n                      <button\n                        onClick={() => {\n                          setWhatsappInput(aiGeneratedText);\n                          setActiveTab(\'whatsapp\');\n                        }}\n                        className=\"px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-semibold\"\n                      >\n                        Usar no WhatsApp\n                      </button>\n                      <button\n                        onClick={() => {\n                          setEmailBody(aiGeneratedText);\n                          setActiveTab(\'email\');\n                        }}\n                        className=\"px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-semibold\"\n                      >\n                        Usar no E-mail\n                      </button>\n                    </div>\n                  </div>\n                ) : null}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 6: HIST\303\223RICO & AUDITORIA */}\n          {activeTab === \'history\' && (\n            <div className=\"max-w-2xl mx-auto space-y-3\">\n              <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider mb-2\">\n                Trilha de Auditoria do Card ({selectedCard.history.length})\n              </h4>\n\n              <div className=\"relative border-l-2 border-indigo-200 ml-4 space-y-4 pl-4 py-1\">\n                {selectedCard.history.map((hist) => (\n                  <div key={hist.id} className=\"relative group\">\n                    <div className=\"absolute -left-[23px] top-1 w-3 h-3 bg-indigo-600 rounded-full border-2 border-white\" />\n                    <div className=\"p-3 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                      <div className=\"flex items-center justify-between text-xs mb-1\">\n                        <span className=\"font-bold text-slate-800\">{hist.userName}</span>\n                        <span className=\"text-[10px] text-slate-400\">{formatDate(hist.timestamp)}</span>\n                      </div>\n                      <p className=\"text-xs text-slate-600\">{hist.action}</p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
