  file_change {
    absolute_path_uri: "file:///src/components/CardModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Building2,\n  User as UserIcon,\n  Phone,\n  Mail,\n  DollarSign,\n  Calendar,\n  Clock,\n  Tag,\n  CheckSquare,\n  MessageSquare,\n  Send,\n  Sparkles,\n  ArrowRight,\n  Shield,\n  Trash2,\n  CheckCircle2,\n  AlertCircle,\n  ExternalLink,\n  ChevronRight,\n  Plus,\n  Paperclip,\n  Share2,\n} from \'lucide-react\';\nimport { useCRM } from \'../context/CRMContext\';\nimport { PhaseId, Priority, CardCustomData, CardMessage } from \'../types/crm\';\nimport {\n  formatCurrency,\n  formatDate,\n  formatTimeAgo,\n  getSLAStatus,\n  getWhatsAppDirectUrl,\n  cleanPhoneForWhatsApp,\n} from \'../utils/formatters\';\n\nexport const CardModal: React.FC = () => {\n  const {\n    selectedCard,\n    setSelectedCard,\n    phases,\n    users,\n    currentUser,\n    updateCard,\n    moveCardPhase,\n    deleteCard,\n    sendCardMessage,\n    toggleChecklistItem,\n    addChecklistItem,\n  } = useCRM();\n\n  const [activeTab, setActiveTab] = useState<\'fields\' | \'whatsapp\' | \'email\' | \'checklist\' | \'ai\' | \'history\'>(\'fields\');\n  const [newChecklistText, setNewChecklistText] = useState(\'\');\n  const [whatsappInput, setWhatsappInput] = useState(\'\');\n  const [emailSubject, setEmailSubject] = useState(\'\');\n  const [emailBody, setEmailBody] = useState(\'\');\n  const [isAiGenerating, setIsAiGenerating] = useState(false);\n  const [aiGeneratedText, setAiGeneratedText] = useState(\'\');\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\n  const [editTitleText, setEditTitleText] = useState(\'\');\n\n  if (!selectedCard) return null;\n\n  const currentPhase = phases.find((p) => p.id === selectedCard.phaseId) || phases[0];\n  const assignedUser = users.find((u) => u.id === selectedCard.assignedUserId);\n  const sla = getSLAStatus(selectedCard.enteredCurrentPhaseAt, currentPhase.slaHours);\n\n  // Field change handler\n  const handleCustomFieldChange = (key: string, value: any) => {\n    const updatedCustom = {\n      ...selectedCard.customFields,\n      [key]: value,\n    };\n    updateCard(\n      selectedCard.id,\n      { customFields: updatedCustom },\n      `Campo \"${key}\" atualizado para \"${value}\"`\n    );\n  };\n\n  const handleSendWhatsApp = (text?: string) => {\n    const msgToSend = text || whatsappInput;\n    if (!msgToSend.trim()) return;\n\n    sendCardMessage(selectedCard.id, {\n      channel: \'whatsapp\',\n      sender: \'consultant\',\n      senderName: currentUser.name,\n      content: msgToSend.trim(),\n      status: \'sent\',\n    });\n    setWhatsappInput(\'\');\n  };\n\n  const handleSendEmail = () => {\n    if (!emailBody.trim()) return;\n    sendCardMessage(selectedCard.id, {\n      channel: \'email\',\n      sender: \'consultant\',\n      senderName: currentUser.name,\n      subject: emailSubject || \'Contato Comercial\',\n      content: emailBody.trim(),\n      status: \'sent\',\n    });\n    setEmailBody(\'\');\n    setEmailSubject(\'\');\n  };\n\n  const handleAddChecklist = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newChecklistText.trim()) return;\n    addChecklistItem(selectedCard.id, newChecklistText);\n    setNewChecklistText(\'\');\n  };\n\n  const handleSaveTitle = () => {\n    if (editTitleText.trim() && editTitleText !== selectedCard.title) {\n      updateCard(selectedCard.id, { title: editTitleText.trim() }, `T\303\255tulo alterado para \"${editTitleText}\"`);\n    }\n    setIsEditingTitle(false);\n  };\n\n  const handleGenerateAiResponse = (type: \'followup\' | \'objection\' | \'proposal\') => {\n    setIsAiGenerating(true);\n    setTimeout(() => {\n      let text = \'\';\n      if (type === \'followup\') {\n        text = `Ol\303\241 ${selectedCard.contactName}, tudo bem? Aqui \303\251 o ${currentUser.name} da equipe comercial.\\n\\nGostaria de entender se voc\303\252 conseguiu avaliar os pontos que conversamos na fase de ${currentPhase.name} para a ${selectedCard.companyName}. Podemos agendar um alinhamento de 15 minutos amanh\303\243?`;\n      } else if (type === \'objection\') {\n        text = `Prezado ${selectedCard.contactName},\\n\\nCompreendo perfeitamente a sua aten\303\247\303\243o em rela\303\247\303\243o ao investimento de R$ ${selectedCard.value.toLocaleString(\'pt-BR\')}. Quando estruturamos o projeto para a ${selectedCard.companyName}, o objetivo principal \303\251 trazer um retorno l\303\255quido previs\303\255vel nos primeiros meses de implanta\303\247\303\243o. Vamos analisar os n\303\272meros de ROI juntos?`;\n      } else {\n        text = `\360\237\223\213 Proposta Comercial para ${selectedCard.companyName}\\n\\n\342\200\242 Contato Principal: ${selectedCard.contactName} (${selectedCard.contactRole})\\n\342\200\242 Valor de Investimento: R$ ${selectedCard.value.toLocaleString(\'pt-BR\')}\\n\342\200\242 Escopo: Implanta\303\247\303\243o e acelera\303\247\303\243o comercial integrada.\\n\342\200\242 Pr\303\263ximo Passo: Valida\303\247\303\243o das premissas e aprova\303\247\303\243o formal.`;\n      }\n      setAiGeneratedText(text);\n      setIsAiGenerating(false);\n    }, 600);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-slate-900/60 backdrop-blur-xs\">\n      <div className=\"bg-white w-full max-w-5xl h-[94vh] rounded-2xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Top Header */}\n        <div className=\"px-6 py-4 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-2 bg-indigo-500/20 text-indigo-400 rounded-xl border border-indigo-500/30\">\n              <Building2 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                {isEditingTitle ? (\n                  <div className=\"flex items-center gap-1.5\">\n                    <input\n                      type=\"text\"\n                      value={editTitleText}\n                      onChange={(e) => setEditTitleText(e.target.value)}\n                      onBlur={handleSaveTitle}\n                      onKeyDown={(e) => e.key === \'Enter\' && handleSaveTitle()}\n                      autoFocus\n                      className=\"text-base font-bold bg-slate-800 text-white px-2 py-0.5 rounded border border-indigo-400 focus:outline-none\"\n                    />\n                  </div>\n                ) : (\n                  <h3\n                    onClick={() => {\n                      setEditTitleText(selectedCard.title);\n                      setIsEditingTitle(true);\n                    }}\n                    className=\"font-bold text-base text-white hover:text-indigo-300 cursor-pointer flex items-center gap-1.5\"\n                    title=\"Clique para editar t\303\255tulo\"\n                  >\n                    {selectedCard.title}\n                  </h3>\n                )}\n                <span className=\"text-[11px] font-mono text-slate-400 bg-slate-800 px-2 py-0.5 rounded\">\n                  {selectedCard.id}\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400\">\n                {selectedCard.companyName} \342\200\242 Contato: {selectedCard.contactName} ({selectedCard.contactRole})\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => {\n                if (window.confirm(`Deseja realmente excluir a oportunidade \"${selectedCard.title}\"?`)) {\n                  deleteCard(selectedCard.id);\n                }\n              }}\n              className=\"p-2 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition\"\n              title=\"Excluir Oportunidade\"\n            >\n              <Trash2 className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => setSelectedCard(null)}\n              className=\"p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Phase Bar / Fast Advancement */}\n        <div className=\"bg-slate-800/90 px-6 py-2.5 border-b border-slate-700 flex items-center justify-between text-xs text-slate-300 overflow-x-auto gap-4\">\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <span className=\"font-semibold text-slate-400\">Fase Atual:</span>\n            <select\n              value={selectedCard.phaseId}\n              onChange={(e) => moveCardPhase(selectedCard.id, e.target.value as PhaseId)}\n              className=\"bg-slate-900 text-white font-bold px-3 py-1 rounded-lg border border-slate-700 focus:outline-none focus:border-indigo-500\"\n            >\n              {phases.map((p) => (\n                <option key={p.id} value={p.id}>\n                  {p.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <UserIcon className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>Consultor:</span>\n              <select\n                value={selectedCard.assignedUserId}\n                onChange={(e) => updateCard(selectedCard.id, { assignedUserId: e.target.value })}\n                className=\"bg-slate-900 text-white px-2 py-0.5 rounded border border-slate-700 text-xs focus:outline-none\"\n              >\n                {users.map((u) => (\n                  <option key={u.id} value={u.id}>\n                    {u.name}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <DollarSign className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Valor:</span>\n              <input\n                type=\"number\"\n                value={selectedCard.value}\n                onChange={(e) => updateCard(selectedCard.id, { value: parseFloat(e.target.value) || 0 })}\n                className=\"w-24 bg-slate-900 text-white px-2 py-0.5 rounded border border-slate-700 text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n\n            <div className=\"flex items-center gap-1 text-[11px]\">\n              <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>SLA:</span>\n              <span className={`px-1.5 py-0.5 rounded font-bold ${sla.isOverdue ? \'bg-rose-500/20 text-rose-300\' : \'bg-emerald-500/20 text-emerald-300\'}`}>\n                {sla.hoursInPhase}h / {currentPhase.slaHours}h\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Tab Navigation */}\n        <div className=\"flex border-b border-slate-200 bg-slate-50 px-6 pt-2 overflow-x-auto\">\n          <button\n            onClick={() => setActiveTab(\'fields\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'fields\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Dados da Oportunidade\n          </button>\n          <button\n            onClick={() => setActiveTab(\'whatsapp\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'whatsapp\'\n                ? \'border-emerald-600 text-emerald-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <MessageSquare className=\"w-3.5 h-3.5 text-emerald-600\" />\n            WhatsApp ({selectedCard.messages.filter((m) => m.channel === \'whatsapp\').length})\n          </button>\n          <button\n            onClick={() => setActiveTab(\'email\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'email\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Mail className=\"w-3.5 h-3.5\" />\n            E-mail ({selectedCard.messages.filter((m) => m.channel === \'email\').length})\n          </button>\n          <button\n            onClick={() => setActiveTab(\'checklist\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'checklist\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <CheckSquare className=\"w-3.5 h-3.5\" />\n            Checklist ({selectedCard.checklist.filter((c) => c.completed).length}/{selectedCard.checklist.length})\n          </button>\n          <button\n            onClick={() => setActiveTab(\'ai\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'ai\'\n                ? \'border-violet-600 text-violet-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-violet-600\" />\n            Assistente IA\n          </button>\n          <button\n            onClick={() => setActiveTab(\'history\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'history\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Clock className=\"w-3.5 h-3.5\" />\n            Auditoria ({selectedCard.history.length})\n          </button>\n        </div>\n\n        {/* Modal Main Body */}\n        <div className=\"p-6 overflow-y-auto flex-1 bg-slate-50/50\">\n          {/* TAB 1: FORMUL\303\201RIO E DADOS CADASTRAIS */}\n          {activeTab === \'fields\' && (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto\">\n              {/* Contact Info Card */}\n              <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n                <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider flex items-center gap-2\">\n                  <UserIcon className=\"w-4 h-4 text-indigo-600\" />\n                  Dados do Lead & Contato\n                </h4>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Empresa</label>\n                    <input\n                      type=\"text\"\n                      value={selectedCard.companyName}\n                      onChange={(e) => updateCard(selectedCard.id, { companyName: e.target.value })}\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Nome do Contato</label>\n                    <input\n                      type=\"text\"\n                      value={selectedCard.contactName}\n                      onChange={(e) => updateCard(selectedCard.id, { contactName: e.target.value })}\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Cargo</label>\n                      <input\n                        type=\"text\"\n                        value={selectedCard.contactRole || \'\'}\n                        onChange={(e) => updateCard(selectedCard.id, { contactRole: e.target.value })}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Prioridade</label>\n                      <select\n                        value={selectedCard.priority}\n                        onChange={(e) => updateCard(selectedCard.id, { priority: e.target.value as Priority })}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-semibold\"\n                      >\n                        <option value=\"baixa\">Baixa</option>\n                        <option value=\"media\">M\303\251dia</option>\n                        <option value=\"alta\">Alta</option>\n                        <option value=\"urgente\">Urgente</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">WhatsApp / Telefone</label>\n                    <div className=\"flex gap-2\">\n                      <input\n                        type=\"text\"\n                        value={selectedCard.contactWhatsapp || selectedCard.contactPhone || \'\'}\n                        onChange={(e) => updateCard(selectedCard.id, { contactWhatsapp: e.target.value, contactPhone: e.target.value })}\n                        className=\"flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-mono\"\n                      />\n                      <a\n                        href={getWhatsAppDirectUrl(selectedCard.contactWhatsapp || selectedCard.contactPhone || \'\', `Ol\303\241 ${selectedCard.contactName}, tudo bem?`)}\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                        className=\"px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1 shadow-2xs\"\n                      >\n                        <Phone className=\"w-3.5 h-3.5\" />\n                        Abrir Zap\n                      </a>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">E-mail</label>\n                    <input\n                      type=\"email\"\n                      value={selectedCard.contactEmail || \'\'}\n                      onChange={(e) => updateCard(selectedCard.id, { contactEmail: e.target.value })}\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Dynamic Phase Custom Fields */}\n              <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider flex items-center gap-2\">\n                    <CheckSquare className=\"w-4 h-4 text-indigo-600\" />\n                    Perguntas da Fase: {currentPhase.name}\n                  </h4>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {currentPhase.requiredFields.map((field) => {\n                    const val = selectedCard.customFields?.[field.key] ?? \'\';\n                    return (\n                      <div key={field.id} className=\"space-y-1\">\n                        <label className=\"block text-[11px] font-semibold text-slate-600\">\n                          {field.label} {field.required && <span className=\"text-rose-500\">*</span>}\n                        </label>\n\n                        {field.type === \'select\' ? (\n                          <select\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.key, e.target.value)}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                          >\n                            <option value=\"\">Selecione...</option>\n                            {field.options?.map((opt) => (\n                              <option key={opt} value={opt}>\n                                {opt}\n                              </option>\n                            ))}\n                          </select>\n                        ) : field.type === \'textarea\' ? (\n                          <textarea\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.key, e.target.value)}\n                            rows={3}\n                            placeholder={`Preencha ${field.label.toLowerCase()}...`}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                          />\n                        ) : (\n                          <input\n                            type={field.type === \'number\' || field.type === \'currency\' ? \'number\' : field.type === \'date\' ? \'date\' : \'text\'}\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.key, e.target.value)}\n                            placeholder={`Preencha ${field.label.toLowerCase()}...`}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                          />\n                        )}\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: WHATSAPP INTEGRADO */}\n          {activeTab === \'whatsapp\' && (\n            <div className=\"max-w-2xl mx-auto h-full flex flex-col bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs\">\n              {/* WhatsApp Header */}\n              <div className=\"p-3.5 bg-emerald-700 text-white flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-2.5 h-2.5 bg-emerald-300 rounded-full animate-pulse\" />\n                  <span className=\"font-bold text-xs\">Chat WhatsApp com {selectedCard.contactName}</span>\n                </div>\n                <a\n                  href={getWhatsAppDirectUrl(selectedCard.contactWhatsapp || selectedCard.contactPhone || \'\', whatsappInput || \'Ol\303\241!\')}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"text-[11px] bg-emerald-800 hover:bg-emerald-900 text-emerald-100 px-2.5 py-1 rounded-lg flex items-center gap-1 transition\"\n                >\n                  <ExternalLink className=\"w-3 h-3\" />\n                  Abrir Web WhatsApp\n                </a>\n              </div>\n\n              {/* Messages Thread */}\n              <div className=\"flex-1 p-4 bg-[#efeae2] overflow-y-auto space-y-3 min-h-[300px]\">\n                {selectedCard.messages\n                  .filter((m) => m.channel === \'whatsapp\')\n                  .map((msg) => {\n                    const isMe = msg.sender === \'consultant\';\n                    const isSystem = msg.sender === \'system\';\n\n                    if (isSystem) {\n                      return (\n                        <div key={msg.id} className=\"text-center my-2\">\n                          <span className=\"px-2.5 py-1 bg-slate-200/80 text-slate-600 rounded-full text-[10px] font-medium\">\n                            {msg.content} \342\200\242 {formatTimeAgo(msg.timestamp)}\n                          </span>\n                        </div>\n                      );\n                    }\n\n                    return (\n                      <div key={msg.id} className={`flex ${isMe ? \'justify-end\' : \'justify-start\'}`}>\n                        <div\n                          className={`max-w-[75%] p-3 rounded-2xl text-xs shadow-xs relative ${\n                            isMe\n                              ? \'bg-[#dcf8c6] text-slate-800 rounded-tr-none\'\n                              : \'bg-white text-slate-800 rounded-tl-none border border-slate-200\'\n                          }`}\n                        >\n                          <p className=\"text-[10px] font-bold mb-0.5 text-slate-500\">{msg.senderName}</p>\n                          <p className=\"whitespace-pre-wrap\">{msg.content}</p>\n                          <div className=\"text-[9px] text-slate-400 text-right mt-1\">\n                            {formatDate(msg.timestamp)}\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                {selectedCard.messages.filter((m) => m.channel === \'whatsapp\').length === 0 && (\n                  <div className=\"h-full flex items-center justify-center text-slate-400 text-xs\">\n                    Nenhuma mensagem no hist\303\263rico. Digite abaixo para enviar ou simular contato.\n                  </div>\n                )}\n              </div>\n\n              {/* Message Composer */}\n              <div className=\"p-3 bg-white border-t border-slate-200 flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  value={whatsappInput}\n                  onChange={(e) => setWhatsappInput(e.target.value)}\n                  onKeyDown={(e) => e.key === \'Enter\' && handleSendWhatsApp()}\n                  placeholder=\"Escreva uma mensagem no WhatsApp...\"\n                  className=\"flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500\"\n                />\n                <button\n                  onClick={() => handleSendWhatsApp()}\n                  className=\"p-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-xl transition-colors cursor-pointer\"\n                >\n                  <Send className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: E-MAIL INTEGRADO */}\n          {activeTab === \'email\' && (\n            <div className=\"max-w-3xl mx-auto space-y-4\">\n              {/* Compose New Email */}\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <h4 className=\"font-bold text-xs text-slate-800 mb-3 flex items-center gap-2\">\n                  <Mail className=\"w-4 h-4 text-indigo-600\" />\n                  <span>Enviar E-mail Direto</span>\n                </h4>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <input\n                      type=\"text\"\n                      value={`Para: ${selectedCard.contactEmail || \'lead@empresa.com.br\'}`}\n                      disabled\n                      className=\"w-full text-xs px-3 py-1.5 bg-slate-50 text-slate-500 border border-slate-200 rounded-lg\"\n                    />\n                  </div>\n                  <div>\n                    <input\n                      type=\"text\"\n                      value={emailSubject}\n                      onChange={(e) => setEmailSubject(e.target.value)}\n                      placeholder=\"Assunto do e-mail...\"\n                      className=\"w-full text-xs px-3 py-1.5 bg-white border border-slate-200 rounded-lg font-medium focus:ring-2 focus:ring-indigo-500/20 focus:outline-none\"\n                    />\n                  </div>\n                  <div>\n                    <textarea\n                      value={emailBody}\n                      onChange={(e) => setEmailBody(e.target.value)}\n                      placeholder=\"Escreva o corpo do e-mail para o cliente...\"\n                      rows={4}\n                      className=\"w-full text-xs p-3 bg-white border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500/20 focus:outline-none\"\n                    />\n                  </div>\n\n                  <div className=\"flex items-center justify-between pt-1\">\n                    <button\n                      type=\"button\"\n                      onClick={() =>\n                        setEmailBody(\n                          `Prezado(a) ${selectedCard.contactName},\\n\\nConforme conversamos, estamos enviando o material detalhado sobre os processos de transforma\303\247\303\243o na ${selectedCard.companyName}.\\n\\nAtenciosamente,\\n${currentUser.name}`\n                        )\n                      }\n                      className=\"text-xs text-indigo-600 hover:underline font-medium\"\n                    >\n                      Inserir Modelo Padr\303\243o\n                    </button>\n\n                    <button\n                      onClick={handleSendEmail}\n                      className=\"flex items-center gap-1.5 px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                      <span>Enviar E-mail</span>\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Email History Threads */}\n              <div className=\"space-y-3\">\n                <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider\">\n                  Hist\303\263rico de E-mails ({selectedCard.messages.filter((m) => m.channel === \'email\').length})\n                </h4>\n\n                {selectedCard.messages\n                  .filter((m) => m.channel === \'email\')\n                  .map((msg) => (\n                    <div key={msg.id} className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                      <div className=\"flex items-center justify-between mb-2\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs\">\n                            @\n                          </span>\n                          <span className=\"font-bold text-xs text-slate-800\">{msg.subject || \'Sem Assunto\'}</span>\n                        </div>\n                        <span className=\"text-[10px] text-slate-400\">{formatDate(msg.timestamp)}</span>\n                      </div>\n                      <p className=\"text-xs text-slate-600 whitespace-pre-wrap pl-8\">{msg.content}</p>\n                    </div>\n                  ))}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 4: CHECKLIST & TAREFAS */}\n          {activeTab === \'checklist\' && (\n            <div className=\"max-w-2xl mx-auto space-y-4\">\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <h4 className=\"font-bold text-xs text-slate-800 mb-3 flex items-center justify-between\">\n                  <span>Itens de Verifica\303\247\303\243o e Pr\303\263ximos Passos</span>\n                  <span className=\"text-indigo-600 text-xs font-semibold\">\n                    {selectedCard.checklist.filter((i) => i.completed).length} de {selectedCard.checklist.length} conclu\303\255dos\n                  </span>\n                </h4>\n\n                <div className=\"space-y-2 mb-4\">\n                  {selectedCard.checklist.map((item) => (\n                    <div\n                      key={item.id}\n                      onClick={() => toggleChecklistItem(selectedCard.id, item.id)}\n                      className={`flex items-start gap-2.5 p-2.5 rounded-lg border transition-all cursor-pointer ${\n                        item.completed\n                          ? \'bg-emerald-50/50 border-emerald-200 text-slate-500\'\n                          : \'bg-white border-slate-200 hover:border-indigo-300 text-slate-800\'\n                      }`}\n                    >\n                      <input\n                        type=\"checkbox\"\n                        checked={item.completed}\n                        onChange={() => {}}\n                        className=\"mt-0.5 rounded text-indigo-600 focus:ring-indigo-500\"\n                      />\n                      <span className={`text-xs flex-1 ${item.completed ? \'line-through opacity-70\' : \'font-medium\'}`}>\n                        {item.text}\n                      </span>\n                    </div>\n                  ))}\n\n                  {selectedCard.checklist.length === 0 && (\n                    <p className=\"text-xs text-slate-400 text-center py-4\">Nenhuma tarefa no checklist.</p>\n                  )}\n                </div>\n\n                {/* Add new item */}\n                <form onSubmit={handleAddChecklist} className=\"flex gap-2\">\n                  <input\n                    type=\"text\"\n                    value={newChecklistText}\n                    onChange={(e) => setNewChecklistText(e.target.value)}\n                    placeholder=\"Adicionar nova tarefa ao checklist...\"\n                    className=\"flex-1 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                  <button\n                    type=\"submit\"\n                    className=\"px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1\"\n                  >\n                    <Plus className=\"w-3.5 h-3.5\" />\n                    <span>Adicionar</span>\n                  </button>\n                </form>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 5: ASSISTENTE IA (GEMINI COPYWRITING & DEAL ADVISOR) */}\n          {activeTab === \'ai\' && (\n            <div className=\"max-w-2xl mx-auto space-y-4\">\n              <div className=\"p-4 bg-gradient-to-br from-violet-50 to-indigo-50/60 rounded-xl border border-violet-200 shadow-2xs\">\n                <div className=\"flex items-center gap-2 mb-2\">\n                  <Sparkles className=\"w-5 h-5 text-violet-600\" />\n                  <h4 className=\"font-bold text-sm text-violet-950\">Assistente Inteligente de Vendas</h4>\n                </div>\n                <p className=\"text-xs text-violet-700 mb-4\">\n                  Gere mensagens personalizadas de follow-up, quebra de obje\303\247\303\265es e propostas com base nos dados e na fase atual deste lead.\n                </p>\n\n                <div className=\"flex flex-wrap gap-2 mb-4\">\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'followup\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\222\254 Gerar Mensagem de Follow-up\n                  </button>\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'objection\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\233\241\357\270\217 Argumento para Obje\303\247\303\243o de Pre\303\247o\n                  </button>\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'proposal\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-white border border-violet-300 text-violet-800 hover:bg-violet-50 rounded-lg text-xs font-semibold transition-colors cursor-pointer\"\n                  >\n                    \360\237\223\204 Resumo da Proposta Executiva\n                  </button>\n                </div>\n\n                {isAiGenerating ? (\n                  <div className=\"p-6 bg-white rounded-xl border border-violet-200 text-center\">\n                    <div className=\"w-6 h-6 border-2 border-violet-600 border-t-transparent rounded-full animate-spin mx-auto mb-2\" />\n                    <p className=\"text-xs text-violet-700 font-medium\">Analisando hist\303\263rico e gerando copy otimizada...</p>\n                  </div>\n                ) : aiGeneratedText ? (\n                  <div className=\"p-4 bg-white rounded-xl border border-violet-200 shadow-2xs space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-[10px] font-bold uppercase text-violet-600 tracking-wider\">Sugest\303\243o Gerada:</span>\n                      <button\n                        onClick={() => {\n                          navigator.clipboard.writeText(aiGeneratedText);\n                          alert(\'Texto copiado para a \303\241rea de transfer\303\252ncia!\');\n                        }}\n                        className=\"text-xs text-violet-600 hover:underline font-semibold\"\n                      >\n                        Copiar Texto\n                      </button>\n                    </div>\n\n                    <p className=\"text-xs text-slate-800 whitespace-pre-wrap leading-relaxed bg-slate-50 p-3 rounded-lg border border-slate-100 font-sans\">\n                      {aiGeneratedText}\n                    </p>\n\n                    <div className=\"flex gap-2 pt-1\">\n                      <button\n                        onClick={() => {\n                          setWhatsappInput(aiGeneratedText);\n                          setActiveTab(\'whatsapp\');\n                        }}\n                        className=\"px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-semibold\"\n                      >\n                        Usar no WhatsApp\n                      </button>\n                      <button\n                        onClick={() => {\n                          setEmailBody(aiGeneratedText);\n                          setActiveTab(\'email\');\n                        }}\n                        className=\"px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-semibold\"\n                      >\n                        Usar no E-mail\n                      </button>\n                    </div>\n                  </div>\n                ) : null}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 6: HIST\303\223RICO & AUDITORIA */}\n          {activeTab === \'history\' && (\n            <div className=\"max-w-2xl mx-auto space-y-3\">\n              <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider mb-2\">\n                Trilha de Auditoria do Card ({selectedCard.history.length})\n              </h4>\n\n              <div className=\"relative border-l-2 border-indigo-200 ml-4 space-y-4 pl-4 py-1\">\n                {selectedCard.history.map((hist) => (\n                  <div key={hist.id} className=\"relative group\">\n                    <div className=\"absolute -left-[23px] top-1 w-3 h-3 bg-indigo-600 rounded-full border-2 border-white\" />\n                    <div className=\"p-3 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                      <div className=\"flex items-center justify-between text-xs mb-1\">\n                        <span className=\"font-bold text-slate-800\">{hist.userName}</span>\n                        <span className=\"text-[10px] text-slate-400\">{formatDate(hist.timestamp)}</span>\n                      </div>\n                      <p className=\"text-xs text-slate-600\">{hist.action}</p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Building2,\n  User as UserIcon,\n  Phone,\n  Mail,\n  DollarSign,\n  Calendar,\n  Clock,\n  Tag,\n  CheckSquare,\n  MessageSquare,\n  Send,\n  Sparkles,\n  ArrowRight,\n  Shield,\n  Trash2,\n  CheckCircle2,\n  AlertCircle,\n  ExternalLink,\n  ChevronRight,\n  Plus,\n  Paperclip,\n  Share2,\n  Database,\n  RefreshCw,\n  FileText,\n  Bot,\n} from \'lucide-react\';\nimport { useCRM } from \'../context/CRMContext\';\nimport { PhaseId, Priority, CardCustomData, CardMessage, LeadInteraction } from \'../types/crm\';\nimport {\n  formatCurrency,\n  formatDate,\n  formatTimeAgo,\n  getSLAStatus,\n  getWhatsAppDirectUrl,\n  cleanPhoneForWhatsApp,\n} from \'../utils/formatters\';\n\nexport const CardModal: React.FC = () => {\n  const {\n    selectedCard,\n    setSelectedCard,\n    phases,\n    users,\n    currentUser,\n    updateCard,\n    moveCardPhase,\n    deleteCard,\n    sendCardMessage,\n    toggleChecklistItem,\n    addChecklistItem,\n    currentLeadInteractions,\n    isLoadingInteractions,\n    loadLeadInteractions,\n    addLeadInteraction,\n    isSupabaseActive,\n  } = useCRM();\n\n  const [activeTab, setActiveTab] = useState<\'fields\' | \'whatsapp\' | \'email\' | \'checklist\' | \'ai\' | \'interactions\' | \'history\'>(\'fields\');\n  const [newChecklistText, setNewChecklistText] = useState(\'\');\n  const [whatsappInput, setWhatsappInput] = useState(\'\');\n  const [emailSubject, setEmailSubject] = useState(\'\');\n  const [emailBody, setEmailBody] = useState(\'\');\n  const [internalNoteText, setInternalNoteText] = useState(\'\');\n  const [isAiGenerating, setIsAiGenerating] = useState(false);\n  const [aiGeneratedText, setAiGeneratedText] = useState(\'\');\n  const [isEditingTitle, setIsEditingTitle] = useState(false);\n  const [editTitleText, setEditTitleText] = useState(\'\');\n\n  if (!selectedCard) return null;\n\n  const currentPhase = phases.find((p) => p.id === selectedCard.phaseId) || phases[0];\n  const assignedUser = users.find((u) => u.id === selectedCard.assignedUserId);\n  const sla = getSLAStatus(selectedCard.enteredCurrentPhaseAt, currentPhase.slaHours);\n\n  // Field change handler\n  const handleCustomFieldChange = (key: string, value: any) => {\n    const updatedCustom = {\n      ...selectedCard.customFields,\n      [key]: value,\n    };\n    updateCard(\n      selectedCard.id,\n      { customFields: updatedCustom },\n      `Campo \"${key}\" atualizado para \"${value}\"`\n    );\n  };\n\n  const handleSendWhatsApp = (text?: string) => {\n    const msgToSend = text || whatsappInput;\n    if (!msgToSend.trim()) return;\n\n    sendCardMessage(selectedCard.id, {\n      channel: \'whatsapp\',\n      sender: \'consultant\',\n      senderName: currentUser.name,\n      content: msgToSend.trim(),\n      status: \'sent\',\n    });\n    setWhatsappInput(\'\');\n  };\n\n  const handleSendEmail = () => {\n    if (!emailBody.trim()) return;\n    sendCardMessage(selectedCard.id, {\n      channel: \'email\',\n      sender: \'consultant\',\n      senderName: currentUser.name,\n      subject: emailSubject || \'Contato Comercial\',\n      content: emailBody.trim(),\n      status: \'sent\',\n    });\n    setEmailBody(\'\');\n    setEmailSubject(\'\');\n  };\n\n  const handleAddNote = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!internalNoteText.trim()) return;\n\n    await addLeadInteraction(selectedCard.id, {\n      type: \'note\',\n      channel: \'internal\',\n      sender: \'user\',\n      userId: currentUser.id,\n      userName: currentUser.name,\n      content: internalNoteText.trim(),\n    });\n\n    setInternalNoteText(\'\');\n  };\n\n  const handleAddChecklist = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newChecklistText.trim()) return;\n    addChecklistItem(selectedCard.id, newChecklistText);\n    setNewChecklistText(\'\');\n  };\n\n  const handleSaveTitle = () => {\n    if (editTitleText.trim() && editTitleText !== selectedCard.title) {\n      updateCard(selectedCard.id, { title: editTitleText.trim() }, `T\303\255tulo alterado para \"${editTitleText}\"`);\n    }\n    setIsEditingTitle(false);\n  };\n\n  const handleGenerateAiResponse = (type: \'followup\' | \'objection\' | \'proposal\') => {\n    setIsAiGenerating(true);\n    setTimeout(async () => {\n      let text = \'\';\n      if (type === \'followup\') {\n        text = `Ol\303\241 ${selectedCard.contactName}, tudo bem? Aqui \303\251 o ${currentUser.name} da equipe comercial.\\n\\nGostaria de entender se voc\303\252 conseguiu avaliar os pontos que conversamos na fase de ${currentPhase.name} para a ${selectedCard.companyName}. Podemos agendar um alinhamento de 15 minutos amanh\303\243?`;\n      } else if (type === \'objection\') {\n        text = `Prezado ${selectedCard.contactName},\\n\\nCompreendo perfeitamente a sua aten\303\247\303\243o em rela\303\247\303\243o ao investimento de R$ ${selectedCard.value.toLocaleString(\'pt-BR\')}. Quando estruturamos o projeto para a ${selectedCard.companyName}, o objetivo principal \303\251 trazer um retorno l\303\255quido previs\303\255vel nos primeiros meses de implanta\303\247\303\243o. Vamos analisar os n\303\272meros de ROI juntos?`;\n      } else {\n        text = `\360\237\223\213 Proposta Comercial para ${selectedCard.companyName}\\n\\n\342\200\242 Contato Principal: ${selectedCard.contactName} (${selectedCard.contactRole})\\n\342\200\242 Valor de Investimento: R$ ${selectedCard.value.toLocaleString(\'pt-BR\')}\\n\342\200\242 Escopo: Implanta\303\247\303\243o e acelera\303\247\303\243o comercial integrada.\\n\342\200\242 Pr\303\263ximo Passo: Valida\303\247\303\243o das premissas e aprova\303\247\303\243o formal.`;\n      }\n      setAiGeneratedText(text);\n      setIsAiGenerating(false);\n\n      // Save AI generation as an interaction in Supabase\n      await addLeadInteraction(selectedCard.id, {\n        type: \'ai_prompt\',\n        channel: \'ai_assistant\',\n        sender: \'system\',\n        userId: currentUser.id,\n        userName: \'Assistente IA (Gemini)\',\n        content: `[Sugest\303\243o de ${type.toUpperCase()} gerada]: ${text}`,\n      });\n    }, 600);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-slate-900/60 backdrop-blur-xs\">\n      <div className=\"bg-white w-full max-w-5xl h-[94vh] rounded-2xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        {/* Top Header */}\n        <div className=\"px-6 py-4 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-2 bg-indigo-500/20 text-indigo-400 rounded-xl border border-indigo-500/30\">\n              <Building2 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                {isEditingTitle ? (\n                  <div className=\"flex items-center gap-1.5\">\n                    <input\n                      type=\"text\"\n                      value={editTitleText}\n                      onChange={(e) => setEditTitleText(e.target.value)}\n                      onBlur={handleSaveTitle}\n                      onKeyDown={(e) => e.key === \'Enter\' && handleSaveTitle()}\n                      autoFocus\n                      className=\"text-base font-bold bg-slate-800 text-white px-2 py-0.5 rounded border border-indigo-400 focus:outline-none\"\n                    />\n                  </div>\n                ) : (\n                  <h3\n                    onClick={() => {\n                      setEditTitleText(selectedCard.title);\n                      setIsEditingTitle(true);\n                    }}\n                    className=\"font-bold text-base text-white hover:text-indigo-300 cursor-pointer flex items-center gap-1.5\"\n                    title=\"Clique para editar t\303\255tulo\"\n                  >\n                    {selectedCard.title}\n                  </h3>\n                )}\n                <span className=\"text-[11px] font-mono text-slate-400 bg-slate-800 px-2 py-0.5 rounded\">\n                  {selectedCard.id}\n                </span>\n                {isSupabaseActive && (\n                  <span className=\"text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full border border-emerald-500/30 flex items-center gap-1\">\n                    <Database className=\"w-2.5 h-2.5\" />\n                    Supabase Nuvem\n                  </span>\n                )}\n              </div>\n              <p className=\"text-xs text-slate-400\">\n                {selectedCard.companyName} \342\200\242 Contato: {selectedCard.contactName} ({selectedCard.contactRole})\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => {\n                if (window.confirm(`Deseja realmente excluir a oportunidade \"${selectedCard.title}\"?`)) {\n                  deleteCard(selectedCard.id);\n                }\n              }}\n              className=\"p-2 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition\"\n              title=\"Excluir Oportunidade\"\n            >\n              <Trash2 className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => setSelectedCard(null)}\n              className=\"p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Phase Bar / Fast Advancement */}\n        <div className=\"bg-slate-800/90 px-6 py-2.5 border-b border-slate-700 flex items-center justify-between text-xs text-slate-300 overflow-x-auto gap-4\">\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <span className=\"font-semibold text-slate-400\">Fase Atual:</span>\n            <select\n              value={selectedCard.phaseId}\n              onChange={(e) => moveCardPhase(selectedCard.id, e.target.value as PhaseId)}\n              className=\"bg-slate-900 text-white font-bold px-3 py-1 rounded-lg border border-slate-700 focus:outline-none focus:border-indigo-500\"\n            >\n              {phases.map((p) => (\n                <option key={p.id} value={p.id}>\n                  {p.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <UserIcon className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>Consultor:</span>\n              <select\n                value={selectedCard.assignedUserId}\n                onChange={(e) => updateCard(selectedCard.id, { assignedUserId: e.target.value })}\n                className=\"bg-slate-900 text-white px-2 py-0.5 rounded border border-slate-700 text-xs focus:outline-none\"\n              >\n                {users.map((u) => (\n                  <option key={u.id} value={u.id}>\n                    {u.name}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <DollarSign className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Valor:</span>\n              <input\n                type=\"number\"\n                value={selectedCard.value}\n                onChange={(e) => updateCard(selectedCard.id, { value: parseFloat(e.target.value) || 0 })}\n                className=\"w-24 bg-slate-900 text-white px-2 py-0.5 rounded border border-slate-700 text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n\n            <div className=\"flex items-center gap-1 text-[11px]\">\n              <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>SLA:</span>\n              <span className={`px-1.5 py-0.5 rounded font-bold ${sla.isOverdue ? \'bg-rose-500/20 text-rose-300\' : \'bg-emerald-500/20 text-emerald-300\'}`}>\n                {sla.hoursInPhase}h / {currentPhase.slaHours}h\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Tab Navigation */}\n        <div className=\"flex border-b border-slate-200 bg-slate-50 px-6 pt-2 overflow-x-auto\">\n          <button\n            onClick={() => setActiveTab(\'fields\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'fields\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <FileText className=\"w-3.5 h-3.5\" />\n            Dados da Oportunidade\n          </button>\n          <button\n            onClick={() => setActiveTab(\'interactions\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'interactions\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Database className=\"w-3.5 h-3.5 text-emerald-600\" />\n            Intera\303\247\303\265es & Conversas ({currentLeadInteractions.length})\n          </button>\n          <button\n            onClick={() => setActiveTab(\'whatsapp\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'whatsapp\'\n                ? \'border-emerald-600 text-emerald-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <MessageSquare className=\"w-3.5 h-3.5 text-emerald-600\" />\n            WhatsApp Integrado\n          </button>\n          <button\n            onClick={() => setActiveTab(\'email\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'email\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Mail className=\"w-3.5 h-3.5\" />\n            E-mail Direto\n          </button>\n          <button\n            onClick={() => setActiveTab(\'checklist\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'checklist\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <CheckSquare className=\"w-3.5 h-3.5\" />\n            Checklist ({selectedCard.checklist.filter((c) => c.completed).length}/{selectedCard.checklist.length})\n          </button>\n          <button\n            onClick={() => setActiveTab(\'ai\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'ai\'\n                ? \'border-violet-600 text-violet-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-violet-600\" />\n            Assistente IA\n          </button>\n          <button\n            onClick={() => setActiveTab(\'history\')}\n            className={`pb-2.5 px-4 text-xs font-semibold flex items-center gap-1.5 border-b-2 transition whitespace-nowrap ${\n              activeTab === \'history\'\n                ? \'border-indigo-600 text-indigo-700 bg-white rounded-t-lg\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Clock className=\"w-3.5 h-3.5\" />\n            Auditoria\n          </button>\n        </div>\n\n        {/* Modal Main Body */}\n        <div className=\"p-6 overflow-y-auto flex-1 bg-slate-50/50\">\n          {/* TAB 1: FORMUL\303\201RIO E DADOS CADASTRAIS */}\n          {activeTab === \'fields\' && (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto\">\n              {/* Contact Info Card */}\n              <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n                <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider flex items-center gap-2\">\n                  <UserIcon className=\"w-4 h-4 text-indigo-600\" />\n                  Dados do Lead & Contato\n                </h4>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Empresa</label>\n                    <input\n                      type=\"text\"\n                      value={selectedCard.companyName}\n                      onChange={(e) => updateCard(selectedCard.id, { companyName: e.target.value })}\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Nome do Contato</label>\n                    <input\n                      type=\"text\"\n                      value={selectedCard.contactName}\n                      onChange={(e) => updateCard(selectedCard.id, { contactName: e.target.value })}\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Cargo</label>\n                      <input\n                        type=\"text\"\n                        value={selectedCard.contactRole || \'\'}\n                        onChange={(e) => updateCard(selectedCard.id, { contactRole: e.target.value })}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Prioridade</label>\n                      <select\n                        value={selectedCard.priority}\n                        onChange={(e) => updateCard(selectedCard.id, { priority: e.target.value as Priority })}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-semibold\"\n                      >\n                        <option value=\"baixa\">Baixa</option>\n                        <option value=\"media\">M\303\251dia</option>\n                        <option value=\"alta\">Alta</option>\n                        <option value=\"urgente\">Urgente</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">WhatsApp / Telefone</label>\n                    <div className=\"flex gap-2\">\n                      <input\n                        type=\"text\"\n                        value={selectedCard.contactWhatsapp || selectedCard.contactPhone || \'\'}\n                        onChange={(e) => updateCard(selectedCard.id, { contactWhatsapp: e.target.value, contactPhone: e.target.value })}\n                        className=\"flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-mono\"\n                      />\n                      <a\n                        href={getWhatsAppDirectUrl(selectedCard.contactWhatsapp || selectedCard.contactPhone || \'\', `Ol\303\241 ${selectedCard.contactName}, tudo bem?`)}\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                        className=\"px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1 shadow-2xs\"\n                      >\n                        <Phone className=\"w-3.5 h-3.5\" />\n                        Abrir Zap\n                      </a>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">E-mail</label>\n                    <input\n                      type=\"email\"\n                      value={selectedCard.contactEmail || \'\'}\n                      onChange={(e) => updateCard(selectedCard.id, { contactEmail: e.target.value })}\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Dynamic Phase Custom Fields */}\n              <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider flex items-center gap-2\">\n                    <CheckSquare className=\"w-4 h-4 text-indigo-600\" />\n                    Perguntas da Fase: {currentPhase.name}\n                  </h4>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {currentPhase.requiredFields.map((field) => {\n                    const val = selectedCard.customFields?.[field.key] ?? \'\';\n                    return (\n                      <div key={field.id} className=\"space-y-1\">\n                        <label className=\"block text-[11px] font-semibold text-slate-600\">\n                          {field.label} {field.required && <span className=\"text-rose-500\">*</span>}\n                        </label>\n\n                        {field.type === \'select\' ? (\n                          <select\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.key, e.target.value)}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                          >\n                            <option value=\"\">Selecione...</option>\n                            {field.options?.map((opt) => (\n                              <option key={opt} value={opt}>\n                                {opt}\n                              </option>\n                            ))}\n                          </select>\n                        ) : field.type === \'textarea\' ? (\n                          <textarea\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.key, e.target.value)}\n                            rows={3}\n                            placeholder={`Preencha ${field.label.toLowerCase()}...`}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                          />\n                        ) : (\n                          <input\n                            type={field.type === \'number\' || field.type === \'currency\' ? \'number\' : field.type === \'date\' ? \'date\' : \'text\'}\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.key, e.target.value)}\n                            placeholder={`Preencha ${field.label.toLowerCase()}...`}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                          />\n                        )}\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: INTERA\303\207\303\225ES ON-DEMAND (TABELA LEAD_INTERACTIONS DO SUPABASE) */}\n          {activeTab === \'interactions\' && (\n            <div className=\"max-w-3xl mx-auto space-y-4\">\n              {/* Info banner about on-demand query */}\n              <div className=\"bg-emerald-50 border border-emerald-200 rounded-xl p-3.5 text-xs text-emerald-900 flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <Database className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>\n                    Consultando <strong>apenas as intera\303\247\303\265es deste lead</strong> via tabela <code className=\"bg-emerald-100 px-1 py-0.5 rounded font-mono font-semibold\">lead_interactions</code> indexada por data.\n                  </span>\n                </div>\n                <button\n                  onClick={() => loadLeadInteractions(selectedCard.id)}\n                  disabled={isLoadingInteractions}\n                  className=\"px-2.5 py-1 bg-white hover:bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-lg text-[11px] font-semibold flex items-center gap-1 transition\"\n                >\n                  <RefreshCw className={`w-3 h-3 ${isLoadingInteractions ? \'animate-spin\' : \'\'}`} />\n                  Recarregar\n                </button>\n              </div>\n\n              {/* Add Quick Internal Note */}\n              <form onSubmit={handleAddNote} className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs space-y-3\">\n                <h4 className=\"font-bold text-xs text-slate-800 flex items-center gap-2\">\n                  <FileText className=\"w-4 h-4 text-indigo-600\" />\n                  Adicionar Anota\303\247\303\243o ou Registro de Contato\n                </h4>\n                <textarea\n                  value={internalNoteText}\n                  onChange={(e) => setInternalNoteText(e.target.value)}\n                  placeholder=\"Ex: Reuni\303\243o com CFO realizada. Ficou acordado apresentar proposta na quinta...\"\n                  rows={3}\n                  className=\"w-full text-xs p-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500/20 focus:outline-none text-slate-800\"\n                />\n                <div className=\"flex justify-end\">\n                  <button\n                    type=\"submit\"\n                    className=\"px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs flex items-center gap-1.5 transition\"\n                  >\n                    <Send className=\"w-3.5 h-3.5\" />\n                    Salvar Intera\303\247\303\243o\n                  </button>\n                </div>\n              </form>\n\n              {/* Timeline list of lead interactions */}\n              <div className=\"space-y-3\">\n                <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider\">\n                  Linha do Tempo de Intera\303\247\303\265es ({currentLeadInteractions.length})\n                </h4>\n\n                {isLoadingInteractions ? (\n                  <div className=\"p-8 text-center bg-white rounded-xl border border-slate-200\">\n                    <div className=\"w-6 h-6 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin mx-auto mb-2\" />\n                    <p className=\"text-xs text-slate-500\">Buscando intera\303\247\303\265es indexadas no Supabase...</p>\n                  </div>\n                ) : currentLeadInteractions.length === 0 ? (\n                  <div className=\"p-8 text-center bg-white rounded-xl border border-slate-200 text-slate-400 text-xs\">\n                    Nenhuma intera\303\247\303\243o registrada ainda para este lead.\n                  </div>\n                ) : (\n                  <div className=\"space-y-3\">\n                    {currentLeadInteractions.map((item) => {\n                      const isZap = item.type === \'whatsapp\' || item.channel === \'whatsapp\';\n                      const isMail = item.type === \'email\' || item.channel === \'email\';\n                      const isAi = item.type === \'ai_prompt\' || item.channel === \'ai_assistant\';\n                      const isHistory = item.type === \'history\';\n\n                      return (\n                        <div\n                          key={item.id}\n                          className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs space-y-1.5\"\n                        >\n                          <div className=\"flex items-center justify-between text-xs\">\n                            <div className=\"flex items-center gap-2\">\n                              {isZap ? (\n                                <span className=\"px-2 py-0.5 bg-emerald-100 text-emerald-800 font-bold rounded text-[10px] flex items-center gap-1\">\n                                  <Phone className=\"w-2.5 h-2.5\" />\n                                  WhatsApp\n                                </span>\n                              ) : isMail ? (\n                                <span className=\"px-2 py-0.5 bg-indigo-100 text-indigo-800 font-bold rounded text-[10px] flex items-center gap-1\">\n                                  <Mail className=\"w-2.5 h-2.5\" />\n                                  E-mail\n                                </span>\n                              ) : isAi ? (\n                                <span className=\"px-2 py-0.5 bg-violet-100 text-violet-800 font-bold rounded text-[10px] flex items-center gap-1\">\n                                  <Bot className=\"w-2.5 h-2.5\" />\n                                  IA Gemini\n                                </span>\n                              ) : isHistory ? (\n                                <span className=\"px-2 py-0.5 bg-slate-100 text-slate-700 font-bold rounded text-[10px] flex items-center gap-1\">\n                                  <Clock className=\"w-2.5 h-2.5\" />\n                                  Transi\303\247\303\243o de Fase\n                                </span>\n                              ) : (\n                                <span className=\"px-2 py-0.5 bg-amber-100 text-amber-800 font-bold rounded text-[10px] flex items-center gap-1\">\n                                  <FileText className=\"w-2.5 h-2.5\" />\n                                  Anota\303\247\303\243o Interna\n                                </span>\n                              )}\n\n                              <span className=\"font-bold text-slate-800\">{item.userName || \'Sistema\'}</span>\n                            </div>\n                            <span className=\"text-[10px] text-slate-400\">{formatDate(item.createdAt)}</span>\n                          </div>\n\n                          <p className=\"text-xs text-slate-700 whitespace-pre-wrap leading-relaxed pl-1\">\n                            {item.content}\n                          </p>\n                        </div>\n                      );\n                    })}\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: WHATSAPP INTEGRADO */}\n          {activeTab === \'whatsapp\' && (\n            <div className=\"max-w-2xl mx-auto h-full flex flex-col bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs\">\n              <div className=\"p-3.5 bg-emerald-700 text-white flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-2.5 h-2.5 bg-emerald-300 rounded-full animate-pulse\" />\n                  <span className=\"font-bold text-xs\">Chat WhatsApp com {selectedCard.contactName}</span>\n                </div>\n                <a\n                  href={getWhatsAppDirectUrl(selectedCard.contactWhatsapp || selectedCard.contactPhone || \'\', whatsappInput || \'Ol\303\241!\')}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"text-[11px] bg-emerald-800 hover:bg-emerald-900 text-emerald-100 px-2.5 py-1 rounded-lg flex items-center gap-1 transition\"\n                >\n                  <ExternalLink className=\"w-3 h-3\" />\n                  Abrir Web WhatsApp\n                </a>\n              </div>\n\n              <div className=\"flex-1 p-4 bg-[#efeae2] overflow-y-auto space-y-3 min-h-[300px]\">\n                {selectedCard.messages\n                  .filter((m) => m.channel === \'whatsapp\')\n                  .map((msg) => {\n                    const isMe = msg.sender === \'consultant\';\n                    const isSystem = msg.sender === \'system\';\n\n                    if (isSystem) {\n                      return (\n                        <div key={msg.id} className=\"text-center my-2\">\n                          <span className=\"px-2.5 py-1 bg-slate-200/80 text-slate-600 rounded-full text-[10px] font-medium\">\n                            {msg.content} \342\200\242 {formatTimeAgo(msg.timestamp)}\n                          </span>\n                        </div>\n                      );\n                    }\n\n                    return (\n                      <div key={msg.id} className={`flex ${isMe ? \'justify-end\' : \'justify-start\'}`}>\n                        <div\n                          className={`max-w-[75%] p-3 rounded-2xl text-xs shadow-xs relative ${\n                            isMe\n                              ? \'bg-[#dcf8c6] text-slate-800 rounded-tr-none\'\n                              : \'bg-white text-slate-800 rounded-tl-none border border-slate-200\'\n                          }`}\n                        >\n                          <p className=\"text-[10px] font-bold mb-0.5 text-slate-500\">{msg.senderName}</p>\n                          <p className=\"whitespace-pre-wrap\">{msg.content}</p>\n                          <div className=\"text-[9px] text-slate-400 text-right mt-1\">\n                            {formatDate(msg.timestamp)}\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                {selectedCard.messages.filter((m) => m.channel === \'whatsapp\').length === 0 && (\n                  <div className=\"h-full flex items-center justify-center text-slate-400 text-xs\">\n                    Nenhuma mensagem no hist\303\263rico. Digite abaixo para enviar ou simular contato.\n                  </div>\n                )}\n              </div>\n\n              {/* Message Composer */}\n              <div className=\"p-3 bg-white border-t border-slate-200 flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  value={whatsappInput}\n                  onChange={(e) => setWhatsappInput(e.target.value)}\n                  onKeyDown={(e) => e.key === \'Enter\' && handleSendWhatsApp()}\n                  placeholder=\"Escreva uma mensagem no WhatsApp...\"\n                  className=\"flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500\"\n                />\n                <button\n                  onClick={() => handleSendWhatsApp()}\n                  className=\"p-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-xl transition-colors cursor-pointer\"\n                >\n                  <Send className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 4: E-MAIL INTEGRADO */}\n          {activeTab === \'email\' && (\n            <div className=\"max-w-3xl mx-auto space-y-4\">\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <h4 className=\"font-bold text-xs text-slate-800 mb-3 flex items-center gap-2\">\n                  <Mail className=\"w-4 h-4 text-indigo-600\" />\n                  <span>Enviar E-mail Direto</span>\n                </h4>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <input\n                      type=\"text\"\n                      value={`Para: ${selectedCard.contactEmail || \'lead@empresa.com.br\'}`}\n                      disabled\n                      className=\"w-full text-xs px-3 py-1.5 bg-slate-50 text-slate-500 border border-slate-200 rounded-lg\"\n                    />\n                  </div>\n                  <div>\n                    <input\n                      type=\"text\"\n                      value={emailSubject}\n                      onChange={(e) => setEmailSubject(e.target.value)}\n                      placeholder=\"Assunto do e-mail...\"\n                      className=\"w-full text-xs px-3 py-1.5 bg-white border border-slate-200 rounded-lg font-medium focus:ring-2 focus:ring-indigo-500/20 focus:outline-none\"\n                    />\n                  </div>\n                  <div>\n                    <textarea\n                      value={emailBody}\n                      onChange={(e) => setEmailBody(e.target.value)}\n                      placeholder=\"Escreva o corpo do e-mail para o cliente...\"\n                      rows={4}\n                      className=\"w-full text-xs p-3 bg-white border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500/20 focus:outline-none\"\n                    />\n                  </div>\n\n                  <div className=\"flex items-center justify-between pt-1\">\n                    <button\n                      type=\"button\"\n                      onClick={() =>\n                        setEmailBody(\n                          `Prezado(a) ${selectedCard.contactName},\\n\\nConforme conversamos, estamos enviando o material detalhado sobre os processos de transforma\303\247\303\243o na ${selectedCard.companyName}.\\n\\nAtenciosamente,\\n${currentUser.name}`\n                        )\n                      }\n                      className=\"text-xs text-indigo-600 hover:underline font-medium\"\n                    >\n                      Inserir Modelo Padr\303\243o\n                    </button>\n\n                    <button\n                      onClick={handleSendEmail}\n                      className=\"flex items-center gap-1.5 px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                      <span>Enviar E-mail</span>\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Email History Threads */}\n              <div className=\"space-y-3\">\n                <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider\">\n                  Hist\303\263rico de E-mails ({selectedCard.messages.filter((m) => m.channel === \'email\').length})\n                </h4>\n\n                {selectedCard.messages\n                  .filter((m) => m.channel === \'email\')\n                  .map((msg) => (\n                    <div key={msg.id} className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                      <div className=\"flex items-center justify-between mb-2\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs\">\n                            @\n                          </span>\n                          <span className=\"font-bold text-xs text-slate-800\">{msg.subject || \'Sem Assunto\'}</span>\n                        </div>\n                        <span className=\"text-[10px] text-slate-400\">{formatDate(msg.timestamp)}</span>\n                      </div>\n                      <p className=\"text-xs text-slate-600 whitespace-pre-wrap pl-8\">{msg.content}</p>\n                    </div>\n                  ))}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 5: CHECKLIST & TAREFAS */}\n          {activeTab === \'checklist\' && (\n            <div className=\"max-w-2xl mx-auto space-y-4\">\n              <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                <h4 className=\"font-bold text-xs text-slate-800 mb-3 flex items-center justify-between\">\n                  <span>Itens de Verifica\303\247\303\243o e Pr\303\263ximos Passos</span>\n                  <span className=\"text-indigo-600 text-xs font-semibold\">\n                    {selectedCard.checklist.filter((i) => i.completed).length} de {selectedCard.checklist.length} conclu\303\255dos\n                  </span>\n                </h4>\n\n                <div className=\"space-y-2 mb-4\">\n                  {selectedCard.checklist.map((item) => (\n                    <div\n                      key={item.id}\n                      onClick={() => toggleChecklistItem(selectedCard.id, item.id)}\n                      className={`flex items-start gap-2.5 p-2.5 rounded-lg border transition-all cursor-pointer ${\n                        item.completed\n                          ? \'bg-emerald-50/50 border-emerald-200 text-slate-500\'\n                          : \'bg-white border-slate-200 hover:border-indigo-300 text-slate-800\'\n                      }`}\n                    >\n                      <input\n                        type=\"checkbox\"\n                        checked={item.completed}\n                        onChange={() => {}}\n                        className=\"mt-0.5 rounded text-indigo-600 focus:ring-indigo-500\"\n                      />\n                      <span className={`text-xs flex-1 ${item.completed ? \'line-through opacity-70\' : \'font-medium\'}`}>\n                        {item.text}\n                      </span>\n                    </div>\n                  ))}\n\n                  {selectedCard.checklist.length === 0 && (\n                    <p className=\"text-xs text-slate-400 text-center py-4\">Nenhuma tarefa no checklist.</p>\n                  )}\n                </div>\n\n                <form onSubmit={handleAddChecklist} className=\"flex gap-2\">\n                  <input\n                    type=\"text\"\n                    value={newChecklistText}\n                    onChange={(e) => setNewChecklistText(e.target.value)}\n                    placeholder=\"Adicionar nova tarefa ao checklist...\"\n                    className=\"flex-1 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                  <button\n                    type=\"submit\"\n                    className=\"px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1\"\n                  >\n                    <Plus className=\"w-3.5 h-3.5\" />\n                    <span>Adicionar</span>\n                  </button>\n                </form>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 6: ASSISTENTE IA (GEMINI COPYWRITING & DEAL ADVISOR) */}\n          {activeTab === \'ai\' && (\n            <div className=\"max-w-2xl mx-auto space-y-4\">\n              <div className=\"p-4 bg-gradient-to-br from-violet-50 to-indigo-50/60 rounded-xl border border-violet-200 shadow-2xs\">\n                <div className=\"flex items-center gap-2 mb-2\">\n                  <Sparkles className=\"w-5 h-5 text-violet-600\" />\n                  <h4 className=\"font-bold text-sm text-violet-950\">Assistente Inteligente de Vendas</h4>\n                </div>\n                <p className=\"text-xs text-violet-700 mb-4\">\n                  Gere mensagens personalizadas de follow-up, quebra de obje\303\247\303\265es e propostas com base nos dados e na fase atual deste lead.\n                </p>\n\n                <div className=\"flex flex-wrap gap-2 mb-4\">\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'followup\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\222\254 Gerar Mensagem de Follow-up\n                  </button>\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'objection\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\233\241\357\270\217 Argumento para Obje\303\247\303\243o de Pre\303\247o\n                  </button>\n                  <button\n                    onClick={() => handleGenerateAiResponse(\'proposal\')}\n                    disabled={isAiGenerating}\n                    className=\"px-3 py-1.5 bg-white border border-violet-300 text-violet-800 hover:bg-violet-50 rounded-lg text-xs font-semibold transition-colors cursor-pointer\"\n                  >\n                    \360\237\223\204 Resumo da Proposta Executiva\n                  </button>\n                </div>\n\n                {isAiGenerating ? (\n                  <div className=\"p-6 bg-white rounded-xl border border-violet-200 text-center\">\n                    <div className=\"w-6 h-6 border-2 border-violet-600 border-t-transparent rounded-full animate-spin mx-auto mb-2\" />\n                    <p className=\"text-xs text-violet-700 font-medium\">Analisando hist\303\263rico e gerando copy otimizada...</p>\n                  </div>\n                ) : aiGeneratedText ? (\n                  <div className=\"p-4 bg-white rounded-xl border border-violet-200 shadow-2xs space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-[10px] font-bold uppercase text-violet-600 tracking-wider\">Sugest\303\243o Gerada:</span>\n                      <button\n                        onClick={() => {\n                          navigator.clipboard.writeText(aiGeneratedText);\n                          alert(\'Texto copiado para a \303\241rea de transfer\303\252ncia!\');\n                        }}\n                        className=\"text-xs text-violet-600 hover:underline font-semibold\"\n                      >\n                        Copiar Texto\n                      </button>\n                    </div>\n\n                    <p className=\"text-xs text-slate-800 whitespace-pre-wrap leading-relaxed bg-slate-50 p-3 rounded-lg border border-slate-100 font-sans\">\n                      {aiGeneratedText}\n                    </p>\n\n                    <div className=\"flex gap-2 pt-1\">\n                      <button\n                        onClick={() => {\n                          setWhatsappInput(aiGeneratedText);\n                          setActiveTab(\'whatsapp\');\n                        }}\n                        className=\"px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-semibold\"\n                      >\n                        Usar no WhatsApp\n                      </button>\n                      <button\n                        onClick={() => {\n                          setEmailBody(aiGeneratedText);\n                          setActiveTab(\'email\');\n                        }}\n                        className=\"px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-semibold\"\n                      >\n                        Usar no E-mail\n                      </button>\n                    </div>\n                  </div>\n                ) : null}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 7: HIST\303\223RICO & AUDITORIA */}\n          {activeTab === \'history\' && (\n            <div className=\"max-w-2xl mx-auto space-y-3\">\n              <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider mb-2\">\n                Trilha de Auditoria do Card ({selectedCard.history.length})\n              </h4>\n\n              <div className=\"relative border-l-2 border-indigo-200 ml-4 space-y-4 pl-4 py-1\">\n                {selectedCard.history.map((hist) => (\n                  <div key={hist.id} className=\"relative group\">\n                    <div className=\"absolute -left-[23px] top-1 w-3 h-3 bg-indigo-600 rounded-full border-2 border-white\" />\n                    <div className=\"p-3 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n                      <div className=\"flex items-center justify-between text-xs mb-1\">\n                        <span className=\"font-bold text-slate-800\">{hist.userName}</span>\n                        <span className=\"text-[10px] text-slate-400\">{formatDate(hist.timestamp)}</span>\n                      </div>\n                      <p className=\"text-xs text-slate-600\">{hist.action}</p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    instruction: "Update CardModal.tsx with on-demand lead_interactions support from Supabase, interaction timeline and note recorder"
  }
}
