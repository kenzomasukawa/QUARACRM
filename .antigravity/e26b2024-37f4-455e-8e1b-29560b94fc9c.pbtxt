    instruction: "Replace dynamic phase questions box in CardModal with clean commercial and deal information fields"
    replacement_infos {
      original_chunk {
        target_content: "              {/* Dynamic Phase Custom Fields */}\n              <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider flex items-center gap-2\">\n                    <CheckSquare className=\"w-4 h-4 text-indigo-600\" />\n                    Perguntas da Fase: {currentPhase.name}\n                  </h4>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {currentPhase.requiredFields.map((field) => {\n                    const val = selectedCard.customFields?.[field.id] ?? \'\';\n                    return (\n                      <div key={field.id} className=\"space-y-1\">\n                        <label className=\"block text-[11px] font-semibold text-slate-600\">\n                          {field.label} {field.required && <span className=\"text-rose-500\">*</span>}\n                        </label>\n\n                        {field.type === \'select\' ? (\n                          <select\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.id, e.target.value)}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                          >\n                            <option value=\"\">Selecione...</option>\n                            {field.options?.map((opt) => (\n                              <option key={opt} value={opt}>\n                                {opt}\n                              </option>\n                            ))}\n                          </select>\n                        ) : field.type === \'textarea\' ? (\n                          <textarea\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.id, e.target.value)}\n                            rows={3}\n                            placeholder={`Preencha ${field.label.toLowerCase()}...`}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                          />\n                        ) : (\n                          <input\n                            type={field.type === \'number\' || field.type === \'currency\' ? \'number\' : field.type === \'date\' ? \'date\' : \'text\'}\n                            value={val}\n                            onChange={(e) => handleCustomFieldChange(field.id, e.target.value)}\n                            placeholder={`Preencha ${field.label.toLowerCase()}...`}\n                            className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                          />\n                        )}\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>"
        replacement_content: "              {/* Commercial & Deal Information */}\n              <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"font-bold text-xs text-slate-700 uppercase tracking-wider flex items-center gap-2\">\n                    <DollarSign className=\"w-4 h-4 text-emerald-600\" />\n                    Dados Comerciais & Negocia\303\247\303\243o\n                  </h4>\n                  <span className=\"text-[10px] font-semibold text-slate-400\">\n                    Fase: {currentPhase.name}\n                  </span>\n                </div>\n\n                <div className=\"space-y-3\">\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Origem / Canal</label>\n                      <select\n                        value={selectedCard.customFields?.canalIndicacao || selectedCard.customFields?.canalProspeccao || \'\'}\n                        onChange={(e) => handleCustomFieldChange(\'canalIndicacao\', e.target.value)}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                      >\n                        <option value=\"\">Selecione...</option>\n                        <option value=\"Passivo\">Passivo</option>\n                        <option value=\"Ativo Apollo\">Ativo Apollo</option>\n                        <option value=\"Indica\303\247\303\243o\">Indica\303\247\303\243o</option>\n                        <option value=\"LinkedIn Sales Nav\">LinkedIn</option>\n                        <option value=\"Outro\">Outro</option>\n                      </select>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Porte da Empresa</label>\n                      <select\n                        value={selectedCard.customFields?.tamanhoEmpresa || \'\'}\n                        onChange={(e) => handleCustomFieldChange(\'tamanhoEmpresa\', e.target.value)}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-medium\"\n                      >\n                        <option value=\"\">Selecione...</option>\n                        <option value=\"Pequena\">Pequena</option>\n                        <option value=\"M\303\251dia\">M\303\251dia</option>\n                        <option value=\"Grande\">Grande</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Necessidade do Cliente / Dores</label>\n                    <textarea\n                      value={selectedCard.customFields?.necessidadeCliente || selectedCard.customFields?.doresIdentificadas || \'\'}\n                      onChange={(e) => handleCustomFieldChange(\'necessidadeCliente\', e.target.value)}\n                      rows={2}\n                      placeholder=\"Descreva a principal necessidade, dor ou gargalo do cliente...\"\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Servi\303\247os Contratados / Escopo</label>\n                    <input\n                      type=\"text\"\n                      value={selectedCard.customFields?.servicosAdquiridos || \'\'}\n                      onChange={(e) => handleCustomFieldChange(\'servicosAdquiridos\', e.target.value)}\n                      placeholder=\"Ex: Consultoria Comercial, Licen\303\247as Enterprise, Treinamento...\"\n                      className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Validade Proposta / Follow</label>\n                      <input\n                        type=\"date\"\n                        value={selectedCard.customFields?.validadeProposta || selectedCard.customFields?.dataProximoFollowup || selectedCard.customFields?.dataProximaAtividade || \'\'}\n                        onChange={(e) => handleCustomFieldChange(\'validadeProposta\', e.target.value)}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[11px] font-semibold text-slate-500 mb-1\">Previs\303\243o Fechamento</label>\n                      <input\n                        type=\"date\"\n                        value={selectedCard.customFields?.previsaoFechamento || \'\'}\n                        onChange={(e) => handleCustomFieldChange(\'previsaoFechamento\', e.target.value)}\n                        className=\"w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800\"\n                      />\n                    </div>\n                  </div>\n\n                  {selectedCard.customFields?.motivoPerda && (\n                    <div className=\"p-2.5 bg-rose-50 border border-rose-200 rounded-lg text-rose-800 text-xs\">\n                      <strong>Motivo de Perda Registrado:</strong> {selectedCard.customFields.motivoPerda}\n                      {selectedCard.customFields.detalhesPerda && (\n                        <p className=\"mt-1 text-rose-700 text-[11px]\">{selectedCard.customFields.detalhesPerda}</p>\n                      )}\n                    </div>\n                  )}\n                </div>\n              </div>"
      }
      num_matches: 1
    }
  }
}
