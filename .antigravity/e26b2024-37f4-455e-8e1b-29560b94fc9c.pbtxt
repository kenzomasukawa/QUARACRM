  file_change {
    absolute_path_uri: "file:///src/utils/phaseTransitions.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { PhaseId, CRMCard, PhaseFieldDefinition } from \'../types/crm\';\n\nexport interface TransitionRuleCheck {\n  allowed: boolean;\n  reason?: string;\n  allowedDestinations?: PhaseId[];\n}\n\nexport interface TransitionFieldConfig {\n  id: string;\n  label: string;\n  type: \'text\' | \'textarea\' | \'number\' | \'currency\' | \'date\' | \'select\';\n  required: boolean;\n  options?: string[];\n  placeholder?: string;\n  helpText?: string;\n  defaultValue?: any;\n}\n\n// Allowed destination matrix based on user\'s exact specification\nexport const ALLOWED_TRANSITIONS: Record<PhaseId, PhaseId[]> = {\n  mapeados: [\'prospeccao\', \'perdido\'],\n  prospeccao: [\'diagnostica\', \'followup_1\', \'followup_2\', \'followup_3\', \'followup_4\', \'followup_5\', \'perdido\'],\n  diagnostica: [\'prospeccao\', \'proposta\', \'perdido\', \'followup_1\', \'followup_2\', \'followup_3\', \'followup_4\', \'followup_5\'],\n  proposta: [\'negociacao\', \'perdido\', \'followup_1\', \'followup_2\', \'followup_3\', \'followup_4\', \'followup_5\'],\n  negociacao: [\'ganho\', \'perdido\', \'proposta\', \'followup_1\', \'followup_2\', \'followup_3\', \'followup_4\', \'followup_5\'],\n  followup_1: [\'followup_2\', \'followup_3\', \'followup_4\', \'followup_5\', \'diagnostica\', \'negociacao\', \'perdido\'],\n  followup_2: [\'followup_1\', \'followup_3\', \'followup_4\', \'followup_5\', \'diagnostica\', \'negociacao\', \'perdido\'],\n  followup_3: [\'followup_1\', \'followup_2\', \'followup_4\', \'followup_5\', \'diagnostica\', \'negociacao\', \'perdido\'],\n  followup_4: [\'followup_1\', \'followup_2\', \'followup_3\', \'followup_5\', \'diagnostica\', \'negociacao\', \'perdido\'],\n  followup_5: [\'followup_1\', \'followup_2\', \'followup_3\', \'followup_4\', \'diagnostica\', \'negociacao\', \'perdido\'],\n  ganho: [\'negociacao\', \'perdido\'],\n  perdido: [\'mapeados\', \'prospeccao\', \'diagnostica\', \'proposta\', \'negociacao\'],\n};\n\nexport const isFollowupPhase = (phaseId: PhaseId): boolean => {\n  return (\n    phaseId === \'followup_1\' ||\n    phaseId === \'followup_2\' ||\n    phaseId === \'followup_3\' ||\n    phaseId === \'followup_4\' ||\n    phaseId === \'followup_5\'\n  );\n};\n\nexport const checkTransitionAllowed = (fromPhase: PhaseId, toPhase: PhaseId): TransitionRuleCheck => {\n  if (fromPhase === toPhase) {\n    return { allowed: true };\n  }\n\n  const allowedList = ALLOWED_TRANSITIONS[fromPhase] || [];\n  if (allowedList.includes(toPhase)) {\n    return { allowed: true, allowedDestinations: allowedList };\n  }\n\n  // Generate clear descriptive reason\n  let reason = `N\303\243o \303\251 permitido mover diretamente desta fase para a fase de destino.`;\n  if (fromPhase === \'mapeados\') {\n    reason = `De Mapeados, os cards s\303\263 podem avan\303\247ar para \"2. Prospec\303\247\303\243o\" ou ir para \"12. Perdido\".`;\n  } else if (fromPhase === \'prospeccao\') {\n    reason = `De Prospec\303\247\303\243o, os destinos permitidos s\303\243o \"3. Diagn\303\263stica\", Follow-ups (1 a 5) ou \"12. Perdido\".`;\n  } else if (fromPhase === \'diagnostica\') {\n    reason = `De Diagn\303\263stica, os destinos permitidos s\303\243o \"2. Prospec\303\247\303\243o (retornar)\", \"4. Proposta\" ou \"12. Perdido\".`;\n  } else if (fromPhase === \'proposta\') {\n    reason = `De Proposta, os destinos permitidos s\303\243o \"5. Negocia\303\247\303\243o\" ou \"12. Perdido\".`;\n  } else if (isFollowupPhase(fromPhase)) {\n    reason = `Dos Follow-ups, os destinos permitidos s\303\243o entre os pr\303\263prios Follow-ups, \"3. Diagn\303\263stica\", \"5. Negocia\303\247\303\243o\" ou \"12. Perdido\".`;\n  }\n\n  return {\n    allowed: false,\n    reason,\n    allowedDestinations: allowedList,\n  };\n};\n\nexport const getTransitionRequiredFields = (\n  fromPhase: PhaseId,\n  toPhase: PhaseId,\n  card?: CRMCard\n): TransitionFieldConfig[] => {\n  const today = new Date().toISOString().slice(0, 10);\n  const nextWeek = new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10);\n\n  // 1. Mapeado -> Prospec\303\247\303\243o\n  if (toPhase === \'prospeccao\' && fromPhase === \'mapeados\') {\n    return [\n      {\n        id: \'dataProspeccao\',\n        label: \'Data da Prospec\303\247\303\243o / Contato\',\n        type: \'date\',\n        required: true,\n        defaultValue: card?.customFields?.dataProspeccao || card?.customFields?.dataMapeamento || today,\n        helpText: \'Data em que a abordagem de prospec\303\247\303\243o foi/ser\303\241 realizada\',\n      },\n      {\n        id: \'canalIndicacao\',\n        label: \'Canal de Indica\303\247\303\243o / Origem\',\n        type: \'select\',\n        required: true,\n        options: [\'Passivo\', \'Ativo Apollo\', \'Indica\303\247\303\243o\'],\n        defaultValue: card?.customFields?.canalIndicacao || \'Ativo Apollo\',\n        helpText: \'Origem do lead: Passivo, Ativo Apollo ou Indica\303\247\303\243o\',\n      },\n    ];\n  }\n\n  // 2. Prospec\303\247\303\243o -> Diagn\303\263stica (or any transition to Diagn\303\263stica)\n  if (toPhase === \'diagnostica\') {\n    return [\n      {\n        id: \'tamanhoEmpresa\',\n        label: \'Tamanho da Empresa\',\n        type: \'select\',\n        required: true,\n        options: [\'Pequena\', \'M\303\251dia\', \'Grande\'],\n        defaultValue: card?.customFields?.tamanhoEmpresa || \'M\303\251dia\',\n        helpText: \'Porte qualificado da empresa para alinhamento do escopo\',\n      },\n      {\n        id: \'dataProximaAtividade\',\n        label: \'Data da Pr\303\263xima Atividade / Reuni\303\243o\',\n        type: \'date\',\n        required: true,\n        defaultValue: card?.customFields?.dataProximaAtividade || card?.customFields?.dataReuniaoDiagnostico || today,\n        helpText: \'Data agendada para a reuni\303\243o diagn\303\263stica ou pr\303\263ximo passo\',\n      },\n    ];\n  }\n\n  // 3. Diagn\303\263stica -> Proposta (or any transition to Proposta)\n  if (toPhase === \'proposta\') {\n    return [\n      {\n        id: \'necessidadeCliente\',\n        label: \'Necessidade do Cliente\',\n        type: \'textarea\',\n        required: true,\n        defaultValue: card?.customFields?.necessidadeCliente || card?.customFields?.doresIdentificadas || \'\',\n        placeholder: \'Descreva detalhadamente a dor, o desafio ou a necessidade levantada no diagn\303\263stico...\',\n        helpText: \'O que o cliente precisa resolver com a nossa proposta?\',\n      },\n    ];\n  }\n\n  // 4. Proposta -> Negocia\303\247\303\243o (or any transition to Negocia\303\247\303\243o)\n  if (toPhase === \'negociacao\') {\n    return [\n      {\n        id: \'servicosAdquiridos\',\n        label: \'Quais servi\303\247os ele est\303\241 adquirindo?\',\n        type: \'textarea\',\n        required: true,\n        defaultValue: card?.customFields?.servicosAdquiridos || card?.customFields?.escopoResumido || \'\',\n        placeholder: \'Ex: Consultoria Estrat\303\251gica, Licenciamento Enterprise, Treinamento da Equipe...\',\n        helpText: \'Servi\303\247os e m\303\263dulos inclu\303\255dos no escopo da proposta comercial\',\n      },\n      {\n        id: \'validadeProposta\',\n        label: \'Validade da Proposta\',\n        type: \'date\',\n        required: true,\n        defaultValue: card?.customFields?.validadeProposta || card?.customFields?.prazoValidadeProposta || nextWeek,\n        helpText: \'Data limite para aceite das condi\303\247\303\265es e valores apresentados\',\n      },\n      {\n        id: \'valorInicialProposta\',\n        label: \'Valor Inicial da Proposta (R$)\',\n        type: \'currency\',\n        required: true,\n        defaultValue: card?.customFields?.valorInicialProposta || card?.customFields?.valorProposta || card?.value || 0,\n        helpText: \'Valor financeiro total inicial apresentado na proposta\',\n      },\n    ];\n  }\n\n  // 5. Follow-ups (Transi\303\247\303\243o para qualquer um dos 5 follow ups)\n  if (isFollowupPhase(toPhase)) {\n    return [\n      {\n        id: \'dataProximoFollowup\',\n        label: \'Data do Pr\303\263ximo Follow-up\',\n        type: \'date\',\n        required: true,\n        defaultValue: card?.customFields?.dataProximoFollowup || today,\n        helpText: \'Data combinada ou estipulada para a pr\303\263xima tentativa de contato\',\n      },\n    ];\n  }\n\n  // 6. Perdido (Lost)\n  if (toPhase === \'perdido\') {\n    return [\n      {\n        id: \'motivoPerda\',\n        label: \'Motivo da Perda\',\n        type: \'select\',\n        required: true,\n        options: [\n          \'Pre\303\247o muito alto\',\n          \'Escolheu concorrente\',\n          \'Sem or\303\247amento atual\',\n          \'Desistiu do projeto\',\n          \'Lead sumiu (Ghosting)\',\n          \'Fora do Perfil (ICP)\',\n          \'Outro\',\n        ],\n        defaultValue: card?.customFields?.motivoPerda || \'Lead sumiu (Ghosting)\',\n      },\n      {\n        id: \'detalhesPerda\',\n        label: \'Observa\303\247\303\265es / Justificativa\',\n        type: \'textarea\',\n        required: false,\n        defaultValue: card?.customFields?.detalhesPerda || \'\',\n        placeholder: \'Detalhes adicionais sobre o encerramento da oportunidade...\',\n      },\n    ];\n  }\n\n  // 7. Ganho (Won)\n  if (toPhase === \'ganho\') {\n    return [\n      {\n        id: \'valorFechadoFinal\',\n        label: \'Valor Fechado Final (R$)\',\n        type: \'currency\',\n        required: true,\n        defaultValue: card?.customFields?.valorFechadoFinal || card?.value || 0,\n      },\n      {\n        id: \'dataFechamento\',\n        label: \'Data de Assinatura / Fechamento\',\n        type: \'date\',\n        required: true,\n        defaultValue: card?.customFields?.dataFechamento || today,\n      },\n      {\n        id: \'formaPagamentoFinal\',\n        label: \'Condi\303\247\303\243o / Forma de Pagamento\',\n        type: \'text\',\n        required: false,\n        defaultValue: card?.customFields?.formaPagamentoFinal || \'\303\200 vista via Pix / Boleto 30 dias\',\n      },\n    ];\n  }\n\n  return [];\n};\n"
    }
