    replacement_infos {
      original_chunk {
        target_content: "export const INITIAL_PHASES: PhaseConfig[] = [\n  {\n    id: \'mapeados\',\n    name: \'1. Mapeados\',\n    color: \'text-indigo-700\',\n    bgColor: \'bg-indigo-50/70\',\n    borderColor: \'border-indigo-200\',\n    badgeColor: \'bg-indigo-100 text-indigo-800\',\n    description: \'Leads identificados e mapeados para primeira abordagem\',\n    slaHours: 24,\n    requiredFields: [\n      {\n        id: \'dataMapeamento\',\n        label: \'Data de Mapeamento\',\n        type: \'date\',\n        required: true,\n        helpText: \'Data em que o lead foi registrado no radar\',\n      },\n      {\n        id: \'canalProspeccao\',\n        label: \'Canal de Prospec\303\247\303\243o Utilizado\',\n        type: \'select\',\n        required: true,\n        options: [\n          \'LinkedIn Sales Nav\',\n          \'Cold Call\',\n          \'Outbound E-mail\',\n          \'Indica\303\247\303\243o / Parceiro\',\n          \'Evento / Feira\',\n          \'Inbound Marketing\',\n          \'WhatsApp / Instagram\',\n          \'Outro\',\n        ],\n      },\n      {\n        id: \'perfilICP\',\n        label: \'Segmento / Perfil (ICP)\',\n        type: \'text\',\n        required: false,\n        placeholder: \'Ex: Fintech B2B > 50 funcion\303\241rios\',\n      },\n      {\n        id: \'linkPerfilLead\',\n        label: \'Link do LinkedIn ou Site\',\n        type: \'url\',\n        required: false,\n        placeholder: \'https://linkedin.com/in/...\',\n      },\n    ],\n  },\n  {\n    id: \'prospeccao\',\n    name: \'2. Prospec\303\247\303\243o\',\n    color: \'text-blue-700\',\n    bgColor: \'bg-blue-50/70\',\n    borderColor: \'border-blue-200\',\n    badgeColor: \'bg-blue-100 text-blue-800\',\n    description: \'Primeiro contato ativo (cad\303\252ncia de mensagens e cold call)\',\n    slaHours: 48,\n    requiredFields: [\n      {\n        id: \'tentativasContato\',\n        label: \'N\303\272mero de Tentativas de Contato\',\n        type: \'number\',\n        required: true,\n        placeholder: \'1\',\n      },\n      {\n        id: \'decisorIdentificado\',\n        label: \'Nome do Decisor / Contato Chave\',\n        type: \'text\',\n        required: true,\n        placeholder: \'Ex: Roberto Prado\',\n      },\n      {\n        id: \'cargoDecisor\',\n        label: \'Cargo do Decisor\',\n        type: \'text\',\n        required: false,\n        placeholder: \'Ex: Diretor de TI / CMO\',\n      },\n    ],\n  },\n  {\n    id: \'diagnostica\',\n    name: \'3. Diagn\303\263stica\',\n    color: \'text-cyan-700\',\n    bgColor: \'bg-cyan-50/70\',\n    borderColor: \'border-cyan-200\',\n    badgeColor: \'bg-cyan-100 text-cyan-800\',\n    description: \'Reuni\303\243o de alinhamento de dores, escopo e qualifica\303\247\303\243o t\303\251cnica\',\n    slaHours: 72,\n    requiredFields: [\n      {\n        id: \'dataReuniaoDiagnostico\',\n        label: \'Data da Reuni\303\243o de Diagn\303\263stico\',\n        type: \'date\',\n        required: true,\n      },\n      {\n        id: \'doresIdentificadas\',\n        label: \'Principais Dores e Desafios\',\n        type: \'textarea\',\n        required: true,\n        placeholder: \'Descreva os gargalos atuais e objetivos da empresa...\',\n      },\n      {\n        id: \'orcamentoEstimado\',\n        label: \'Or\303\247amento Estimado (R$)\',\n        type: \'currency\',\n        required: true,\n      },\n      {\n        id: \'urgenciaProjeto\',\n        label: \'Urg\303\252ncia da Solu\303\247\303\243o\',\n        type: \'select\',\n        required: true,\n        options: [\'Imediata\', \'Pr\303\263ximos 30 dias\', \'Pr\303\263ximo Trimestre\', \'Apenas pesquisando\'],\n      },\n    ],\n  },\n  {\n    id: \'proposta\',\n    name: \'4. Proposta\',\n    color: \'text-amber-700\',\n    bgColor: \'bg-amber-50/70\',\n    borderColor: \'border-amber-200\',\n    badgeColor: \'bg-amber-100 text-amber-800\',\n    description: \'Elabora\303\247\303\243o e apresenta\303\247\303\243o da proposta comercial e t\303\251cnica\',\n    slaHours: 72,\n    requiredFields: [\n      {\n        id: \'valorProposta\',\n        label: \'Valor da Proposta Apresentada (R$)\',\n        type: \'currency\',\n        required: true,\n      },\n      {\n        id: \'prazoValidadeProposta\',\n        label: \'Validade da Proposta\',\n        type: \'date\',\n        required: true,\n      },\n      {\n        id: \'escopoResumido\',\n        label: \'Escopo e Entreg\303\241veis\',\n        type: \'textarea\',\n        required: true,\n      },\n      {\n        id: \'condicaoPagamento\',\n        label: \'Condi\303\247\303\243o de Pagamento Oferecida\',\n        type: \'text\',\n        required: false,\n        placeholder: \'Ex: 50% entrada + 50% entrega ou 12x\',\n      },\n    ],\n  },\n  {\n    id: \'negociacao\',\n    name: \'5. Negocia\303\247\303\243o\',\n    color: \'text-orange-700\',\n    bgColor: \'bg-orange-50/70\',\n    borderColor: \'border-orange-200\',\n    badgeColor: \'bg-orange-100 text-orange-800\',\n    description: \'Ajustes contratuais, descontos e valida\303\247\303\243o com diretoria\',\n    slaHours: 96,\n    requiredFields: [\n      {\n        id: \'principalObjecao\',\n        label: \'Principal Obje\303\247\303\243o / Ponto em Negocia\303\247\303\243o\',\n        type: \'text\',\n        required: true,\n        placeholder: \'Ex: Pre\303\247o de implanta\303\247\303\243o, prazo de in\303\255cio...\',\n      },\n      {\n        id: \'previsaoFechamento\',\n        label: \'Previs\303\243o de Fechamento\',\n        type: \'date\',\n        required: true,\n      },\n      {\n        id: \'descontoSolicitadoPercent\',\n        label: \'Desconto Solicitado (%)\',\n        type: \'number\',\n        required: false,\n        placeholder: \'5\',\n      },\n    ],\n  },\n  {\n    id: \'followup_1\',\n    name: \'6. Follow up 1\',\n    color: \'text-yellow-800\',\n    bgColor: \'bg-yellow-50/70\',\n    borderColor: \'border-yellow-200\',\n    badgeColor: \'bg-yellow-100 text-yellow-800\',\n    description: \'1\302\272 contato ap\303\263s envio de proposta / alinhamento\',\n    slaHours: 48,\n    requiredFields: [\n      {\n        id: \'followup1Data\',\n        label: \'Data do 1\302\272 Follow-up\',\n        type: \'date\',\n        required: true,\n      },\n      {\n        id: \'followup1Canal\',\n        label: \'Canal Utilizado\',\n        type: \'select\',\n        required: true,\n        options: [\'WhatsApp\', \'Telefone\', \'E-mail\', \'Presencial\'],\n      },\n      {\n        id: \'followup1Resumo\',\n        label: \'Resumo da Intera\303\247\303\243o e Feedback\',\n        type: \'textarea\',\n        required: true,\n      },\n    ],\n  },\n  {\n    id: \'followup_2\',\n    name: \'7. Follow up 2\',\n    color: \'text-yellow-800\',\n    bgColor: \'bg-yellow-50/70\',\n    borderColor: \'border-yellow-300\',\n    badgeColor: \'bg-yellow-200 text-yellow-900\',\n    description: \'2\302\272 contato de acompanhamento de decis\303\243o\',\n    slaHours: 72,\n    requiredFields: [\n      {\n        id: \'followup2Data\',\n        label: \'Data do 2\302\272 Follow-up\',\n        type: \'date\',\n        required: true,\n      },\n      {\n        id: \'followup2Canal\',\n        label: \'Canal Utilizado\',\n        type: \'select\',\n        required: true,\n        options: [\'WhatsApp\', \'Telefone\', \'E-mail\'],\n      },\n      {\n        id: \'followup2Resumo\',\n        label: \'Resumo da Intera\303\247\303\243o e Feedback\',\n        type: \'textarea\',\n        required: true,\n      },\n    ],\n  },\n  {\n    id: \'followup_3\',\n    name: \'8. Follow up 3\',\n    color: \'text-purple-800\',\n    bgColor: \'bg-purple-50/70\',\n    borderColor: \'border-purple-200\',\n    badgeColor: \'bg-purple-100 text-purple-800\',\n    description: \'3\302\272 contato estrat\303\251gico com novo benef\303\255cio/case\',\n    slaHours: 72,\n    requiredFields: [\n      {\n        id: 