        }
        lines {
          text: "    if (typeof aVal === \'string\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const cmp = (aVal as string).localeCompare(bVal as string);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
