      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Plus,\n  ArrowRight,\n  Clock,\n  CheckSquare,\n  MessageSquare,\n  AlertCircle,\n  TrendingUp,\n  Tag,\n  User as UserIcon,\n  ChevronRight,\n  ExternalLink,\n  Phone,\n  Flame,\n  CheckCircle2,\n  XCircle,\n  Filter,\n} from \'lucide-react\';\nimport { useCRM } from \'../context/CRMContext\';\nimport { PhaseId, CRMCard, Priority } from \'../types/crm\';\nimport { formatCurrency, formatTimeAgo, getSLAStatus, getWhatsAppDirectUrl } from \'../utils/formatters\';\n\nexport const KanbanBoard: React.FC = () => {\n  const {\n    phases,\n    cards,\n    users,\n    setSelectedCard,\n    openNewCardModal,\n    moveCardPhase,\n    activeFilterConsultant,\n    setActiveFilterConsultant,\n    activePriorityFilter,\n    setActivePriorityFilter,\n    searchQuery,\n  } = useCRM();\n\n  const [draggedCardId, setDraggedCardId] = useState<string | null>(null);\n  const [dragOverPhaseId, setDragOverPhaseId] = useState<PhaseId | null>(null);\n\n  // User Map for quick lookup\n  const userMap = new Map(users.map((u) => [u.id, u]));\n\n  // Filter cards\n  const filteredCards = cards.filter((card) => {\n    // Consultant filter\n    if (activeFilterConsultant !== \'all\' && card.assignedUserId !== activeFilterConsultant) {\n      return false;\n    }\n    // Priority filter\n    if (activePriorityFilter !== \'all\' && card.priority !== activePriorityFilter) {\n      return false;\n    }\n    // Search query\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      const matchTitle = card.title.toLowerCase().includes(q);\n      const matchCompany = card.companyName.toLowerCase().includes(q);\n      const matchContact = card.contactName.toLowerCase().includes(q);\n      const matchTags = card.tags.some((t) => t.toLowerCase().includes(q));\n      const matchValue = card.value.toString().includes(q);\n      if (!matchTitle && !matchCompany && !matchContact && !matchTags && !matchValue) {\n        return false;\n      }\n    }\n    return true;\n  });\n\n  // Calculate Pipeline Metrics Summary\n  const totalPipelineValue = filteredCards\n    .filter((c) => c.phaseId !== \'ganho\' && c.phaseId !== \'perdido\')\n    .reduce((sum, c) => sum + (c.value || 0), 0);\n\n  const totalWonValue = filteredCards\n    .filter((c) => c.phaseId === \'ganho\')\n    .reduce((sum, c) => sum + (c.value || 0), 0);\n\n  const totalWonCount = filteredCards.filter((c) => c.phaseId === \'ganho\').length;\n  const totalLostCount = filteredCards.filter((c) => c.phaseId === \'perdido\').length;\n\n  const handleDragStart = (e: React.DragEvent, cardId: string) => {\n    e.dataTransfer.setData(\'text/plain\', cardId);\n    setDraggedCardId(cardId);\n  };\n\n  const handleDragOver = (e: React.DragEvent, phaseId: PhaseId) => {\n    e.preventDefault();\n    setDragOverPhaseId(phaseId);\n  };\n\n  const handleDragLeave = () => {\n    setDragOverPhaseId(null);\n  };\n\n  const handleDrop = (e: React.DragEvent, targetPhaseId: PhaseId) => {\n    e.preventDefault();\n    const cardId = e.dataTransfer.getData(\'text/plain\') || draggedCardId;\n    if (cardId) {\n      moveCardPhase(cardId, targetPhaseId);\n    }\n    setDraggedCardId(null);\n    setDragOverPhaseId(null);\n  };\n\n  const getPriorityBadge = (priority: Priority) => {\n    switch (priority) {\n      case \'urgente\':\n        return (\n          <span className=\"inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700\">\n            <Flame className=\"w-3 h-3\" /> Urgente\n          </span>\n        );\n      case \'alta\':\n        return <span className=\"px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-100 text-amber-800\">Alta</span>;\n      case \'media\':\n        return <span className=\"px-1.5 py-0.5 rounded text-[10px] font-semibold bg-blue-100 text-blue-800\">M\303\251dia</span>;\n      default:\n        return <span className=\"px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600\">Baixa</span>;\n    }\n  };\n\n  const getNextPhase = (currentPhaseId: PhaseId): PhaseId | null => {\n    const idx = phases.findIndex((p) => p.id === currentPhaseId);\n    if (idx >= 0 && idx < phases.length - 2) {\n      return phases[idx + 1].id;\n    }\n    return null;\n  };\n\n  return (\n    <div className=\"flex flex-col h-[calc(100vh-105px)] bg-slate-100/70 overflow-hidden\">\n      {/* Top Filter & Metric Ribbon */}\n      <div className=\"bg-white px-4 sm:px-6 py-2.5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3 shrink-0\">\n        {/* Quick Filter Selectors */}\n        <div className=\"flex items-center flex-wrap gap-2 text-xs\">\n          <div className=\"flex items-center gap-1.5 text-slate-500 font-medium mr-1\">\n            <Filter className=\"w-3.5 h-3.5\" />\n            <span>Filtros:</span>\n          </div>\n\n          {/* Consultant Filter */}\n          <select\n            id=\"filter-consultant-select\"\n            value={activeFilterConsultant}\n            onChange={(e) => setActiveFilterConsultant(e.target.value)}\n            className=\"px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 font-medium focus:ring-1 focus:ring-indigo-500 focus:outline-none\"\n          >\n            <option value=\"all\">\360\237\221\244 Todos os Consultores</option>\n            {users\n              .filter((u) => u.role === \'consultant\' || u.role === \'manager\')\n              .map((u) => (\n                <option key={u.id} value={u.id}>\n                  {u.name} ({u.role === \'manager\' ? \'Gerente\' : \'Consultor\'})\n                </option>\n              ))}\n          </select>\n\n          {/* Priority Filter */}\n          <select\n            id=\"filter-priority-select\"\n            value={activePriorityFilter}\n            onChange={(e) => setActivePriorityFilter(e.target.value)}\n            className=\"px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 font-medium focus:ring-1 focus:ring-indigo-500 focus:outline-none\"\n          >\n            <option value=\"all\">\342\232\241 Todas Prioridades</option>\n            <option value=\"urgente\">\360\237\224\245 Urgente</option>\n            <option value=\"alta\">Alta</option>\n            <option value=\"media\">M\303\251dia</option>\n            <option value=\"baixa\">Baixa</option>\n          </select>\n\n          {(activeFilterConsultant !== \'all\' || activePriorityFilter !== \'all\' || searchQuery) && (\n            <button\n              onClick={() => {\n                setActiveFilterConsultant(\'all\');\n                setActivePriorityFilter(\'all\');\n              }}\n              className=\"text-indigo-600 hover:text-indigo-800 font-medium text-xs ml-1 hover:underline\"\n            >\n              Resetar Filtros\n            </button>\n          )}\n        </div>\n\n        {/* Live Metrics Summary Ribbon */}\n        <div className=\"flex items-center gap-4 text-xs font-medium\">\n          <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg\">\n            <span className=\"text-slate-500\">Pipeline Ativo:</span>\n            <span className=\"font-bold text-indigo-700\">{formatCurrency(totalPipelineValue)}</span>\n          </div>\n\n          <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-800\">\n            <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n            <span>Fechados (Ganho):</span>\n            <span className=\"font-bold\">{formatCurrency(totalWonValue)} ({totalWonCount})</span>\n          </div>\n\n          <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 border border-slate-200 rounded-lg text-slate-600\">\n            <XCircle className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>Perdidos:</span>\n            <span className=\"font-bold\">{totalLostCount}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Horizontal Kanban Columns Container */}\n      <div className=\"flex-1 overflow-x-auto overflow-y-hidden p-4 sm:p-5 flex gap-3.5 items-start\">\n        {phases.map((phase) => {\n          const phaseCards = filteredCards.filter((c) => c.phaseId === phase.id);\n          const phaseTotalValue = phaseCards.reduce((acc, c) => acc + (c.value || 0), 0);\n          const isOver = dragOverPhaseId === phase.id;\n\n          return (\n            <div\n              key={phase.id}\n              id={`kanban-column-${phase.id}`}\n              onDragOver={(e) => handleDragOver(e, phase.id)}\n              onDragLeave={handleDragLeave}\n              onDrop={(e) => handleDrop(e, phase.id)}\n              className={`w-[295px] shrink-0 flex flex-col max-h-full rounded-xl border transition-all duration-150 ${\n                isOver\n                  ? \'border-indigo-400 bg-indigo-50/50 shadow-md ring-2 ring-indigo-300\'\n                  : \'border-slate-200/90 bg-white/85 shadow-2xs\'\n              }`}\n            >\n              {/* Column Header */}\n              <div className=\"p-3 border-b border-slate-100 bg-slate-50/60 rounded-t-xl\">\n                <div className=\"flex items-center justify-between gap-1.5 mb-1.5\">\n                  <div className=\"flex items-center gap-2 min-w-0\">\n                    <span className={`w-2.5 h-2.5 rounded-full ${phase.color.replace(\'text-\', \'bg-\')}`} />\n                    <h3 className=\"font-bold text-xs text-slate-800 tracking-tight truncate\">{phase.name}</h3>\n                  </div>\n\n                  <span className=\"px-1.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-200 text-slate-700\">\n                    {phaseCards.length}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center justify-between text-[11px] text-slate-500\">\n                  <span className=\"font-semibold text-slate-700\">{formatCurrency(phaseTotalValue)}</span>\n                  {phase.slaHours > 0 ? (\n                    <span className=\"flex items-center gap-1 text-[10px] text-slate-400\">\n                      <Clock className=\"w-3 h-3\" /> SLA: {phase.slaHours}h\n                    </span>\n                  ) : (\n                    <span className=\"text-[10px] text-slate-400\">Fase Final</span>\n                  )}\n                </div>\n              </div>\n\n              {/* Card List in Column */}\n              <div className=\"flex-1 overflow-y-auto p-2.5 space-y-2.5 custom-scrollbar min-h-[140px]\">\n                {phaseCards.map((card) => {\n                  const assignedUser = userMap.get(card.assignedUserId);\n                  const sla = getSLAStatus(card.enteredCurrentPhaseAt, phase.slaHours);\n                  const completedTasks = card.checklist.filter((i) => i.completed).length;\n                  const nextPhase = getNextPhase(card.phaseId);\n\n                  return (\n                    <div\n                      key={card.id}\n                      id={`card-${card.id}`}\n                      draggable\n                      onDragStart={(e) => handleDragStart(e, card.id)}\n                      onClick={() => setSelectedCard(card)}\n                      className=\"group p-3 bg-white border border-slate-200/90 hover:border-indigo-300 rounded-xl shadow-2xs hover:shadow-md transition-all cursor-pointer relative\"\n                    >\n                      {/* Card Top: ID & Priority */}\n                      <div className=\"flex items-center justify-between gap-1.5 mb-1.5\">\n                        <span className=\"text-[10px] font-bold font-mono text-slate-400 tracking-wider\">\n                          {card.id}\n                        </span>\n                        <div className=\"flex items-center gap-1\">\n                          {getPriorityBadge(card.priority)}\n                        </div>\n                      </div>\n\n                      {/* Card Title & Company */}\n                      <h4 className=\"font-bold text-xs text-slate-900 line-clamp-1 group-hover:text-indigo-600 transition-colors\">\n                        {card.title}\n                      </h4>\n                      <p className=\"text-[11px] font-medium text-slate-600 truncate mt-0.5\">\n                        \360\237\217\242 {card.companyName}\n                      </p>\n\n                      {/* Phase-Specific Highlight (Pipefy Custom Questions preview) */}\n                      {phase.id === \'mapeados\' && (\n                        <div className=\"mt-2 p-1.5 bg-indigo-50/60 rounded-md text-[10px] text-indigo-900 border border-indigo-100\">\n                          <span className=\"font-semibold\">Canal:</span> {card.customFields?.canalProspeccao || \'N\303\243o informado\'}\n                        </div>\n                      )}\n\n                      {phase.id === \'diagnostica\' && card.customFields?.doresIdentificadas && (\n                        <div className=\"mt-2 p-1.5 bg-cyan-50/60 rounded-md text-[10px] text-cyan-900 border border-cyan-100 line-clamp-2\">\n                          <span className=\"font-semibold\">Dor:</span> {card.customFields.doresIdentificadas}\n                        </div>\n                      )}\n\n                      {phase.id === \'proposta\' && card.customFields?.valorProposta && (\n                        <div className=\"mt-2 p-1.5 bg-amber-50/60 rounded-md text-[10px] text-amber-900 border border-amber-100\">\n                          <span className=\"font-semibold\">Proposta:</span> {formatCurrency(card.customFields.valorProposta)}\n                        </div>\n                      )}\n\n                      {phase.id.startsWith(\'followup_\') && (\n                        <div className=\"mt-2 p-1.5 bg-yellow-50/60 rounded-md text-[10px] text-yellow-900 border border-yellow-200\">\n                          <span className=\"font-semibold\">Contato:</span>{\' \'}\n                          {card.customFields?.[`${phase.id.replace(\'_\', \'\')}Canal`] || \'WhatsApp / Call\'} -{\' \'}\n                          {card.customFields?.[`${phase.id.replace(\'_\', \'\')}Status`] || \'Aguardando\'}\n                        </div>\n                      )}\n\n                      {phase.id === \'perdido\' && card.customFields?.motivoPerda && (\n                        <div className=\"mt-2 p-1.5 bg-slate-100 rounded-md text-[10px] text-rose-700 border border-slate-200\">\n                          <span className=\"font-semibold\">Motivo:</span> {card.customFields.motivoPerda}\n                        </div>\n                      )}\n\n                      {/* Card Value & SLA Badge */}\n                      <div className=\"mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]\">\n                        <span className=\"font-bold text-slate-800\">\n                          {card.value > 0 ? formatCurrency(card.value) : \'A definir\'}\n                        </span>\n\n                        {phase.slaHours > 0 && (\n                          <span\n                            className={`inline-flex items-center gap-1 text-[10px] font-medium px-1.5 py-0.5 rounded ${\n                              sla.isOverdue\n                                ? \'bg-rose-100 text-rose-700 font-bold\'\n                                : \'bg-slate-100 text-slate-600\'\n                            }`}\n                          >\n                            <Clock className=\"w-2.5 h-2.5\" />\n                            {sla.label}\n                          </span>\n                        )}\n                      </div>\n\n                      {/* Card Footer: Checklist, WhatsApp & Assigned Avatar */}\n                      <div className=\"mt-2 flex items-center justify-between gap-1 text-[10px] text-slate-500\">\n                        <div className=\"flex items-center gap-2\">\n                          {card.checklist.length > 0 && (\n                            <span className=\"flex items-center gap-1 text-slate-500\">\n                              <CheckSquare className=\"w-3 h-3 text-slate-400\" />\n                              {completedTasks}/{card.checklist.length}\n                            </span>\n                          )}\n\n                          {card.messages.length > 0 && (\n                            <span className=\"flex items-center gap-1 text-slate-500\">\n                              <MessageSquare className=\"w-3 h-3 text-slate-400\" />\n                              {card.messages.length}\n                            </span>\n                          )}\n                        </div>\n\n                        <div className=\"flex items-center gap-1.5\">\n                          {/* Quick WhatsApp Link */}\n                          {card.contactPhone && (\n                            <a\n                              href={getWhatsAppDirectUrl(card.contactPhone, `Ol\303\241 ${card.contactName}, tudo bem? Sou da equipe PipeCRM.`)}\n                              target=\"_blank\"\n                              rel=\"noreferrer\"\n                              onClick={(e) => e.stopPropagation()}\n                              title=\"Conversar no WhatsApp\"\n                              className=\"p-1 hover:bg-emerald-50 text-emerald-600 rounded\"\n                            >\n                              <Phone className=\"w-3 h-3\" />\n                            </a>\n                          )}\n\n                          {/* Quick Next Phase Advance Button */}\n                          {nextPhase && (\n                            <button\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                moveCardPhase(card.id, nextPhase);\n                              }}\n                              title={`Avan\303\247ar para ${nextPhase}`}\n                              className=\"p-1 hover:bg-indigo-50 text-slate-400 hover:text-indigo-600 rounded transition-colors\"\n                            >\n                              <ChevronRight className=\"w-3.5 h-3.5\" />\n                            </button>\n                          )}\n\n                          {/* Assigned User Avatar */}\n                          {assignedUser && (\n                            <img\n                              src={assignedUser.avatar}\n                              alt={assignedUser.name}\n                              title={`Respons\303\241vel: ${assignedUser.name}`}\n                              className=\"w-5 h-5 rounded-full object-cover ring-1 ring-slate-200\"\n                            />\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n\n                {phaseCards.length === 0 && (\n                  <div className=\"p-4 border-2 border-dashed border-slate-200/80 rounded-xl text-center\">\n                    <p className=\"text-[11px] text-slate-400\">Nenhum card nesta fase</p>\n                    <button\n                      onClick={() => openNewCardModal(phase.id)}\n                      className=\"mt-1 text-[10px] text-indigo-600 hover:underline font-medium\"\n                    >\n                      + Criar Card\n                    </button>\n                  </div>\n                )}\n              </div>\n\n              {/* Column Footer: Quick Add Button */}\n              <div className=\"p-2 border-t border-slate-100 bg-slate-50/40 rounded-b-xl\">\n                <button\n                  id={`btn-add-card-phase-${phase.id}`}\n                  onClick={() => openNewCardModal(phase.id)}\n                  className=\"w-full flex items-center justify-center gap-1 py-1.5 text-xs text-slate-600 hover:text-indigo-600 hover:bg-indigo-50/60 rounded-lg transition-colors font-medium cursor-pointer\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" />\n                  <span>Novo Card</span>\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
