        lines {
          text: "                  // Message counts"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  const totalMessages = userCards.reduce((acc, c) => acc + c.messages.length, 0);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  const percentAchieved ="
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    user.monthlyGoalValue > 0"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      ? Math.min(100, (userWonSum / user.monthlyGoalValue) * 100)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
