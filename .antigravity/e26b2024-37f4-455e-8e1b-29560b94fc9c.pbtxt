    instruction: "Update DashboardView with QuaraCRM dark/light theming and brand red colors"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"p-4 sm:p-6 space-y-6 max-w-7xl mx-auto\">\n      {/* Top Banner & Export */}\n      <div className=\"flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-slate-200\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900\">Painel de M\303\251tricas & Produtividade</h2>\n          <p className=\"text-xs text-slate-500\">\n            Acompanhamento em tempo real do pipeline, metas individuais e performance por consultor\n          </p>\n        </div>\n\n        <button\n          onClick={() => exportConsultantReportToCSV(users, cards)}\n          className=\"flex items-center gap-1.5 px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n        >\n          <Download className=\"w-4 h-4\" />\n          <span>Exportar Relat\303\263rio de Consultores (CSV)</span>\n        </button>\n      </div>\n\n      {/* KPI Cards Grid */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Active Pipeline */}\n        <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Pipeline em Aberto</span>\n            <div className=\"p-2 bg-indigo-50 text-indigo-600 rounded-lg\">\n              <DollarSign className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-slate-900\">{formatCurrency(totalActiveValue)}</div>\n          <p className=\"text-xs text-slate-500 mt-1 font-medium\">{activeCards.length} negocia\303\247\303\265es em andamento</p>\n        </div>\n\n        {/* Won Deals Total */}\n        <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Fechamento Ganho</span>\n            <div className=\"p-2 bg-emerald-50 text-emerald-600 rounded-lg\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-emerald-700\">{formatCurrency(totalWonValue)}</div>\n          <p className=\"text-xs text-emerald-600 mt-1 font-semibold\">{wonCards.length} contratos assinados no m\303\252s</p>\n        </div>\n\n        {/* Conversion Rate */}\n        <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Taxa de Convers\303\243o</span>\n            <div className=\"p-2 bg-purple-50 text-purple-600 rounded-lg\">\n              <TrendingUp className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-slate-900\">{overallConversionRate}%</div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Ticket M\303\251dio: <strong className=\"text-slate-700\">{formatCurrency(averageTicket)}</strong>\n          </p>\n        </div>\n\n        {/* Team Goal Progress */}\n        <div className=\"p-4 bg-white rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Meta Geral da Equipe</span>\n            <div className=\"p-2 bg-amber-50 text-amber-600 rounded-lg\">\n              <Target className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-slate-900\">{teamGoalPercent}%</div>\n          <div className=\"w-full bg-slate-100 rounded-full h-2 mt-2 overflow-hidden\">\n            <div\n              className=\"bg-amber-500 h-full rounded-full transition-all duration-500\"\n              style={{ width: `${Math.min(100, parseFloat(teamGoalPercent))}%` }}\n            />\n          </div>\n          <p className=\"text-[11px] text-slate-400 mt-1\">\n            {formatCurrency(totalWonValue)} de {formatCurrency(totalTeamGoal)}\n          </p>\n        </div>\n      </div>\n\n      {/* Consultant Productivity Table & Goals */}\n      <div className=\"bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden\">\n        <div className=\"p-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between\">\n          <div>\n            <h3 className=\"font-bold text-sm text-slate-800\">Desempenho & Metas Individuais por Consultor</h3>\n            <p className=\"text-xs text-slate-500\">Volume de leads, taxa de fechamento e atingimento da meta mensal</p>\n          </div>\n          <span className=\"text-xs text-indigo-600 font-semibold flex items-center gap-1\">\n            <Award className=\"w-4 h-4\" /> Ranking em Tempo Real\n          </span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead className=\"bg-slate-100/60 text-slate-500 font-bold uppercase text-[10px] border-b border-slate-200\">\n              <tr>\n                <th className=\"p-3.5\">Consultor</th>\n                <th className=\"p-3.5\">Leads Ativos</th>\n                <th className=\"p-3.5\">Contatos (WhatsApp / E-mail)</th>\n                <th className=\"p-3.5\">Fechados (Ganho)</th>\n                <th className=\"p-3.5\">Valor Fechado R$</th>\n                <th className=\"p-3.5\">Meta Individual R$</th>\n                <th className=\"p-3.5 min-w-[140px]\">% Atingido</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {users\n                .filter((u) => u.role === \'consultant\' || u.role === \'manager\')\n                .map((user) => {\n                  const userCards = cards.filter((c) => c.assignedUserId === user.id);\n                  const userWon = userCards.filter((c) => c.phaseId === \'ganho\');\n                  const userWonSum = userWon.reduce((acc, c) => acc + (c.value || 0), 0);\n                  const userActive = userCards.filter((c) => c.phaseId !== \'ganho\' && c.phaseId !== \'perdido\');\n\n                  // Message counts\n                  const totalMessages = userCards.reduce((acc, c) => acc + c.messages.length, 0);\n\n                  const percentAchieved =\n                    user.monthlyGoalValue > 0\n                      ? Math.min(100, (userWonSum / user.monthlyGoalValue) * 100)\n                      : 0;\n\n                  return (\n                    <tr key={user.id} className=\"hover:bg-slate-50/80 transition-colors\">\n                      <td className=\"p-3.5\">\n                        <div className=\"flex items-center gap-2.5\">\n                          <img src={user.avatar} alt={user.name} className=\"w-8 h-8 rounded-full object-cover\" />\n                          <div>\n                            <div className=\"font-bold text-slate-900\">{user.name}</div>\n                            <div className=\"text-[10px] text-slate-400\">{user.department}</div>\n                          </div>\n                        </div>\n                      </td>\n                      <td className=\"p-3.5 font-semibold text-slate-800\">{userActive.length}</td>\n                      <td className=\"p-3.5\">\n                        <span className=\"inline-flex items-center gap-1 font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded\">\n                          <MessageSquare className=\"w-3 h-3 text-emerald-600\" />\n                          {totalMessages} intera\303\247\303\265es\n                        </span>\n                      </td>\n                      <td className=\"p-3.5\">\n                        <span className=\"font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded\">\n                          {userWon.length} / {user.monthlyGoalLeads || 5}\n                        </span>\n                      </td>\n                      <td className=\"p-3.5 font-bold text-slate-900\">{formatCurrency(userWonSum)}</td>\n                      <td className=\"p-3.5 text-slate-600 font-semibold\">{formatCurrency(user.monthlyGoalValue)}</td>\n                      <td className=\"p-3.5\">\n                        <div className=\"space-y-1\">\n                          <div className=\"flex items-center justify-between text-[11px] font-bold\">\n                            <span className={percentAchieved >= 80 ? \'text-emerald-700\' : \'text-indigo-600\'}>\n                              {percentAchieved.toFixed(1)}%\n                            </span>\n                          </div>\n                          <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                            <div\n                              className={`h-full rounded-full transition-all ${\n                                percentAchieved >= 100\n                                  ? \'bg-emerald-500\'\n                                  : percentAchieved >= 60\n                                  ? \'bg-indigo-600\'\n                                  : \'bg-amber-500\'\n                              }`}\n                              style={{ width: `${percentAchieved}%` }}\n                            />\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                  );\n                })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Pipeline Funnel by Phase Breakdown */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Phase Breakdown List */}\n        <div className=\"lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-2xs p-5\">\n          <h3 className=\"font-bold text-sm text-slate-800 mb-4\">Volume e Convers\303\243o por Fase do Fluxo</h3>\n\n          <div className=\"space-y-2.5\">\n            {phases.map((phase) => {\n              const phaseCards = cards.filter((c) => c.phaseId === phase.id);\n              const phaseVal = phaseCards.reduce((acc, c) => acc + (c.value || 0), 0);\n              const percentOfTotal = cards.length > 0 ? (phaseCards.length / cards.length) * 100 : 0;\n\n              return (\n                <div key={phase.id} className=\"p-2.5 bg-slate-50/70 rounded-lg border border-slate-100\">\n                  <div className=\"flex items-center justify-between text-xs mb-1\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className={`w-2.5 h-2.5 rounded-full ${phase.color.replace(\'text-\', \'bg-\')}`} />\n                      <span className=\"font-bold text-slate-800\">{phase.name}</span>\n                    </div>\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"font-bold text-slate-900\">{formatCurrency(phaseVal)}</span>\n                      <span className=\"px-2 py-0.5 bg-white text-slate-700 border border-slate-200 rounded font-mono font-bold text-[10px]\">\n                        {phaseCards.length} leads\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"w-full bg-slate-200/70 rounded-full h-1.5 overflow-hidden\">\n                    <div\n                      className={`h-full ${phase.color.replace(\'text-\', \'bg-\')}`}\n                      style={{ width: `${Math.max(5, percentOfTotal)}%` }}\n                    />\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Lost Deals Reasons Breakdown */}\n        <div className=\"bg-white rounded-xl border border-slate-200 shadow-2xs p-5 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between mb-4\">\n              <h3 className=\"font-bold text-sm text-slate-800\">Motivos de Perda (Disqualify)</h3>\n              <span className=\"text-xs text-rose-600 font-bold\">{lostCards.length} Perdidos</span>\n            </div>\n\n            <div className=\"space-y-2\">\n              {Object.entries(lostReasonsMap).map(([reason, count]) => {\n                const pct = lostCards.length > 0 ? Math.round((count / lostCards.length) * 100) : 0;\n                return (\n                  <div key={reason} className=\"p-2.5 bg-rose-50/50 border border-rose-100 rounded-lg\">\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-800\">{reason}</span>\n                      <span className=\"font-bold text-rose-700\">\n                        {count} ({pct}%)\n                      </span>\n                    </div>\n                    <div className=\"w-full bg-rose-200/50 rounded-full h-1.5 overflow-hidden\">\n                      <div className=\"bg-rose-500 h-full\" style={{ width: `${pct}%` }} />\n                    </div>\n                  </div>\n                );\n              })}\n\n              {lostCards.length === 0 && (\n                <p className=\"text-xs text-slate-400 text-center py-6\">Nenhum card perdido no per\303\255odo.</p>\n              )}\n            </div>\n          </div>\n\n          <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl mt-4 text-[11px] text-slate-600\">\n            \360\237\222\241 <strong>Insight Autom\303\241tico:</strong> A maior causa de perdas \303\251{\' \'}\n            <span className=\"font-semibold text-rose-700\">\"Sem or\303\247amento atual\"</span>. Considere oferecer planos\n            fracionados no diagn\303\263stico.\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"p-4 sm:p-6 space-y-6 max-w-7xl mx-auto\">\n      {/* Top Banner & Export */}\n      <div className=\"flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-neutral-200 dark:border-neutral-800\">\n        <div>\n          <h2 className=\"text-lg font-bold text-neutral-900 dark:text-neutral-100\">Painel de M\303\251tricas & Produtividade</h2>\n          <p className=\"text-xs text-neutral-500 dark:text-neutral-400\">\n            Acompanhamento em tempo real do pipeline, metas individuais e performance por consultor\n          </p>\n        </div>\n\n        <button\n          onClick={() => exportConsultantReportToCSV(users, cards)}\n          className=\"flex items-center gap-1.5 px-3.5 py-2 bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-800 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer\"\n        >\n          <Download className=\"w-4 h-4\" />\n          <span>Exportar Relat\303\263rio de Consultores (CSV)</span>\n        </button>\n      </div>\n\n      {/* KPI Cards Grid */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Active Pipeline */}\n        <div className=\"p-4 bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider\">Pipeline em Aberto</span>\n            <div className=\"p-2 bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 rounded-lg\">\n              <DollarSign className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-neutral-900 dark:text-neutral-100\">{formatCurrency(totalActiveValue)}</div>\n          <p className=\"text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-medium\">{activeCards.length} negocia\303\247\303\265es em andamento</p>\n        </div>\n\n        {/* Won Deals Total */}\n        <div className=\"p-4 bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider\">Fechamento Ganho</span>\n            <div className=\"p-2 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 rounded-lg\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-emerald-600 dark:text-emerald-400\">{formatCurrency(totalWonValue)}</div>\n          <p className=\"text-xs text-emerald-600 dark:text-emerald-500 mt-1 font-semibold\">{wonCards.length} contratos assinados no m\303\252s</p>\n        </div>\n\n        {/* Conversion Rate */}\n        <div className=\"p-4 bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider\">Taxa de Convers\303\243o</span>\n            <div className=\"p-2 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 rounded-lg\">\n              <TrendingUp className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-neutral-900 dark:text-neutral-100\">{overallConversionRate}%</div>\n          <p className=\"text-xs text-neutral-500 dark:text-neutral-400 mt-1\">\n            Ticket M\303\251dio: <strong className=\"text-neutral-700 dark:text-neutral-200\">{formatCurrency(averageTicket)}</strong>\n          </p>\n        </div>\n\n        {/* Team Goal Progress */}\n        <div className=\"p-4 bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-2xs\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-bold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider\">Meta Geral da Equipe</span>\n            <div className=\"p-2 bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 rounded-lg\">\n              <Target className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-xl font-bold text-neutral-900 dark:text-neutral-100\">{teamGoalPercent}%</div>\n          <div className=\"w-full bg-neutral-100 dark:bg-neutral-800 rounded-full h-2 mt-2 overflow-hidden\">\n            <div\n              className=\"bg-red-600 dark:bg-red-500 h-full rounded-full transition-all duration-500\"\n              style={{ width: `${Math.min(100, parseFloat(teamGoalPercent))}%` }}\n            />\n          </div>\n          <p className=\"text-[11px] text-neutral-400 dark:text-neutral-500 mt-1\">\n            {formatCurrency(totalWonValue)} de {formatCurrency(totalTeamGoal)}\n          </p>\n        </div>\n      </div>\n\n      {/* Consultant Productivity Table & Goals */}\n      <div className=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-2xs overflow-hidden\">\n        <div className=\"p-4 border-b border-neutral-100 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 flex items-center justify-between\">\n          <div>\n            <h3 className=\"font-bold text-sm text-neutral-900 dark:text-neutral-100\">Desempenho & Metas Individuais por Consultor</h3>\n            <p className=\"text-xs text-neutral-500 dark:text-neutral-400\">Volume de leads, taxa de fechamento e atingimento da meta mensal</p>\n          </div>\n          <span className=\"text-xs text-red-600 dark:text-red-400 font-semibold flex items-center gap-1\">\n            <Award className=\"w-4 h-4\" /> Ranking em Tempo Real\n          </span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead className=\"bg-neutral-100/60 dark:bg-neutral-950 text-neutral-500 dark:text-neutral-400 font-bold uppercase text-[10px] border-b border-neutral-200 dark:border-neutral-800\">\n              <tr>\n                <th className=\"p-3.5\">Consultor</th>\n                <th className=\"p-3.5\">Leads Ativos</th>\n                <th className=\"p-3.5\">Contatos (WhatsApp / E-mail)</th>\n                <th className=\"p-3.5\">Fechados (Ganho)</th>\n                <th className=\"p-3.5\">Valor Fechado R$</th>\n                <th className=\"p-3.5\">Meta Individual R$</th>\n                <th className=\"p-3.5 min-w-[140px]\">% Atingido</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-neutral-100 dark:divide-neutral-800 text-neutral-700 dark:text-neutral-300\">\n              {users\n                .filter((u) => u.role === \'consultant\' || u.role === \'manager\')\n                .map((user) => {\n                  const userCards = cards.filter((c) => c.assignedUserId === user.id);\n                  const userWon = userCards.filter((c) => c.phaseId === \'ganho\');\n                  const userWonSum = userWon.reduce((acc, c) => acc + (c.value || 0), 0);\n                  const userActive = userCards.filter((c) => c.phaseId !== \'ganho\' && c.phaseId !== \'perdido\');\n\n                  // Message counts\n                  const totalMessages = userCards.reduce((acc, c) => acc + c.messages.length, 0);\n\n                  const percentAchieved =\n                    user.monthlyGoalValue > 0\n                      ? Math.min(100, (userWonSum / user.monthlyGoalValue) * 100)\n                      : 0;\n\n                  return (\n                    <tr key={user.id} className=\"hover:bg-neutral-50/80 dark:hover:bg-neutral-850/60 transition-colors\">\n                      <td className=\"p-3.5\">\n                        <div className=\"flex items-center gap-2.5\">\n                          <img src={user.avatar} alt={user.name} className=\"w-8 h-8 rounded-full object-cover\" />\n                          <div>\n                            <div className=\"font-bold text-neutral-900 dark:text-neutral-100\">{user.name}</div>\n                            <div className=\"text-[10px] text-neutral-400 dark:text-neutral-500\">{user.department}</div>\n                          </div>\n                        </div>\n                      </td>\n                      <td className=\"p-3.5 font-semibold text-neutral-800 dark:text-neutral-200\">{userActive.length}</td>\n                      <td className=\"p-3.5\">\n                        <span className=\"inline-flex items-center gap-1 font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\">\n                          <MessageSquare className=\"w-3 h-3 text-emerald-600 dark:text-emerald-400\" />\n                          {totalMessages} intera\303\247\303\265es\n                        </span>\n                      </td>\n                      <td className=\"p-3.5\">\n                        <span className=\"font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded\">\n                          {userWon.length} / {user.monthlyGoalLeads || 5}\n                        </span>\n                      </td>\n                      <td className=\"p-3.5 font-bold text-neutral-900 dark:text-neutral-100\">{formatCurrency(userWonSum)}</td>\n                      <td className=\"p-3.5 text-neutral-600 dark:text-neutral-400 font-semibold\">{formatCurrency(user.monthlyGoalValue)}</td>\n                      <td className=\"p-3.5\">\n                        <div className=\"space-y-1\">\n                          <div className=\"flex items-center justify-between text-[11px] font-bold\">\n                            <span className={percentAchieved >= 80 ? \'text-emerald-600 dark:text-emerald-400\' : \'text-red-600 dark:text-red-400\'}>\n                              {percentAchieved.toFixed(1)}%\n                            </span>\n                          </div>\n                          <div className=\"w-full bg-neutral-100 dark:bg-neutral-800 rounded-full h-2 overflow-hidden\">\n                            <div\n                              className={`h-full rounded-full transition-all ${\n                                percentAchieved >= 100\n                                  ? \'bg-emerald-500\'\n                                  : percentAchieved >= 60\n                                  ? \'bg-red-600 dark:bg-red-500\'\n                                  : \'bg-amber-500\'\n                              }`}\n                              style={{ width: `${percentAchieved}%` }}\n                            />\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                  );\n                })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Pipeline Funnel by Phase Breakdown */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Phase Breakdown List */}\n        <div className=\"lg:col-span-2 bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-2xs p-5\">\n          <h3 className=\"font-bold text-sm text-neutral-900 dark:text-neutral-100 mb-4\">Volume e Convers\303\243o por Fase do Fluxo</h3>\n\n          <div className=\"space-y-2.5\">\n            {phases.map((phase) => {\n              const phaseCards = cards.filter((c) => c.phaseId === phase.id);\n              const phaseVal = phaseCards.reduce((acc, c) => acc + (c.value || 0), 0);\n              const percentOfTotal = cards.length > 0 ? (phaseCards.length / cards.length) * 100 : 0;\n\n              return (\n                <div key={phase.id} className=\"p-2.5 bg-neutral-50/70 dark:bg-neutral-950/60 rounded-lg border border-neutral-100 dark:border-neutral-800\">\n                  <div className=\"flex items-center justify-between text-xs mb-1\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className={`w-2.5 h-2.5 rounded-full ${phase.color.replace(\'text-\', \'bg-\')}`} />\n                      <span className=\"font-bold text-neutral-800 dark:text-neutral-200\">{phase.name}</span>\n                    </div>\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"font-bold text-neutral-900 dark:text-neutral-100\">{formatCurrency(phaseVal)}</span>\n                      <span className=\"px-2 py-0.5 bg-white dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700 rounded font-mono font-bold text-[10px]\">\n                        {phaseCards.length} leads\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"w-full bg-neutral-200/70 dark:bg-neutral-800 rounded-full h-1.5 overflow-hidden\">\n                    <div\n                      className={`h-full ${phase.color.replace(\'text-\', \'bg-\')}`}\n                      style={{ width: `${Math.max(5, percentOfTotal)}%` }}\n                    />\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Lost Deals Reasons Breakdown */}\n        <div className=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-2xs p-5 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between mb-4\">\n              <h3 className=\"font-bold text-sm text-neutral-900 dark:text-neutral-100\">Motivos de Perda (Disqualify)</h3>\n              <span className=\"text-xs text-red-600 dark:text-red-400 font-bold\">{lostCards.length} Perdidos</span>\n            </div>\n\n            <div className=\"space-y-2\">\n              {Object.entries(lostReasonsMap).map(([reason, count]) => {\n                const pct = lostCards.length > 0 ? Math.round((count / lostCards.length) * 100) : 0;\n                return (\n                  <div key={reason} className=\"p-2.5 bg-red-50/50 dark:bg-red-950/20 border border-red-100 dark:border-red-900/30 rounded-lg\">\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-neutral-800 dark:text-neutral-200\">{reason}</span>\n                      <span className=\"font-bold text-red-700 dark:text-red-400\">\n                        {count} ({pct}%)\n                      </span>\n                    </div>\n                    <div className=\"w-full bg-red-200/50 dark:bg-red-950/50 rounded-full h-1.5 overflow-hidden\">\n                      <div className=\"bg-red-500 h-full\" style={{ width: `${pct}%` }} />\n                    </div>\n                  </div>\n                );\n              })}\n\n              {lostCards.length === 0 && (\n                <p className=\"text-xs text-neutral-400 dark:text-neutral-500 text-center py-6\">Nenhum card perdido no per\303\255odo.</p>\n              )}\n            </div>\n          </div>\n\n          <div className=\"p-3 bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl mt-4 text-[11px] text-neutral-600 dark:text-neutral-400\">\n            \360\237\222\241 <strong>Insight Autom\303\241tico:</strong> A maior causa de perdas \303\251{\' \'}\n            <span className=\"font-semibold text-red-600 dark:text-red-400\">\"Sem or\303\247amento atual\"</span>. Considere oferecer planos\n            fracionados no diagn\303\263stico.\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
