    replacement_chunks {
      target_content: "        {/* Phase Bar / Fast Advancement */}\n        <div className=\"bg-slate-800/90 px-6 py-2.5 border-b border-slate-700 flex items-center justify-between text-xs text-slate-300 overflow-x-auto gap-4\">\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <span className=\"font-semibold text-slate-400\">Fase Atual:</span>\n            <select\n              value={selectedCard.phaseId}\n              onChange={(e) => requestPhaseTransition(selectedCard, e.target.value as PhaseId)}\n              className=\"bg-slate-900 text-white font-bold px-3 py-1 rounded-lg border border-slate-700 focus:outline-none focus:border-indigo-500 cursor-pointer\"\n            >\n              {phases.map((p) => (\n                <option key={p.id} value={p.id}>\n                  {p.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <UserIcon className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>Consultor:</span>\n              <select\n                value={selectedCard.assignedUserId}\n                onChange={(e) => updateCard(selectedCard.id, { assignedUserId: e.target.value })}\n                className=\"bg-slate-900 text-white px-2 py-0.5 rounded border border-slate-700 text-xs focus:outline-none\"\n              >\n                {users.map((u) => (\n                  <option key={u.id} value={u.id}>\n                    {u.name}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <DollarSign className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Valor:</span>\n              <input\n                type=\"number\"\n                value={selectedCard.value}\n                onChange={(e) => updateCard(selectedCard.id, { value: parseFloat(e.target.value) || 0 })}\n                className=\"w-24 bg-slate-900 text-white px-2 py-0.5 rounded border border-slate-700 text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n\n            <div className=\"flex items-center gap-1 text-[11px]\">\n              <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>SLA:</span>\n              <span className={`px-1.5 py-0.5 rounded font-bold ${sla.isOverdue ? \'bg-rose-500/20 text-rose-300\' : \'bg-emerald-500/20 text-emerald-300\'}`}>\n                {sla.hoursElapsed}h / {currentPhase.slaHours}h\n              </span>\n            </div>\n          </div>\n        </div>"
      replacement_content: "        {/* Interactive Pipeline Stepper / Fast Phase Transition */}\n        <div className=\"bg-slate-900 px-6 py-2.5 border-b border-slate-800 flex items-center justify-between text-xs overflow-x-auto gap-4\">\n          <div className=\"flex items-center gap-1 overflow-x-auto py-1\">\n            <span className=\"text-[11px] font-bold text-slate-400 mr-2 uppercase tracking-wider shrink-0\">\n              Pipeline:\n            </span>\n            {phases.map((phase, idx) => {\n              const isCurrent = selectedCard.phaseId === phase.id;\n              const isWin = phase.id === \'ganho\';\n              const isLoss = phase.id === \'perdido\';\n\n              return (\n                <button\n                  key={phase.id}\n                  onClick={() => requestPhaseTransition(selectedCard, phase.id)}\n                  title={`Mover para ${phase.name}`}\n                  className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-all shrink-0 flex items-center gap-1.5 cursor-pointer ${\n                    isCurrent\n                      ? isWin\n                        ? \'bg-emerald-600 text-white shadow-xs ring-2 ring-emerald-400\'\n                        : isLoss\n                        ? \'bg-rose-600 text-white shadow-xs ring-2 ring-rose-400\'\n                        : \'bg-indigo-600 text-white shadow-xs ring-2 ring-indigo-400\'\n                      : \'bg-slate-800/80 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700/60\'\n                  }`}\n                >\n                  <span\n                    className={`w-1.5 h-1.5 rounded-full ${\n                      isCurrent ? \'bg-white\' : phase.color.replace(\'text-\', \'bg-\')\n                    }`}\n                  />\n                  <span>{phase.name}</span>\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <UserIcon className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span className=\"text-[11px]\">Consultor:</span>\n              <select\n                value={selectedCard.assignedUserId}\n                onChange={(e) => updateCard(selectedCard.id, { assignedUserId: e.target.value })}\n                className=\"bg-slate-800 text-white px-2 py-0.5 rounded border border-slate-700 text-xs focus:outline-none\"\n              >\n                {users.map((u) => (\n                  <option key={u.id} value={u.id}>\n                    {u.name}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div className=\"flex items-center gap-1.5 text-slate-300\">\n              <DollarSign className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span className=\"text-[11px]\">Valor:</span>\n              <input\n                type=\"number\"\n                value={selectedCard.value}\n                onChange={(e) => updateCard(selectedCard.id, { value: parseFloat(e.target.value) || 0 })}\n                className=\"w-24 bg-slate-800 text-white px-2 py-0.5 rounded border border-slate-700 text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n\n            <div className=\"flex items-center gap-1 text-[11px]\">\n              <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span className={`px-2 py-0.5 rounded font-bold ${sla.isOverdue ? \'bg-rose-500/20 text-rose-300\' : \'bg-emerald-500/20 text-emerald-300\'}`}>\n                {sla.hoursElapsed}h / {currentPhase.slaHours}h\n              </span>\n            </div>\n          </div>\n        </div>"
    }
