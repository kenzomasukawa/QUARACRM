        }
        lines {
          text: "                .map((user) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  const userCards = cards.filter((c) => c.assignedUserId === user.id);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  const userWon = userCards.filter((c) => c.phaseId === \'ganho\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  const userWonSum = userWon.reduce((acc, c) => acc + (c.value || 0), 0);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  const userActive = userCards.filter((c) => c.phaseId !== \'ganho\' && c.phaseId !== \'perdido\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
