  file_change {
    absolute_path_uri: "file:///src/components/ExportModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 animate-in fade-in duration-150\">\n      <div className=\"bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"px-5 py-3.5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600\">\n              <HardDrive className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"font-semibold text-sm text-slate-900 leading-tight\">Central de Dados & Backups</h3>\n              <p className=\"text-[11px] text-slate-500\">Mem\303\263ria local independente (localStorage)</p>\n            </div>\n          </div>\n          <button\n            onClick={() => setIsExportModalOpen(false)}\n            className=\"p-1.5 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-100 transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Tab Navigation */}\n        <div className=\"px-5 border-b border-slate-100 bg-white flex gap-1 overflow-x-auto no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'json\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'json\'\n                ? \'border-indigo-600 text-indigo-600 font-semibold\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <FileJson className=\"w-3.5 h-3.5\" />\n            <span>Backup JSON (Importar/Exportar)</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'desktop\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'desktop\'\n                ? \'border-indigo-600 text-indigo-600 font-semibold\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Monitor className=\"w-3.5 h-3.5 text-indigo-600\" />\n            <span>Instalar no Computador (Desktop)</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'csv\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'csv\'\n                ? \'border-indigo-600 text-indigo-600 font-semibold\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <FileSpreadsheet className=\"w-3.5 h-3.5\" />\n            <span>Planilhas Excel / CSV</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'reset\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'reset\'\n                ? \'border-indigo-600 text-indigo-600 font-semibold\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n            <span>Redefinir Base</span>\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-5 overflow-y-auto space-y-4 text-xs\">\n          {/* Notifications / Feedback */}\n          {importSuccessMsg && (\n            <div className=\"p-3 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center justify-between gap-2 text-emerald-800 animate-in fade-in\">\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                <span className=\"font-medium\">{importSuccessMsg}</span>\n              </div>\n              <button\n                onClick={() => setImportSuccessMsg(null)}\n                className=\"text-xs text-emerald-600 hover:text-emerald-900 font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n          )}\n\n          {importError && (\n            <div className=\"p-3 bg-rose-50 border border-rose-200 rounded-xl flex items-center justify-between gap-2 text-rose-800 animate-in fade-in\">\n              <div className=\"flex items-center gap-2\">\n                <AlertTriangle className=\"w-4 h-4 text-rose-600 shrink-0\" />\n                <span>{importError}</span>\n              </div>\n              <button\n                onClick={() => setImportError(null)}\n                className=\"text-xs text-rose-600 hover:text-rose-900 font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n          )}\n\n          {/* TAB 1: JSON BACKUP */}\n          {activeTab === \'json\' && (\n            <div className=\"space-y-4\">\n              {/* Info Pill */}\n              <div className=\"p-3 bg-slate-50 border border-slate-200/80 rounded-xl flex items-center justify-between gap-3 text-slate-600\">\n                <div className=\"flex items-center gap-2.5\">\n                  <div className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                  <span>\n                    Armazenado no navegador deste computador: <strong className=\"text-slate-800\">{cards.length} cards</strong> ({storageInfo.usedKB} KB usados)\n                  </span>\n                </div>\n                <span className=\"text-[10px] font-medium text-slate-400\">100% Offline / Privado</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n                {/* Export Card */}\n                <div className=\"p-4 bg-white border border-slate-200 rounded-xl flex flex-col justify-between hover:border-slate-300 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-indigo-600 mb-1.5\">\n                      <Download className=\"w-4 h-4\" />\n                      <h4 className=\"font-semibold text-slate-900 text-xs\">Exportar Backup JSON</h4>\n                    </div>\n                    <p className=\"text-[11px] text-slate-500 leading-relaxed\">\n                      Gere um arquivo <code className=\"bg-slate-100 px-1 py-0.5 rounded text-slate-700 font-mono\">.json</code> com todas as oportunidades, perguntas preenchidas, automa\303\247\303\265es e hist\303\263rico.\n                    </p>\n                  </div>\n\n                  <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between\">\n                    <span className=\"text-[10px] text-slate-400\">{cards.length} registros prontos</span>\n                    <button\n                      onClick={exportFullJSONBackup}\n                      className=\"px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium rounded-lg flex items-center gap-1.5 transition-colors cursor-pointer\"\n                    >\n                      <Download className=\"w-3.5 h-3.5\" />\n                      <span>Baixar JSON</span>\n                    </button>\n                  </div>\n                </div>\n\n                {/* Import Card */}\n                <div className=\"p-4 bg-white border border-slate-200 rounded-xl flex flex-col justify-between hover:border-slate-300 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-indigo-600 mb-1.5\">\n                      <Upload className=\"w-4 h-4\" />\n                      <h4 className=\"font-semibold text-slate-900 text-xs\">Importar Backup JSON</h4>\n                    </div>\n                    <p className=\"text-[11px] text-slate-500 leading-relaxed\">\n                      Carregue um arquivo salvo anteriormente para restaurar sua base neste ou em outro computador.\n                    </p>\n                  </div>\n\n                  <div className=\"mt-4 pt-3 border-t border-slate-100\">\n                    <input\n                      type=\"file\"\n                      ref={fileInputRef}\n                      accept=\".json\"\n                      onChange={handleFileChange}\n                      className=\"hidden\"\n                      id=\"json-file-input\"\n                    />\n                    <label\n                      htmlFor=\"json-file-input\"\n                      className=\"w-full py-1.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg flex items-center justify-center gap-1.5 cursor-pointer transition-colors text-xs\"\n                    >\n                      <Upload className=\"w-3.5 h-3.5\" />\n                      <span>{importFile ? importFile.name : \'Selecionar Arquivo .json\'}</span>\n                    </label>\n                  </div>\n                </div>\n              </div>\n\n              {/* Import Preview and Actions */}\n              {parsedData && importSummary && (\n                <div className=\"p-4 bg-indigo-50/50 border border-indigo-200 rounded-xl space-y-3 animate-in fade-in\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2 text-indigo-900 font-semibold\">\n                      <CheckCircle2 className=\"w-4 h-4 text-indigo-600\" />\n                      <span>Arquivo validado com sucesso</span>\n                    </div>\n                    {importSummary.exportedAt && (\n                      <span className=\"text-[10px] text-indigo-600\">\n                        Exportado em: {formatDate(importSummary.exportedAt)}\n                      </span>\n                    )}\n                  </div>\n\n                  {/* Summary Grid */}\n                  <div className=\"grid grid-cols-4 gap-2 text-center\">\n                    <div className=\"p-2 bg-white rounded-lg border border-indigo-100\">\n                      <div className=\"text-sm font-bold text-slate-900\">{importSummary.cardsCount}</div>\n                      <div className=\"text-[10px] text-slate-500\">Cards</div>\n                    </div>\n                    <div className=\"p-2 bg-white rounded-lg border border-indigo-100\">\n                      <div className=\"text-sm font-bold text-slate-900\">{importSummary.phasesCount}</div>\n                      <div className=\"text-[10px] text-slate-500\">Fases</div>\n                    </div>\n                    <div className=\"p-2 bg-white rounded-lg border border-indigo-100\">\n                      <div className=\"text-sm font-bold text-slate-900\">{importSummary.usersCount}</div>\n                      <div className=\"text-[10px] text-slate-500\">Usu\303\241rios</div>\n                    </div>\n                    <div className=\"p-2 bg-white rounded-lg border border-indigo-100\">\n                      <div className=\"text-sm font-bold text-slate-900\">{importSummary.automationsCount}</div>\n                      <div className=\"text-[10px] text-slate-500\">Regras</div>\n                    </div>\n                  </div>\n\n                  <p className=\"text-[11px] text-indigo-800\">\n                    Como deseja carregar estes dados no seu navegador?\n                  </p>\n\n                  <div className=\"flex flex-wrap items-center gap-2 pt-1\">\n                    <button\n                      onClick={() => handleExecuteImport(\'replace\')}\n                      className=\"px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg flex items-center gap-1.5 cursor-pointer shadow-xs transition-colors\"\n                    >\n                      <RefreshCw className=\"w-3.5 h-3.5\" />\n                      <span>Substituir Base Atual</span>\n                    </button>\n                    <button\n                      onClick={() => handleExecuteImport(\'merge\')}\n                      className=\"px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-medium rounded-lg flex items-center gap-1.5 cursor-pointer transition-colors\"\n                    >\n                      <Layers className=\"w-3.5 h-3.5\" />\n                      <span>Mesclar com Dados Atuais</span>\n                    </button>\n                    <button\n                      onClick={() => {\n                        setParsedData(null);\n                        setImportFile(null);\n                        setImportSummary(null);\n                        if (fileInputRef.current) fileInputRef.current.value = \'\';\n                      }}\n                      className=\"px-2.5 py-1.5 text-slate-500 hover:text-slate-700 text-xs ml-auto\"\n                    >\n                      Cancelar\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* TAB 2: CSV / SPREADSHEETS */}\n          {activeTab === \'csv\' && (\n            <div className=\"space-y-3\">\n              <p className=\"text-slate-500 text-xs\">\n                Exporte relat\303\263rios formatados em UTF-8 com suporte nativo ao Microsoft Excel e Google Sheets:\n              </p>\n\n              {/* Option 1 */}\n              <div className=\"p-3 bg-white border border-slate-200 rounded-xl flex items-center justify-between gap-3 hover:border-slate-300 transition-colors\">\n                <div>\n                  <h4 className=\"font-semibold text-slate-900\">Pipeline Completo de Oportunidades</h4>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                    Todos os {cards.length} cards com campos customizados das 12 fases (dores, propostas, follow-ups).\n                  </p>\n                </div>\n                <button\n                  onClick={() => exportCardsToCSV(cards, phases, users)}\n                  className=\"px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-medium rounded-lg flex items-center gap-1.5 shrink-0 cursor-pointer transition-colors\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>CSV</span>\n                </button>\n              </div>\n\n              {/* Option 2 */}\n              <div className=\"p-3 bg-white border border-slate-200 rounded-xl flex items-center justify-between gap-3 hover:border-slate-300 transition-colors\">\n                <div>\n                  <h4 className=\"font-semibold text-slate-900\">Produtividade & Metas dos Consultores</h4>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                    Metas mensais, volume realizado em R$, taxas de convers\303\243o e fechamentos por vendedor.\n                  </p>\n                </div>\n                <button\n                  onClick={() => exportConsultantReportToCSV(users, cards)}\n                  className=\"px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg flex items-center gap-1.5 shrink-0 cursor-pointer transition-colors\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>CSV</span>\n                </button>\n              </div>\n\n              {/* Option 3 */}\n              <div className=\"p-3 bg-white border border-slate-200 rounded-xl flex items-center justify-between gap-3 hover:border-slate-300 transition-colors\">\n                <div>\n                  <h4 className=\"font-semibold text-slate-900\">Trilha de Auditoria & Compliance</h4>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                    Hist\303\263rico de {auditLogs.length} logs com movimenta\303\247\303\265es, disparos e altera\303\247\303\265es.\n                  </p>\n                </div>\n                <button\n                  onClick={() => exportAuditLogsToCSV(auditLogs)}\n                  className=\"px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white font-medium rounded-lg flex items-center gap-1.5 shrink-0 cursor-pointer transition-colors\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>CSV</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* TAB: DESKTOP INSTALLATION & OFFLINE WORKSTATION */}\n          {activeTab === \'desktop\' && (\n            <div className=\"space-y-4\">\n              <div className=\"p-3.5 bg-indigo-50/70 border border-indigo-200 rounded-xl\">\n                <div className=\"flex items-center gap-2 text-indigo-900 font-bold mb-1\">\n                  <Monitor className=\"w-4 h-4 text-indigo-600 shrink-0\" />\n                  <span>Opera\303\247\303\243o 100% Local no Computador (Sem Servidor na Nuvem)</span>\n                </div>\n                <p className=\"text-[11px] text-indigo-800 leading-relaxed\">\n                  Este CRM foi desenvolvido com arquitetura <strong>Local-First</strong>. Cada membro da equipe pode usar em sua pr\303\263pria m\303\241quina, gravando seus dados no disco/navegador local com privacidade total.\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n                {/* Method 1: PWA Desktop App */}\n                <div className=\"p-4 bg-white border border-slate-200 rounded-xl flex flex-col justify-between hover:border-slate-300 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-slate-900 font-semibold mb-2\">\n                      <div className=\"w-6 h-6 rounded-md bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold\">1</div>\n                      <h4>Instalar como App no Desktop (PWA)</h4>\n                    </div>\n                    <p className=\"text-[11px] text-slate-600 leading-relaxed mb-3\">\n                      Abre como um aplicativo nativo na barra de tarefas do Windows ou Mac sem precisar de instaladores:\n                    </p>\n                    <ol className=\"list-decimal list-inside space-y-1 text-[11px] text-slate-500 font-normal\">\n                      <li>Abra no <strong>Chrome</strong> ou <strong>Edge</strong>.</li>\n                      <li>Clique no menu (3 pontinhos) no topo direito.</li>\n                      <li>Selecione <strong>\"Instalar PipeCRM...\"</strong> ou <strong>\"Criar atalho\"</strong> marcando <em>\"Abrir como janela\"</em>.</li>\n                    </ol>\n                  </div>\n                  <div className=\"mt-3 pt-2.5 border-t border-slate-100 text-[10px] text-emerald-700 font-medium flex items-center gap-1\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5\" /> Recomendado para o dia a dia\n                  </div>\n                </div>\n\n                {/* Method 2: Offline Folder / Code Export */}\n                <div className=\"p-4 bg-white border border-slate-200 rounded-xl flex flex-col justify-between hover:border-slate-300 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-slate-900 font-semibold mb-2\">\n                      <div className=\"w-6 h-6 rounded-md bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold\">2</div>\n                      <h4>Rodar Offline na M\303\241quina (ZIP / Local)</h4>\n                    </div>\n                    <p className=\"text-[11px] text-slate-600 leading-relaxed mb-3\">\n                      Para executar 100% offline em redes corporativas fechadas:\n                    </p>\n                    <ol className=\"list-decimal list-inside space-y-1 text-[11px] text-slate-500 font-normal\">\n                      <li>Baixe o projeto pelo menu <strong>Export &gt; Download ZIP</strong>.</li>\n                      <li>Extraia a pasta no computador do consultor.</li>\n                      <li>Execute <code className=\"bg-slate-100 px-1 py-0.5 rounded font-mono text-slate-700\">npm run build</code> e sirva a pasta <code className=\"bg-slate-100 px-1 py-0.5 rounded font-mono text-slate-700\">dist/</code>.</li>\n                    </ol>\n                  </div>\n                  <div className=\"mt-3 pt-2.5 border-t border-slate-100 text-[10px] text-slate-500 flex items-center gap-1\">\n                    <HardDrive className=\"w-3.5 h-3.5 text-slate-400\" /> Funciona sem conex\303\243o com a internet\n                  </div>\n                </div>\n              </div>\n\n              {/* Team Sharing Strategy */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <h4 className=\"font-semibold text-slate-900 text-xs flex items-center gap-1.5\">\n                  <Users className=\"w-3.5 h-3.5 text-indigo-600\" />\n                  <span>Como compartilhar e consolidar dados entre os membros da \303\241rea:</span>\n                </h4>\n                <p className=\"text-[11px] text-slate-600 leading-relaxed\">\n                  1. O consultor clica em <strong>\"Baixar JSON\"</strong> na aba Backup JSON e envia o arquivo para o gestor.<br/>\n                  2. O gestor abre o PipeCRM em sua m\303\241quina e clica em <strong>\"Importar Backup JSON\"</strong> &gt; <strong>\"Mesclar com Dados Atuais\"</strong>.<br/>\n                  3. Os cards s\303\243o consolidados instantaneamente, atualizando o painel geral de metas da \303\241rea!\n                </p>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: RESET / DATABASE MAINTENANCE */}\n          {activeTab === \'reset\' && (\n            <div className=\"space-y-3\">\n              <p className=\"text-slate-500 text-xs\">\n                Controles de manuten\303\247\303\243o para a mem\303\263ria local do seu navegador:\n              </p>\n\n              {/* Reset to Mock Data */}\n              <div className=\"p-3.5 bg-white border border-slate-200 rounded-xl space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-semibold text-slate-900\">Restaurar Dados Padr\303\243o</h4>\n                    <p className=\"text-[11px] text-slate-500\">\n                      Recarrega a estrutura e os cards de demonstra\303\247\303\243o iniciais.\n                    </p>\n                  </div>\n                  {!showResetConfirm ? (\n                    <button\n                      onClick={() => setShowResetConfirm(true)}\n                      className=\"px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg flex items-center gap-1.5 cursor-pointer text-xs transition-colors\"\n                    >\n                      <RefreshCw className=\"w-3.5 h-3.5\" />\n                      <span>Restaurar</span>\n                    </button>\n                  ) : (\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={handleResetDefaults}\n                        className=\"px-2.5 py-1 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-lg text-xs\"\n                      >\n                        Confirmar\n                      </button>\n                      <button\n                        onClick={() => setShowResetConfirm(false)}\n                        className=\"px-2 py-1 text-slate-500 hover:text-slate-700 text-xs\"\n                      >\n                        Cancelar\n                      </button>\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Clear All Cards */}\n              <div className=\"p-3.5 bg-white border border-rose-200/70 rounded-xl space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-semibold text-rose-900\">Limpar Todos os Cards</h4>\n                    <p className=\"text-[11px] text-slate-500\">\n                      Remove todos os cards do funil para come\303\247ar um pipeline do zero.\n                    </p>\n                  </div>\n                  {!showClearConfirm ? (\n                    <button\n                      onClick={() => setShowClearConfirm(true)}\n                      className=\"px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-medium rounded-lg flex items-center gap-1.5 cursor-pointer text-xs transition-colors\"\n                    >\n                      <Trash2 className=\"w-3.5 h-3.5\" />\n                      <span>Limpar Cards</span>\n                    </button>\n                  ) : (\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={handleClearCards}\n                        className=\"px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white font-semibold rounded-lg text-xs\"\n                      >\n                        Confirmar Limpeza\n                      </button>\n                      <button\n                        onClick={() => setShowClearConfirm(false)}\n                        className=\"px-2 py-1 text-slate-500 hover:text-slate-700 text-xs\"\n                      >\n                        Cancelar\n                      </button>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500\">\n          <div className=\"flex items-center gap-1.5\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n            <span>Dados armazenados exclusivamente no seu navegador (sem tracking)</span>\n          </div>\n          <button\n            onClick={() => setIsExportModalOpen(false)}\n            className=\"px-3.5 py-1 bg-white hover:bg-slate-100 text-slate-700 font-medium rounded-lg border border-slate-200 transition-colors\"\n          >\n            Fechar\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 animate-in fade-in duration-150\">\n      <div className=\"bg-white dark:bg-neutral-900 rounded-2xl shadow-xl border border-neutral-200 dark:border-neutral-800 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"px-5 py-3.5 border-b border-neutral-100 dark:border-neutral-800 flex items-center justify-between bg-neutral-50/70 dark:bg-neutral-950\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-900/60 flex items-center justify-center text-red-600 dark:text-red-400\">\n              <HardDrive className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"font-semibold text-sm text-neutral-900 dark:text-neutral-100 leading-tight\">Central de Dados & Backups</h3>\n              <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400\">Mem\303\263ria local independente (localStorage)</p>\n            </div>\n          </div>\n          <button\n            onClick={() => setIsExportModalOpen(false)}\n            className=\"p-1.5 text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Tab Navigation */}\n        <div className=\"px-5 border-b border-neutral-100 dark:border-neutral-800 bg-white dark:bg-neutral-900 flex gap-1 overflow-x-auto no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'json\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'json\'\n                ? \'border-red-600 text-red-600 dark:text-red-400 font-semibold\'\n                : \'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200\'\n            }`}\n          >\n            <FileJson className=\"w-3.5 h-3.5\" />\n            <span>Backup JSON (Importar/Exportar)</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'desktop\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'desktop\'\n                ? \'border-red-600 text-red-600 dark:text-red-400 font-semibold\'\n                : \'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200\'\n            }`}\n          >\n            <Monitor className=\"w-3.5 h-3.5\" />\n            <span>Instalar no Computador (Desktop)</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'csv\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'csv\'\n                ? \'border-red-600 text-red-600 dark:text-red-400 font-semibold\'\n                : \'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200\'\n            }`}\n          >\n            <FileSpreadsheet className=\"w-3.5 h-3.5\" />\n            <span>Planilhas Excel / CSV</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'reset\')}\n            className={`flex items-center gap-1.5 py-2.5 px-3 text-xs font-medium border-b-2 whitespace-nowrap transition-all cursor-pointer ${\n              activeTab === \'reset\'\n                ? \'border-red-600 text-red-600 dark:text-red-400 font-semibold\'\n                : \'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200\'\n            }`}\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n            <span>Redefinir Base</span>\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-5 overflow-y-auto space-y-4 text-xs\">\n          {/* Notifications / Feedback */}\n          {importSuccessMsg && (\n            <div className=\"p-3 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900 rounded-xl flex items-center justify-between gap-2 text-emerald-800 dark:text-emerald-300 animate-in fade-in\">\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0\" />\n                <span className=\"font-medium\">{importSuccessMsg}</span>\n              </div>\n              <button\n                onClick={() => setImportSuccessMsg(null)}\n                className=\"text-xs text-emerald-600 hover:text-emerald-900 dark:hover:text-emerald-200 font-bold cursor-pointer\"\n              >\n                \342\234\225\n              </button>\n            </div>\n          )}\n\n          {importError && (\n            <div className=\"p-3 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 rounded-xl flex items-center justify-between gap-2 text-rose-800 dark:text-rose-300 animate-in fade-in\">\n              <div className=\"flex items-center gap-2\">\n                <AlertTriangle className=\"w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0\" />\n                <span>{importError}</span>\n              </div>\n              <button\n                onClick={() => setImportError(null)}\n                className=\"text-xs text-rose-600 hover:text-rose-900 dark:hover:text-rose-200 font-bold cursor-pointer\"\n              >\n                \342\234\225\n              </button>\n            </div>\n          )}\n\n          {/* TAB 1: JSON BACKUP */}\n          {activeTab === \'json\' && (\n            <div className=\"space-y-4\">\n              {/* Info Pill */}\n              <div className=\"p-3 bg-neutral-50 dark:bg-neutral-950 border border-neutral-200/80 dark:border-neutral-800 rounded-xl flex items-center justify-between gap-3 text-neutral-600 dark:text-neutral-400\">\n                <div className=\"flex items-center gap-2.5\">\n                  <div className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                  <span>\n                    Armazenado no navegador deste computador: <strong className=\"text-neutral-800 dark:text-neutral-200\">{cards.length} cards</strong> ({storageInfo.usedKB} KB usados)\n                  </span>\n                </div>\n                <span className=\"text-[10px] font-medium text-neutral-400 dark:text-neutral-500\">100% Offline / Privado</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n                {/* Export Card */}\n                <div className=\"p-4 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl flex flex-col justify-between hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-red-600 dark:text-red-400 mb-1.5\">\n                      <Download className=\"w-4 h-4\" />\n                      <h4 className=\"font-semibold text-neutral-900 dark:text-neutral-100 text-xs\">Exportar Backup JSON</h4>\n                    </div>\n                    <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed\">\n                      Gere um arquivo <code className=\"bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded text-neutral-700 dark:text-neutral-300 font-mono\">.json</code> com todas as oportunidades, perguntas preenchidas, automa\303\247\303\265es e hist\303\263rico.\n                    </p>\n                  </div>\n\n                  <div className=\"mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between\">\n                    <span className=\"text-[10px] text-neutral-400\">{cards.length} registros prontos</span>\n                    <button\n                      onClick={exportFullJSONBackup}\n                      className=\"px-3 py-1.5 bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 active:bg-red-800 text-white font-medium rounded-lg flex items-center gap-1.5 transition-colors cursor-pointer\"\n                    >\n                      <Download className=\"w-3.5 h-3.5\" />\n                      <span>Baixar JSON</span>\n                    </button>\n                  </div>\n                </div>\n\n                {/* Import Card */}\n                <div className=\"p-4 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl flex flex-col justify-between hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-red-600 dark:text-red-400 mb-1.5\">\n                      <Upload className=\"w-4 h-4\" />\n                      <h4 className=\"font-semibold text-neutral-900 dark:text-neutral-100 text-xs\">Importar Backup JSON</h4>\n                    </div>\n                    <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed\">\n                      Carregue um arquivo salvo anteriormente para restaurar sua base neste ou em outro computador.\n                    </p>\n                  </div>\n\n                  <div className=\"mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800\">\n                    <input\n                      type=\"file\"\n                      ref={fileInputRef}\n                      accept=\".json\"\n                      onChange={handleFileChange}\n                      className=\"hidden\"\n                      id=\"json-file-input\"\n                    />\n                    <label\n                      htmlFor=\"json-file-input\"\n                      className=\"w-full py-1.5 px-3 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-850 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-medium rounded-lg flex items-center justify-center gap-1.5 cursor-pointer transition-colors text-xs\"\n                    >\n                      <Upload className=\"w-3.5 h-3.5\" />\n                      <span>{importFile ? importFile.name : \'Selecionar Arquivo .json\'}</span>\n                    </label>\n                  </div>\n                </div>\n              </div>\n\n              {/* Import Preview and Actions */}\n              {parsedData && importSummary && (\n                <div className=\"p-4 bg-red-50/40 dark:bg-red-950/20 border border-red-200 dark:border-red-900/60 rounded-xl space-y-3 animate-in fade-in\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2 text-red-900 dark:text-red-200 font-semibold\">\n                      <CheckCircle2 className=\"w-4 h-4 text-red-600 dark:text-red-400\" />\n                      <span>Arquivo validado com sucesso</span>\n                    </div>\n                    {importSummary.exportedAt && (\n                      <span className=\"text-[10px] text-red-600 dark:text-red-400\">\n                        Exportado em: {formatDate(importSummary.exportedAt)}\n                      </span>\n                    )}\n                  </div>\n\n                  {/* Summary Grid */}\n                  <div className=\"grid grid-cols-4 gap-2 text-center\">\n                    <div className=\"p-2 bg-white dark:bg-neutral-900 rounded-lg border border-red-100 dark:border-neutral-800\">\n                      <div className=\"text-sm font-bold text-neutral-900 dark:text-neutral-100\">{importSummary.cardsCount}</div>\n                      <div className=\"text-[10px] text-neutral-500\">Cards</div>\n                    </div>\n                    <div className=\"p-2 bg-white dark:bg-neutral-900 rounded-lg border border-red-100 dark:border-neutral-800\">\n                      <div className=\"text-sm font-bold text-neutral-900 dark:text-neutral-100\">{importSummary.phasesCount}</div>\n                      <div className=\"text-[10px] text-neutral-500\">Fases</div>\n                    </div>\n                    <div className=\"p-2 bg-white dark:bg-neutral-900 rounded-lg border border-red-100 dark:border-neutral-800\">\n                      <div className=\"text-sm font-bold text-neutral-900 dark:text-neutral-100\">{importSummary.usersCount}</div>\n                      <div className=\"text-[10px] text-neutral-500\">Usu\303\241rios</div>\n                    </div>\n                    <div className=\"p-2 bg-white dark:bg-neutral-900 rounded-lg border border-red-100 dark:border-neutral-800\">\n                      <div className=\"text-sm font-bold text-neutral-900 dark:text-neutral-100\">{importSummary.automationsCount}</div>\n                      <div className=\"text-[10px] text-neutral-500\">Regras</div>\n                    </div>\n                  </div>\n\n                  <p className=\"text-[11px] text-neutral-700 dark:text-neutral-300\">\n                    Como deseja carregar estes dados no seu navegador?\n                  </p>\n\n                  <div className=\"flex flex-wrap items-center gap-2 pt-1\">\n                    <button\n                      onClick={() => handleExecuteImport(\'replace\')}\n                      className=\"px-3.5 py-1.5 bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 text-white font-medium rounded-lg flex items-center gap-1.5 cursor-pointer shadow-xs transition-colors\"\n                    >\n                      <RefreshCw className=\"w-3.5 h-3.5\" />\n                      <span>Substituir Base Atual</span>\n                    </button>\n                    <button\n                      onClick={() => handleExecuteImport(\'merge\')}\n                      className=\"px-3.5 py-1.5 bg-white dark:bg-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-750 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700 font-medium rounded-lg flex items-center gap-1.5 cursor-pointer transition-colors\"\n                    >\n                      <Layers className=\"w-3.5 h-3.5\" />\n                      <span>Mesclar com Dados Atuais</span>\n                    </button>\n                    <button\n                      onClick={() => {\n                        setParsedData(null);\n                        setImportFile(null);\n                        setImportSummary(null);\n                        if (fileInputRef.current) fileInputRef.current.value = \'\';\n                      }}\n                      className=\"px-2.5 py-1.5 text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 text-xs ml-auto cursor-pointer\"\n                    >\n                      Cancelar\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* TAB 2: CSV / SPREADSHEETS */}\n          {activeTab === \'csv\' && (\n            <div className=\"space-y-3\">\n              <p className=\"text-neutral-500 dark:text-neutral-400 text-xs\">\n                Exporte relat\303\263rios formatados em UTF-8 com suporte nativo ao Microsoft Excel e Google Sheets:\n              </p>\n\n              {/* Option 1 */}\n              <div className=\"p-3 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl flex items-center justify-between gap-3 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors\">\n                <div>\n                  <h4 className=\"font-semibold text-neutral-900 dark:text-neutral-100\">Pipeline Completo de Oportunidades</h4>\n                  <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5\">\n                    Todos os {cards.length} cards com campos customizados das 12 fases (dores, propostas, follow-ups).\n                  </p>\n                </div>\n                <button\n                  onClick={() => exportCardsToCSV(cards, phases, users)}\n                  className=\"px-3 py-1.5 bg-neutral-900 hover:bg-neutral-800 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-white font-medium rounded-lg flex items-center gap-1.5 shrink-0 cursor-pointer transition-colors\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>CSV</span>\n                </button>\n              </div>\n\n              {/* Option 2 */}\n              <div className=\"p-3 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl flex items-center justify-between gap-3 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors\">\n                <div>\n                  <h4 className=\"font-semibold text-neutral-900 dark:text-neutral-100\">Produtividade & Metas dos Consultores</h4>\n                  <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5\">\n                    Metas mensais, volume realizado em R$, taxas de convers\303\243o e fechamentos por vendedor.\n                  </p>\n                </div>\n                <button\n                  onClick={() => exportConsultantReportToCSV(users, cards)}\n                  className=\"px-3 py-1.5 bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 text-white font-medium rounded-lg flex items-center gap-1.5 shrink-0 cursor-pointer transition-colors\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>CSV</span>\n                </button>\n              </div>\n\n              {/* Option 3 */}\n              <div className=\"p-3 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl flex items-center justify-between gap-3 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors\">\n                <div>\n                  <h4 className=\"font-semibold text-neutral-900 dark:text-neutral-100\">Trilha de Auditoria & Compliance</h4>\n                  <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5\">\n                    Hist\303\263rico de {auditLogs.length} logs com movimenta\303\247\303\265es, disparos e altera\303\247\303\265es.\n                  </p>\n                </div>\n                <button\n                  onClick={() => exportAuditLogsToCSV(auditLogs)}\n                  className=\"px-3 py-1.5 bg-neutral-700 hover:bg-neutral-800 dark:bg-neutral-800 dark:hover:bg-neutral-750 text-white font-medium rounded-lg flex items-center gap-1.5 shrink-0 cursor-pointer transition-colors\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>CSV</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* TAB: DESKTOP INSTALLATION & OFFLINE WORKSTATION */}\n          {activeTab === \'desktop\' && (\n            <div className=\"space-y-4\">\n              <div className=\"p-3.5 bg-red-50/50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 rounded-xl\">\n                <div className=\"flex items-center gap-2 text-red-900 dark:text-red-200 font-bold mb-1\">\n                  <Monitor className=\"w-4 h-4 text-red-600 dark:text-red-400 shrink-0\" />\n                  <span>Opera\303\247\303\243o 100% Local no Computador (Sem Servidor na Nuvem)</span>\n                </div>\n                <p className=\"text-[11px] text-neutral-700 dark:text-neutral-300 leading-relaxed\">\n                  O QuaraCRM foi desenvolvido com arquitetura <strong>Local-First</strong>. Cada membro da equipe pode usar em sua pr\303\263pria m\303\241quina, gravando seus dados no disco/navegador local com privacidade total.\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n                {/* Method 1: PWA Desktop App */}\n                <div className=\"p-4 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl flex flex-col justify-between hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-neutral-900 dark:text-neutral-100 font-semibold mb-2\">\n                      <div className=\"w-6 h-6 rounded-md bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300 flex items-center justify-center text-xs font-bold\">1</div>\n                      <h4>Instalar como App no Desktop (PWA)</h4>\n                    </div>\n                    <p className=\"text-[11px] text-neutral-600 dark:text-neutral-400 leading-relaxed mb-3\">\n                      Abre como um aplicativo nativo na barra de tarefas do Windows ou Mac sem precisar de instaladores:\n                    </p>\n                    <ol className=\"list-decimal list-inside space-y-1 text-[11px] text-neutral-500 dark:text-neutral-400 font-normal\">\n                      <li>Abra no <strong>Chrome</strong> ou <strong>Edge</strong>.</li>\n                      <li>Clique no menu (3 pontinhos) no topo direito.</li>\n                      <li>Selecione <strong>\"Instalar QuaraCRM...\"</strong> ou <strong>\"Criar atalho\"</strong> marcando <em>\"Abrir como janela\"</em>.</li>\n                    </ol>\n                  </div>\n                  <div className=\"mt-3 pt-2.5 border-t border-neutral-100 dark:border-neutral-800 text-[10px] text-emerald-700 dark:text-emerald-400 font-medium flex items-center gap-1\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5\" /> Recomendado para o dia a dia\n                  </div>\n                </div>\n\n                {/* Method 2: Offline Folder / Code Export */}\n                <div className=\"p-4 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl flex flex-col justify-between hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors\">\n                  <div>\n                    <div className=\"flex items-center gap-2 text-neutral-900 dark:text-neutral-100 font-semibold mb-2\">\n                      <div className=\"w-6 h-6 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 flex items-center justify-center text-xs font-bold\">2</div>\n                      <h4>Rodar Offline na M\303\241quina (ZIP / Local)</h4>\n                    </div>\n                    <p className=\"text-[11px] text-neutral-600 dark:text-neutral-400 leading-relaxed mb-3\">\n                      Para executar 100% offline em redes corporativas fechadas:\n                    </p>\n                    <ol className=\"list-decimal list-inside space-y-1 text-[11px] text-neutral-500 dark:text-neutral-400 font-normal\">\n                      <li>Baixe o projeto pelo menu <strong>Export &gt; Download ZIP</strong>.</li>\n                      <li>Extraia a pasta no computador do consultor.</li>\n                      <li>Execute <code className=\"bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono text-neutral-700 dark:text-neutral-300\">npm run build</code> e sirva a pasta <code className=\"bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono text-neutral-700 dark:text-neutral-300\">dist/</code>.</li>\n                    </ol>\n                  </div>\n                  <div className=\"mt-3 pt-2.5 border-t border-neutral-100 dark:border-neutral-800 text-[10px] text-neutral-500 flex items-center gap-1\">\n                    <HardDrive className=\"w-3.5 h-3.5 text-neutral-400\" /> Funciona sem conex\303\243o com a internet\n                  </div>\n                </div>\n              </div>\n\n              {/* Team Sharing Strategy */}\n              <div className=\"p-3.5 bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl space-y-2\">\n                <h4 className=\"font-semibold text-neutral-900 dark:text-neutral-100 text-xs flex items-center gap-1.5\">\n                  <Users className=\"w-3.5 h-3.5 text-red-600 dark:text-red-400\" />\n                  <span>Como compartilhar e consolidar dados entre os membros da \303\241rea:</span>\n                </h4>\n                <p className=\"text-[11px] text-neutral-600 dark:text-neutral-400 leading-relaxed\">\n                  1. O consultor clica em <strong>\"Baixar JSON\"</strong> na aba Backup JSON e envia o arquivo para o gestor.<br/>\n                  2. O gestor abre o QuaraCRM em sua m\303\241quina e clica em <strong>\"Importar Backup JSON\"</strong> &gt; <strong>\"Mesclar com Dados Atuais\"</strong>.<br/>\n                  3. Os cards s\303\243o consolidados instantaneamente, atualizando o painel geral de metas da \303\241rea!\n                </p>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: RESET / DATABASE MAINTENANCE */}\n          {activeTab === \'reset\' && (\n            <div className=\"space-y-3\">\n              <p className=\"text-neutral-500 dark:text-neutral-400 text-xs\">\n                Controles de manuten\303\247\303\243o para a mem\303\263ria local do seu navegador:\n              </p>\n\n              {/* Reset to Mock Data */}\n              <div className=\"p-3.5 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-semibold text-neutral-900 dark:text-neutral-100\">Restaurar Dados Padr\303\243o</h4>\n                    <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400\">\n                      Recarrega a estrutura e os cards de demonstra\303\247\303\243o iniciais.\n                    </p>\n                  </div>\n                  {!showResetConfirm ? (\n                    <button\n                      onClick={() => setShowResetConfirm(true)}\n                      className=\"px-3 py-1.5 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-750 text-neutral-700 dark:text-neutral-300 font-medium rounded-lg flex items-center gap-1.5 cursor-pointer text-xs transition-colors\"\n                    >\n                      <RefreshCw className=\"w-3.5 h-3.5\" />\n                      <span>Restaurar</span>\n                    </button>\n                  ) : (\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={handleResetDefaults}\n                        className=\"px-2.5 py-1 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-lg text-xs cursor-pointer\"\n                      >\n                        Confirmar\n                      </button>\n                      <button\n                        onClick={() => setShowResetConfirm(false)}\n                        className=\"px-2 py-1 text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 text-xs cursor-pointer\"\n                      >\n                        Cancelar\n                      </button>\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Clear All Cards */}\n              <div className=\"p-3.5 bg-white dark:bg-neutral-950 border border-rose-200/70 dark:border-rose-900/60 rounded-xl space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h4 className=\"font-semibold text-rose-900 dark:text-rose-300\">Limpar Todos os Cards</h4>\n                    <p className=\"text-[11px] text-neutral-500 dark:text-neutral-400\">\n                      Remove todos os cards do funil para come\303\247ar um pipeline do zero.\n                    </p>\n                  </div>\n                  {!showClearConfirm ? (\n                    <button\n                      onClick={() => setShowClearConfirm(true)}\n                      className=\"px-3 py-1.5 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/50 dark:hover:bg-rose-900/60 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-900 font-medium rounded-lg flex items-center gap-1.5 cursor-pointer text-xs transition-colors\"\n                    >\n                      <Trash2 className=\"w-3.5 h-3.5\" />\n                      <span>Limpar Cards</span>\n                    </button>\n                  ) : (\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={handleClearCards}\n                        className=\"px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white font-semibold rounded-lg text-xs cursor-pointer\"\n                      >\n                        Confirmar Limpeza\n                      </button>\n                      <button\n                        onClick={() => setShowClearConfirm(false)}\n                        className=\"px-2 py-1 text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 text-xs cursor-pointer\"\n                      >\n                        Cancelar\n                      </button>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-5 py-3 bg-neutral-50 dark:bg-neutral-950 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between text-[11px] text-neutral-500 dark:text-neutral-400\">\n          <div className=\"flex items-center gap-1.5\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400\" />\n            <span>Dados armazenados exclusivamente no seu navegador (sem tracking)</span>\n          </div>\n          <button\n            onClick={() => setIsExportModalOpen(false)}\n            className=\"px-3.5 py-1 bg-white dark:bg-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-750 text-neutral-700 dark:text-neutral-300 font-medium rounded-lg border border-neutral-200 dark:border-neutral-700 transition-colors cursor-pointer\"\n          >\n            Fechar\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
    }
